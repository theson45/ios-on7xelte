+/* Console ring readers for bsd/dev/a5xelte_usb.c (lock-free, may lag). */
+uint64_t a5xelte_log_position(void);
+uint32_t a5xelte_log_copy(uint64_t *pos, uint64_t limit, char *out, uint32_t max);
+uint64_t
+a5xelte_log_position(void)
+{
+	return os_atomic_load(&emmc_log_total, relaxed);
+}
+
+/* Copy bytes [*pos, limit) of the console stream, at most max; skips what
+ * the ring has already overwritten. */
+uint32_t
+a5xelte_log_copy(uint64_t *pos, uint64_t limit, char *out, uint32_t max)
+{
+	if (limit > os_atomic_load(&emmc_log_total, relaxed) || *pos >= limit) {
+		return 0;
+	}
+	if (limit - *pos > A5_LOG_SIZE) {
+		*pos = limit - A5_LOG_SIZE;
+	}
+	uint64_t n = limit - *pos;
+	if (n > max) {
+		n = max;
+	}
+	for (uint64_t i = 0; i < n; i++) {
+		out[i] = emmc_log_ring[(*pos + i) % A5_LOG_SIZE];
+	}
+	*pos += n;
+	return (uint32_t)n;
+}
