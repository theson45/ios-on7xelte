 }
 
+/*
+ * 0141: services for hardware this phone does not have (or the port does not
+ * drive yet): Wi-Fi, Bluetooth, audio, the modem, NFC. They only crash, get
+ * respawned and keep launchd busy (mediaserverd alone kept launchd ~75% busy
+ * in a loop). kern_exec.c asks here and refuses the spawn with EACCES; their
+ * clients get an error at once instead of waiting.
+ * Boot-arg on7deny=NAME[,NAME] replaces the list, on7deny=- allows all.
+ */
+static const char ud_deny_default[] =
+    "mediaserverd,audioclocksyncd,audiomxd,UARPUpdaterServiceLegacyAudio,"
+    "bluetoothd,bluetoothuserd,BlueTool,BTLEServer,"
+    "wifid,wifip2pd,wifianalyticsd,wifivelocityd,WiFiCloudAssetsClient,"
+    "CommCenter,CommCenterMobileHelper,CommCenterRootHelper,WirelessRadioManagerd,"
+    "nfcd,carkitd";
+static char ud_deny_arg[512];
+static int ud_deny_state;       /* 0 not read, 1 default, 2 boot-arg, 3 off */
+static uint32_t ud_deny_count;
+
+bool a5xelte_exec_denied(const char *name);
+
+bool
+a5xelte_exec_denied(const char *name)
+{
+	int st = __atomic_load_n(&ud_deny_state, __ATOMIC_ACQUIRE);
+	if (st == 0) {
+		if (PE_parse_boot_argn("on7deny", ud_deny_arg, sizeof(ud_deny_arg))) {
+			st = (ud_deny_arg[0] == '-' || ud_deny_arg[0] == '\0') ? 3 : 2;
+		} else {
+			st = 1;
+		}
+		__atomic_store_n(&ud_deny_state, st, __ATOMIC_RELEASE);
+	}
+	if (st == 3 || name == NULL) {
+		return false;
+	}
+	if (!ud_name_in(st == 2 ? ud_deny_arg : ud_deny_default, name)) {
+		return false;
+	}
+	uint32_t n = __atomic_add_fetch(&ud_deny_count, 1, __ATOMIC_RELAXED);
+	if (n <= 64 || (n % 64) == 0) {
+		printf("exec %s denied (on7deny, %u so far)\n", name, n);
+	}
+	return true;
+}
+
 static int ud_ps_count;
 
