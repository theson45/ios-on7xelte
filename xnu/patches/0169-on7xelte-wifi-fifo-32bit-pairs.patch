 		wr32(wf_mmc, M_CTYPE, 1);
 		printf("USB> wifi: 4-bit bus (CCCR 0x07 0x%02x -> 0x%02x)\n", bic, wf_rd8(0, 0x07));
 	}
+	if (wf_div != WF_CLKDIV_SLOW) {
+		/* 0169: faster card clock for the download (cclk_in / (2 * div)) */
+		wr32(wf_mmc, M_CLKENA, 0);
+		bool ck = wf_clk_update();
+		wr32(wf_mmc, M_CLKDIV, wf_div);
+		ck = ck && wf_clk_update();
+		wr32(wf_mmc, M_CLKENA, 1);
+		ck = ck && wf_clk_update();
+		printf("USB> wifi: CLKDIV %u -> %u (%s)\n", WF_CLKDIV_SLOW, rd32(wf_mmc, M_CLKDIV), ck ? "ok" : "update FAILED");
+	}
