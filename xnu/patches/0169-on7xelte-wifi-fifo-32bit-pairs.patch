  * FIFO count 0 and the card left waiting in TRN. 0 = 64-bit str at 0x200, 1 = 32-bit low at 0x200 and high at
  * 0x204, 2 = both 32-bit halves at 0x200, 3 = only 32-bit words at 0x200 (no padding).
  */
-static uint32_t wf_fifo_mode;
+static uint32_t wf_fifo_mode = 1;      /* 0169: mode 1 works (xnu52): SOCRAM written right */
+static uint32_t wf_div = WF_CLKDIV_SLOW; /* 0169: 'wifi div N' (hex), the clock after the 4-bit switch */
 
 static void
 wf_fifo_put(uint32_t lo, uint32_t hi)
@@ -642,7 +643,16 @@
 	if (!(st & RINT_DTO) || (st & (RINT_HLE | RINT_DERR | RINT_RE | RINT_RTO | RINT_RCRC)) || (r & 0xcb00u)) {
 		goto bad;
 	}
-	if (!wr) {
+	if (!wr && wf_fifo_mode == 1) {
+		/* 0169: a 64-bit FIFO entry read as two 32-bit halves, 0x200 then 0x204 (as written) */
+		for (uint32_t i = 0; i < nw; i += 2) {
+			buf[i] = rd32(wf_mmc, M_FIFO);
+			uint32_t hi = rd32(wf_mmc, M_FIFO + 4);
+			if (i + 1 < nw) {
+				buf[i + 1] = hi;
+			}
+		}
+	} else if (!wr) {
 		for (uint32_t i = 0; i < n / 4; i++) {
