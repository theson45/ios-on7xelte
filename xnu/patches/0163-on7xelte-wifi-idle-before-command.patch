+/*
+ * 0163: wait until the controller can take a command: the previous one started (CMD bit 31 clear), the
+ * command FSM idle (STATUS 7:4 == 0: after a response it still waits Ncc clocks, 20 us at 400 kHz, and a
+ * command written then is refused with HLE), and no data busy (STATUS 9, 10).
+ */
+static bool
+wf_idle(void)
+{
+	for (uint32_t t = 0; t < 100000; t += 2) {
+		if (!(rd32(wf_mmc, M_CMD) & CMD_START) && !(rd32(wf_mmc, M_STATUS) & 0x6f0u)) {
+			return true;
+		}
+		delay(2);
+	}
+	return false;
+}
+
 /* One command without data; 0 = response in *resp, else the RINTSTS error bits (or 1: stuck). */
