+/* civil date from days since 1970-01-01 */
+static void
+civil_from_days(int64_t z, unsigned *y, unsigned *m, unsigned *d)
+{
+	z += 719468;
+	const int64_t era = (z >= 0 ? z : z - 146096) / 146097;
+	const unsigned doe = (unsigned)(z - era * 146097);
+	const unsigned yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+	const unsigned doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+	const unsigned mp = (5 * doy + 2) / 153;
+	*d = doy - (153 * mp + 2) / 5 + 1;
+	*m = mp < 10 ? mp + 3 : mp - 9;
+	*y = (unsigned)(yoe + era * 400) + (*m <= 2);
+}
+
+static int
+rtc_write(uint64_t epoch)
+{
+	uint64_t days = epoch / 86400;
+	unsigned rem = (unsigned)(epoch % 86400), y, m, d;
+	uint8_t up = 0, msg[8];
+	int e;
+	civil_from_days((int64_t)days, &y, &m, &d);
+	if (dv.batch || y < 2020 || y > 2099) {
+		return -1;
+	}
+	unsigned hour = rem / 3600;
+	msg[0] = RTC_SEC;
+	msg[1] = (uint8_t)(rem % 60);
+	msg[2] = (uint8_t)((rem / 60) % 60);
+	msg[3] = (uint8_t)(hour | (hour >= 12 ? 0x40u : 0));
+	msg[4] = (uint8_t)(1u << ((days + 4) % 7));     /* 1970-01-01 was a Thursday */
+	msg[5] = (uint8_t)d;
+	msg[6] = (uint8_t)m;
+	msg[7] = (uint8_t)(y - 2000);
+	dv.slave = RTC_ADDR;
+	e = pm_read(RTC_UPDATE, &up);
+	if (!e) {
+		e = pm_xfer(false, msg, sizeof(msg), true) ? -1 : 0;
+	}
+	if (!e) {
+		uint8_t u[2] = { RTC_UPDATE,
+			         (uint8_t)((up & ~(RTC_RUDR | RTC_WUDR | RTC_FREEZE | RTC_AUDR)) | RTC_WUDR) };
+		e = pm_xfer(false, u, sizeof(u), true) ? -1 : 0;
+		delay(2000);
+	}
+	dv.slave = 0;
+	printf("USB> time: RTC write %04u-%02u-%02u %02u:%02u:%02u (UPDATE was 0x%02x) %s\n", y, m, d,
+	    hour, msg[2], msg[1], up, e ? "FAILED" : "ok");
+	return e;
+}
