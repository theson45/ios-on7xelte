+/* Per-channel average of two BGRA pixels. */
+static inline uint32_t
+sweet_fb_avg(uint32_t a, uint32_t b)
+{
+	return (a & b) + (((a ^ b) & 0xfefefefeu) >> 1);
+}
+
+/*
+ * Scale the logical rect (dx,dy w x h, read from the surface at sx,sy)
+ * down to the panel: each panel pixel is the 2x2 average around the
+ * logical pixel it covers (fScaleX for columns, same ratio for rows).
+ */
+void
+AppleCLCD::presentScaled(SweetSurface *s, uintptr_t src, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w <= 0 || h <= 0 || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    s->memory == NULL || (s->bytesPerElement != 0 && s->bytesPerElement != 4)) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+	    (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	uint32_t px0 = (uint32_t)(((uint64_t)dx * fWidth + fLogicalW - 1) / fLogicalW);
+	uint32_t px1 = (uint32_t)(((uint64_t)(dx + w) * fWidth + fLogicalW - 1) / fLogicalW);
+	uint32_t py0 = (uint32_t)(((uint64_t)dy * fHeight + fLogicalH - 1) / fLogicalH);
+	uint32_t py1 = (uint32_t)(((uint64_t)(dy + h) * fHeight + fLogicalH - 1) / fLogicalH);
+	px1 = px1 > fWidth ? fWidth : px1;
+	py1 = py1 > fHeight ? fHeight : py1;
+	const uint8_t *base = (const uint8_t *)(src + s->offset);
+	for (uint32_t py = py0; py < py1; py++) {
+		int32_t ly = (int32_t)(((uint64_t)py * fLogicalH) / fHeight);
+		int32_t ly2 = ly + 1 < dy + h ? ly + 1 : dy + h - 1;
+		const uint32_t *r0 = (const uint32_t *)(base + (uint64_t)(sy + ly - dy) * s->bytesPerRow);
+		const uint32_t *r1 = (const uint32_t *)(base + (uint64_t)(sy + ly2 - dy) * s->bytesPerRow);
+		uint32_t *out = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		for (uint32_t px = px0; px < px1; px++) {
+			int32_t lx = (int32_t)fScaleX[px];
+			int32_t c0 = sx + lx - dx;
+			int32_t c1 = lx + 1 < dx + w ? c0 + 1 : c0;
+			out[px] = sweet_fb_avg(sweet_fb_avg(r0[c0], r0[c1]), sweet_fb_avg(r1[c0], r1[c1]));
+		}
+	}
+}
