+
+static void
+dv_worker(void *a __unused, wait_result_t w __unused)
+{
+	for (;;) {
+		if (!dv.busy) {
+			uint64_t deadline;
+			clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+			(void)assert_wait_deadline(&dv.wake, THREAD_UNINT, deadline);
+			thread_block(THREAD_CONTINUE_NULL);
+			continue;
+		}
+		dv_run(dv.wcmd, dv.warg);
+		printf("USB> dvfs: '%s %s' finished\n", dv.wcmd, dv.warg);
+		dv.busy = false;
+	}
+}
+
+static void
+dv_post(const char *cmd, const char *arg)
+{
+	if (dv.busy) {
+		printf("USB> dvfs: busy with '%s %s'\n", dv.wcmd, dv.warg);
+		return;
+	}
+	if (!dv.started) {
+		thread_t th;
+		if (kernel_thread_start(dv_worker, NULL, &th) != KERN_SUCCESS) {
+			printf("USB> dvfs: no worker thread\n");
+			return;
+		}
+		thread_deallocate(th);
+		dv.started = true;
+	}
+	strlcpy(dv.wcmd, cmd, sizeof(dv.wcmd));
+	strlcpy(dv.warg, arg, sizeof(dv.warg));
+	dv.busy = true;
+}
+
+bool
+a5xelte_dvfs_command(const char *cmd, const char *arg)
+{
+	if (strcmp(cmd, "temp") && strcmp(cmd, "pmic") && strcmp(cmd, "cpufreq")) {
+		return false;
+	}
+	dv_post(cmd, arg);
 	return true;
 }
 
