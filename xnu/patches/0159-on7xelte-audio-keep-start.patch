  *
  * Volume is applied here in software (Q16 gain); the codec stays at Android's speaker level.
  * "USB> raud:" lines count frames, drops (ring full) and FIFO underruns per stretch of sound.
+ *
+ * 0159: the start of a sound is no longer thrown away.  Bringing the path up takes long enough
+ * that the old 170 ms ring overflowed and the newest-1024-frames trim then dropped most of the
+ * first ~200 ms (a short click could vanish).  Now the ring holds 680 ms and everything written
+ * is played; the latency that builds up while the path starts is won back by skipping only
+ * (near-)silent frames while more than RA_LAT frames are queued.
  */
 #include <sys/param.h>
 #include <sys/systm.h>
@@ -43,8 +49,9 @@
 
 #define RA_RATE         48000u
 #define RA_FRAME        4u
-#define RA_RING         8192u                   /* frames, power of two: 170 ms */
-#define RA_PREFILL      1024u                   /* frames kept when the hardware comes up */
+#define RA_RING         32768u                  /* frames, power of two: 680 ms */
+#define RA_LAT          1024u                   /* 21 ms: above this, silent frames are skipped */
+#define RA_QUIET        8                       /* |sample| <= this counts as silence */
 #define RA_IDLE_MS      3000u
 #define RA_WAKE_US      500u
 #define RA_CHUNK        512u
