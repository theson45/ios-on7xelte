@@ -169,6 +176,13 @@
 	return ((uint32_t)l & 0xffffu) | ((uint32_t)r << 16);
 }
 
+static inline bool
+ra_quiet(uint32_t w)
+{
+	int32_t l = (int16_t)(w & 0xffff), r = (int16_t)(w >> 16);
+	return l >= -RA_QUIET && l <= RA_QUIET && r >= -RA_QUIET && r <= RA_QUIET;
+}
