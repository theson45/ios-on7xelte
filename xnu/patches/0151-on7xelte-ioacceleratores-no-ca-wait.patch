--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -130,6 +130,21 @@
 
 OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
 
+/*
+ * 0151: the GPU's service class as QuartzCore looks for it. CAMetalContextCreate
+ * polls IOServiceMatching("IOAcceleratorES") 300 times, usleep(100 ms) apart
+ * (__CAMetalContextCreate_block_invoke, cache 0x18853e5f8), before it asks Metal
+ * for a device: 30 s of backboardd's boot on xnu34, with SpringBoard, chronod and
+ * UserEventAgent waiting behind it. This one has no MetalPluginName, so Metal
+ * passes over it and CoreAnimation draws the way it did after the 30 s.
+ * Boot-arg sweetaccel=0 leaves it out. Same as ios-b0s 0166.
+ */
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
 class IOMobileFramebufferUserClient : public IOUserClient {
 	OSDeclareDefaultStructors(IOMobileFramebufferUserClient);
 
@@ -217,6 +232,16 @@
 	setProperty("external", false);
 	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
 	registerService();
+	{
+		int accel = 1;
+		(void)PE_parse_boot_argn("sweetaccel", &accel, sizeof(accel));
+		IOAcceleratorES *es = accel ? OSTypeAlloc(IOAcceleratorES) : NULL;
+		if (es != NULL && es->init() && es->attach(this)) {
+			es->registerService();
+			IOLog("SWEET FB: IOAcceleratorES published (no Metal plugin)\n");
+		}
+		OSSafeReleaseNULL(es);
+	}
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
 	return true;
