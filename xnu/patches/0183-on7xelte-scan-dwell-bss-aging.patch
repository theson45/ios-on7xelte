-	}
-	case 16:
-	case 17: {
-		int32_t v = r->req_type == 16 ? c->rssi : c->noise;
-		struct {
-			uint32_t version, radios, unit;
-			int32_t each[4], all, each_ext[4], all_ext;
-		} q = { .version = 1, .radios = 1, .each = { v }, .all = v, .each_ext = { v }, .all_ext = v };
-		err = !j || (r->req_type == 17 && v == 0) ? ENXIO : wf_a8_give(r, &q, sizeof(q));
-		break;
-	}
-	case 103:
-		err = j ? wf_a8_give_bss(r, c) : ENXIO;
-		break;
-	case 2: {
-		struct {
-			uint32_t version, lower, upper, extended;
-		} a = { .version = 1, .lower = 1, .upper = c->sec ? 8 : 0 };
-		err = j ? wf_a8_give(r, &a, sizeof(a)) : ENXIO;
-		break;
