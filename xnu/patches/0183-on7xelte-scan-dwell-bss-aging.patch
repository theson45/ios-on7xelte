-/* one SDPCM frame (wf_rxbuf, or a subframe of a superframe): a control response is kept, events and data handed on */
-static void
-wf_frame_at(uint8_t *f, uint32_t flen)
-{
-	uint32_t chan = f[5] & 0xfu, doff = f[7];
-
-	wf_rxn++;
-
-	if (doff < 12 || doff > flen) {
-		printf("USB> wifi: rx: chan %u doffset %u of %u?\n", chan, doff, flen);
-		return;
-	}
-	uint8_t *pl = f + doff;
-	uint32_t plen = flen - doff;
-	if (chan == 0) {
-		if (plen < 16) {
-			return;
-		}
-		uint32_t h[4];
-		memcpy(h, pl, 16);
-		wf_ctl_id = (uint16_t)(h[2] >> 16);
-		wf_ctl_status = (h[2] & 1) ? (int)h[3] : 0;
-		wf_ctl_len = plen - 16 < sizeof(wf_ctl) ? plen - 16 : (uint32_t)sizeof(wf_ctl);
-		memcpy(wf_ctl, pl + 16, wf_ctl_len);
-		wf_ctl_got = true;
-	} else if (chan == 1 || chan == 2) {
-		/* BDC header: flags, priority, flags2, data offset in words; then the ethernet frame */
-		if (plen < 4 || 4u + pl[3] * 4u > plen) {
-			return;
-		}
-		uint32_t o = 4u + pl[3] * 4u;
-		if (chan == 1) {
-			wf_event(pl + o, plen - o);
-		} else if (plen - o >= 14 && pl[o + 12] == 0x88 && pl[o + 13] == 0x8e) {
-			wf_eapol(pl + o, plen - o);     /* 0174: EAPOL, for the host's handshake */
-		} else {
-			wf_net_rx(pl + o, plen - o);    /* 0175: data, to en0 */
-		}
-	} else if (chan == 3 && f == (uint8_t *)wf_rxbuf) {
-		wf_glom_frame(f, flen, doff);   /* 0177: a superframe or its descriptor */
-	} else {
-		printf("USB> wifi: rx: frame on channel %u (%u bytes): %02x %02x %02x %02x %02x %02x %02x %02x\n", chan,
-		    flen, pl[0], pl[1], pl[2], pl[3], pl[4], pl[5], pl[6], pl[7]);
-	}
-}
-
-/*
- * 0177: rx superframes (glom). The firmware sends them though bus:rxglom is 0 (xnu61): first a descriptor
- * on channel 3 (after its header, the subframes' lengths as 16-bit words), then the superframe, whose length
- * is their sum. Subframe i takes its length's bytes from the running offset; the first one starts with the
- * superframe's own header (channel 3), its SDPCM header at that header's data offset. Each subframe is an
- * ordinary SDPCM frame (brcmfmac brcmf_sdio_rxglom).
- */
-static uint16_t wf_glom[64];
-static uint32_t wf_glom_n, wf_glom_sum, wf_glom_bad;
-static uint64_t wf_glom_frames, wf_glom_subs;
-static void wf_frame_at(uint8_t *f, uint32_t flen);
-
-static void
-wf_glom_frame(uint8_t *f, uint32_t flen, uint32_t doff)
-{
-	if (wf_glom_n && flen == wf_glom_sum) {
-		uint32_t off = 0;
-		wf_glom_frames++;
-		for (uint32_t i = 0; i < wf_glom_n; off += wf_glom[i], i++) {
-			uint32_t sl = wf_glom[i], hs = i == 0 ? doff : 0;
-			if (off + sl > flen || hs + 12 > sl) {
-				break;
-			}
-			uint8_t *h = f + off + hs;
-			uint32_t len = (uint32_t)h[0] | (uint32_t)h[1] << 8, chk = (uint32_t)h[2] | (uint32_t)h[3] << 8;
-			if ((len ^ chk) != 0xffffu || len < 12 || len > sl - hs || (h[5] & 0xfu) == 3) {
-				if (wf_glom_bad++ < 10) {
-					printf("USB> wifi: rx glom: subframe %u/%u at %u (+%u) of %u: bad header %02x %02x %02x %02x %02x %02x %02x %02x\n",
-					    i, wf_glom_n, off, hs, flen, h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]);
-				}
-				continue;
-			}
-			uint8_t win = h[9];
-			if ((uint8_t)(win - wf_txseq) <= 0x40) {
-				wf_txmax = win;
-			}
-			wf_glom_subs++;
-			wf_frame_at(h, len);
-		}
-		wf_glom_n = 0;
-		return;
-	}
-	if (wf_glom_n) {
-		if (wf_glom_bad++ < 10) {
-			printf("USB> wifi: rx glom: frame of %u bytes, the descriptor said %u\n", flen, wf_glom_sum);
-		}
-		wf_glom_n = 0;
-	}
-	uint32_t sum = 0, k = 0;
-	for (uint32_t o = doff; o + 2 <= flen && k < 64; o += 2) {
-		uint32_t v = (uint32_t)f[o] | (uint32_t)f[o + 1] << 8;
-		if (!v) {
-			break;
-		}
-		wf_glom[k++] = (uint16_t)v;
-		sum += v;
-	}
-	wf_glom_n = k;
-	wf_glom_sum = sum;
-}
-
-static void
-wf_frame(void)
-{
-	wf_frame_at((uint8_t *)wf_rxbuf, wf_rxlen);
-}
-
-/* what the dongle flagged: mailbox data acked, frames read until it has none */
-static void
-wf_poll(void)
-{
-	uint32_t base = wf_sd()->base, st = wf_rd32(base + SD_INTSTATUS);
-
-	if (wf_bad || !st) {
-		return;
-	}
-	wf_wr32(base + SD_INTSTATUS, st);
-	if (st & I_HMB_HOST_INT) {
-		uint32_t mb = wf_rd32(base + SD_TOHOSTMAILBOXDATA);
-		wf_wr32(base + SD_TOSBMAILBOX, 1u << 1);        /* SMB_INT_ACK */
-		printf("USB> wifi: mailbox from the dongle: 0x%08x\n", mb);
-	}
-	if (st & I_HMB_FRAME_IND) {
-		for (int k = 0; k < 64; k++) {
-			if (wf_sdpcm_recv() <= 0) {
-				break;
-			}
-			wf_frame();
-		}
-	}
-}
-
-/* one BCDC request; the answer's payload is left in wf_ctl. Returns the firmware's status, or -999 */
-static int
-wf_dcmd(uint32_t cmd, bool set, const uint8_t *data, uint32_t len)
-{
-	static uint8_t m[16 + 400];
-
-	if (len > sizeof(m) - 16) {
-		return -999;
-	}
-	uint16_t id = ++wf_reqid;
-	uint32_t h[4] = { cmd, len, ((uint32_t)id << 16) | (set ? 2u : 0u), 0 };
-	memcpy(m, h, 16);
-	memcpy(m + 16, data, len);
-	wf_ctl_got = false;
-	if (!wf_sdpcm_send(0, m, 16 + len)) {
-		printf("USB> wifi: dcmd %u: send failed\n", cmd);
-		return -999;
-	}
-	for (int t = 0; t < 1000 && !wf_bad; t++) {
-		wf_poll();
-		if (wf_ctl_got && wf_ctl_id == id) {
-			return wf_ctl_status;
-		}
-		delay(2000);
-	}
-	printf("USB> wifi: dcmd %u: no answer (id %u, last id %u, txseq %u window %u)\n", cmd, id, wf_ctl_id, wf_txseq,
-	    wf_txmax);
-	return -999;
-}
-
-/* iovar get: name, then room for the answer */
-static int
-wf_iovar_get(const char *name, uint32_t room)
-{
-	static uint8_t b[400];
-	uint32_t nl = (uint32_t)strlen(name) + 1;
-
-	if (room < nl) {
-		room = nl;
-	}
-	if (room > sizeof(b)) {
-		room = sizeof(b);
-	}
-	bzero(b, room);
-	memcpy(b, name, nl);
-	return wf_dcmd(WLC_GET_VAR, false, b, room);
-}
-
-static int
-wf_iovar_set(const char *name, const void *v, uint32_t vlen)
-{
-	static uint8_t b[400];
-	uint32_t nl = (uint32_t)strlen(name) + 1;
-
-	if (nl + vlen > sizeof(b)) {
-		return -999;
-	}
-	memcpy(b, name, nl);
-	memcpy(b + nl, v, vlen);
-	return wf_dcmd(WLC_SET_VAR, true, b, nl + vlen);
-}
