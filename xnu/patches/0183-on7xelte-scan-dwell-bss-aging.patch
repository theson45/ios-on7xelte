-static void
-wf_probe(bool keep)
-{
-	(void)wf_bringup();
-	if (keep) {
-		printf("USB> wifi: probe done, left powered (wifi off turns it off)\n");
-		wf_st();
-	} else {
-		wf_off();
-	}
