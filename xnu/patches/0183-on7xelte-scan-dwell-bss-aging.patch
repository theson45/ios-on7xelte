-/* 0162: a hex number of the command line; *ok false if there was none */
-static uint32_t
-wf_hex(const char **pp, bool *ok)
-{
-	const char *p = *pp;
-	uint32_t v = 0, n = 0;
-
-	while (*p == ' ') {
-		p++;
-	}
-	if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
-		p += 2;
-	}
-	for (;; p++, n++) {
-		char c = *p;
-		uint32_t d;
-		if (c >= '0' && c <= '9') {
-			d = (uint32_t)(c - '0');
-		} else if (c >= 'a' && c <= 'f') {
-			d = (uint32_t)(c - 'a' + 10);
-		} else if (c >= 'A' && c <= 'F') {
-			d = (uint32_t)(c - 'A' + 10);
-		} else {
-			break;
-		}
-		v = (v << 4) | d;
-	}
-	*ok = n > 0;
-	*pp = p;
-	return v;
-}
