+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define WF_MMC_PA       0x13550000u
+#define WF_PINR_PA      0x13750000u     /* gpr2 at +0x40, gpr3 at +0x60 */
+#define WF_PIND_PA      0x139B0000u     /* gpd3 at +0x140 */
+
+/* DW MSHC */
+#define M_CTRL          0x000u
+#define M_PWREN         0x004u
+#define M_CLKDIV        0x008u
+#define M_CLKSRC        0x00cu
+#define M_CLKENA        0x010u
+#define M_TMOUT         0x014u
+#define M_CTYPE         0x018u
+#define M_INTMASK       0x024u
+#define M_CMDARG        0x028u
+#define M_CMD           0x02cu
+#define M_RESP0         0x030u
+#define M_RINTSTS       0x044u
+#define M_STATUS        0x048u
+#define M_FIFOTH        0x04cu
+#define M_VERID         0x06cu
+#define M_HCON          0x070u
+#define M_CLKSEL        0x0a8u
+
+#define CTRL_RESETS     0x7u            /* controller, FIFO, DMA */
+#define CMD_START       (1u << 31)
+#define CMD_HOLD        (1u << 29)
+#define CMD_UPD_CLK     (1u << 21)
+#define CMD_INIT        (1u << 15)
+#define CMD_WAIT_PRV    (1u << 13)
+#define CMD_CRC         (1u << 8)
+#define CMD_RESP        (1u << 6)
+#define RINT_CMD_DONE   (1u << 2)
+#define RINT_RE         (1u << 1)
+#define RINT_RCRC       (1u << 6)
+#define RINT_RTO        (1u << 8)
+#define RINT_HLE        (1u << 12)
+
+/* Exynos CLKSEL: DIVIDER(3) | DRIVE(2) | SAMPLE(0), as dw_mmc-exynos makes of <3 0 2 0> */
+#define WF_CLKSEL       ((3u << 24) | (2u << 16) | 0u)
+#define WF_CLKDIV_SLOW  255u            /* cclk_in / 510: <= 400 kHz for any cclk_in up to 200 MHz */
+
+/* GPIO bank registers (bank_type_4: CON 4b, DAT 1b, PUD 2b, DRV 3b, CONPDN 2b, PUDPDN 2b) */
+#define G_CON           0x00u
+#define G_DAT           0x04u
+#define G_PUD           0x08u
+#define G_DRV           0x0cu
+#define G_CONPDN        0x10u
+#define G_PUDPDN        0x14u
+#define GPR2            0x040u
+#define GPR3            0x060u
+#define GPD3            0x140u
+#define REG_ON_PIN      6u
+
+/* brcmfmac's function-1 registers */
+#define SB_SBADDRLOW    0x1000au
+#define SB_SBADDRMID    0x1000bu
+#define SB_SBADDRHIGH   0x1000cu
+#define SB_CHIPCLKCSR   0x1000eu
+#define SB_SDIOPULLUP   0x1000fu
+#define CLK_FORCE_ALP   0x01u
+#define CLK_ALP_REQ     0x08u
+#define CLK_HW_OFF      0x20u
+#define CLK_ALP_AVAIL   0x40u
+#define SI_ENUM_BASE    0x18000000u
+
+static vm_offset_t wf_mmc, wf_pinr, wf_pind;
+static uint32_t wf_win = 0xffffffffu;   /* the backplane window function 1 is set to (0161) */
+static uint32_t wf_chipid;              /* chipcommon's ID register, as the probe read it */
+static bool wf_fwup;                    /* 0170: the firmware runs (W3 done), W4 commands may talk to it */
+static bool wf_w4init;                  /* 0170: F2 block size etc. set for this power-up */
+static uint32_t wf_fw_cons, wf_fw_ram;  /* 0170: its console address and RAM size */
+static uint32_t wf_last_e, wf_last_r;   /* 0162: the last CMD52's RINTSTS error bits and R5 */
+
+static inline uint32_t
+rd32(vm_offset_t b, uint32_t off)
+{
+	return *(volatile uint32_t *)(b + off);
+}
+
+static inline void
+wr32(vm_offset_t b, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(b + off) = v;
+}
+
+static void
+fld(vm_offset_t b, uint32_t off, uint32_t pin, uint32_t width, uint32_t val)
+{
+	uint32_t m = ((1u << width) - 1u) << (pin * width);
+	wr32(b, off, (rd32(b, off) & ~m) | ((val << (pin * width)) & m));
+}
+
+static bool
+wf_map(void)
+{
+	if (!wf_mmc) {
+		wf_mmc = ml_io_map(WF_MMC_PA, 0x2000);
+		wf_pinr = ml_io_map(WF_PINR_PA, 0x1000);
+		wf_pind = ml_io_map(WF_PIND_PA, 0x1000);
+	}
+	if (!wf_mmc || !wf_pinr || !wf_pind) {
+		printf("USB> wifi: could not map the registers\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+wf_regon(bool on)
+{
+	/* gpd3-6: output, no pull, drive 3 (as cfg_wlanen), keeps its level in power-down */
+	fld(wf_pind, GPD3 + G_DAT, REG_ON_PIN, 1, on ? 1 : 0);
+	fld(wf_pind, GPD3 + G_PUD, REG_ON_PIN, 2, 0);
+	fld(wf_pind, GPD3 + G_DRV, REG_ON_PIN, 3, 3);
+	fld(wf_pind, GPD3 + G_CONPDN, REG_ON_PIN, 2, 3);
+	fld(wf_pind, GPD3 + G_PUDPDN, REG_ON_PIN, 2, 0);
+	fld(wf_pind, GPD3 + G_CON, REG_ON_PIN, 4, 1);
+	fld(wf_pind, GPD3 + G_DAT, REG_ON_PIN, 1, on ? 1 : 0);
+}
+
+static void
+wf_pins_sd(void)
+{
+	/* sd1_clk/sd1_cmd: function 2, no pull, drive 2 */
+	for (uint32_t p = 0; p < 2; p++) {
+		fld(wf_pinr, GPR2 + G_PUD, p, 2, 0);
+		fld(wf_pinr, GPR2 + G_DRV, p, 3, 2);
+		fld(wf_pinr, GPR2 + G_CON, p, 4, 2);
+	}
+	/* sd1_bus1/bus4: function 2, pull-up (on7xelte DT), drive 2, power-down: function 2 + pull-up */
+	for (uint32_t p = 0; p < 4; p++) {
+		fld(wf_pinr, GPR3 + G_PUD, p, 2, 3);
+		fld(wf_pinr, GPR3 + G_DRV, p, 3, 2);
+		fld(wf_pinr, GPR3 + G_CONPDN, p, 2, 2);
+		fld(wf_pinr, GPR3 + G_PUDPDN, p, 2, 3);
+		fld(wf_pinr, GPR3 + G_CON, p, 4, 2);
+	}
+}
+
+static bool
+wf_wait_clear(uint32_t off, uint32_t bits, uint32_t us)
+{
+	for (uint32_t t = 0; t < us; t += 10) {
+		if (!(rd32(wf_mmc, off) & bits)) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
+
+static bool
+wf_clk_update(void)
+{
+	wr32(wf_mmc, M_CMDARG, 0);
+	wr32(wf_mmc, M_CMD, CMD_START | CMD_HOLD | CMD_UPD_CLK | CMD_WAIT_PRV);
+	if (!wf_wait_clear(M_CMD, CMD_START, 100000)) {
+		printf("USB> wifi: clock update not taken (RINTSTS 0x%08x)\n", rd32(wf_mmc, M_RINTSTS));
+		return false;
+	}
+	return true;
+}
+
+static bool
+wf_host_init(void)
+{
+	wr32(wf_mmc, M_CTRL, CTRL_RESETS);
+	if (!wf_wait_clear(M_CTRL, CTRL_RESETS, 100000)) {
+		printf("USB> wifi: controller reset stuck (CTRL 0x%08x)\n", rd32(wf_mmc, M_CTRL));
+		return false;
+	}
+	wr32(wf_mmc, M_INTMASK, 0);
+	wr32(wf_mmc, M_RINTSTS, 0xffffffffu);
+	wr32(wf_mmc, M_TMOUT, 0xffffffffu);
+	wr32(wf_mmc, M_CTYPE, 0);                       /* 1-bit while enumerating */
+	wr32(wf_mmc, M_FIFOTH, 0x201f0020u);            /* 0166: as dw_mmc: MSIZE 8, RX 31, TX 32 (depth 64 / 2) */
+	wr32(wf_mmc, M_CLKSEL, WF_CLKSEL);
+	wr32(wf_mmc, M_PWREN, 1);
+	delay(10000);
+	wr32(wf_mmc, M_CLKENA, 0);
+	if (!wf_clk_update()) {
+		return false;
+	}
+	wr32(wf_mmc, M_CLKDIV, WF_CLKDIV_SLOW);
+	wr32(wf_mmc, M_CLKSRC, 0);
+	if (!wf_clk_update()) {
+		return false;
+	}
+	wr32(wf_mmc, M_CLKENA, 1);
+	if (!wf_clk_update()) {
+		return false;
+	}
+	delay(2000);
+	printf("USB> wifi: dwmmc1 up: VERID 0x%08x HCON 0x%08x CLKSEL 0x%08x CLKDIV %u STATUS 0x%08x\n",
+	    rd32(wf_mmc, M_VERID), rd32(wf_mmc, M_HCON), rd32(wf_mmc, M_CLKSEL), rd32(wf_mmc, M_CLKDIV),
+	    rd32(wf_mmc, M_STATUS));
+	return true;
+}
+
+/*
+ * 0163: wait until the controller can take a command: the previous one started (CMD bit 31 clear), the
+ * command FSM idle (STATUS 7:4 == 0: after a response it still waits Ncc clocks, 20 us at 400 kHz, and a
+ * command written then is refused with HLE), and no data busy (STATUS 9, 10).
+ */
+static bool
+wf_idle(void)
+{
+	for (uint32_t t = 0; t < 100000; t += 2) {
+		if (!(rd32(wf_mmc, M_CMD) & CMD_START) && !(rd32(wf_mmc, M_STATUS) & 0x6f0u)) {
+			return true;
+		}
+		delay(2);
+	}
+	return false;
+}
+
+/* One command without data; 0 = response in *resp, else the RINTSTS error bits (or 1: stuck). */
+static uint32_t
+wf_cmd(uint32_t idx, uint32_t arg, uint32_t flags, uint32_t *resp)
+{
+	(void)wf_idle();
+	wr32(wf_mmc, M_RINTSTS, 0xffffffffu);
+	wr32(wf_mmc, M_CMDARG, arg);
+	wr32(wf_mmc, M_CMD, CMD_START | CMD_HOLD | CMD_WAIT_PRV | flags | (idx & 0x3f));
+	uint32_t st = 0;
+	for (uint32_t t = 0; t < 200000; t += 10) {
+		st = rd32(wf_mmc, M_RINTSTS);
+		if (st & (RINT_CMD_DONE | RINT_HLE)) {
+			break;
+		}
+		delay(10);
+	}
+	wr32(wf_mmc, M_RINTSTS, st);
+	if (!(st & RINT_CMD_DONE)) {
+		return st ? st : 1;
+	}
+	uint32_t err = st & (RINT_RE | RINT_RTO | RINT_HLE | ((flags & CMD_CRC) ? RINT_RCRC : 0));
+	if (resp) {
+		*resp = rd32(wf_mmc, M_RESP0);
+	}
+	return err;
+}
+
+/* CMD52: one byte of function fn at addr; write if wr, returns the R5 flags << 8 | data, or -1 */
+static int
+wf_cmd52(uint32_t fn, uint32_t addr, bool wr, uint8_t data)
+{
+	uint32_t arg = (wr ? (1u << 31) : 0) | ((fn & 7) << 28) | ((addr & 0x1ffff) << 9) | data;
+	uint32_t r = 0, e = wf_cmd(52, arg, CMD_RESP | CMD_CRC, &r);
+	wf_last_e = e;
+	wf_last_r = r;
+	if (e || (r & 0xcb00u)) {       /* R5: CRC, illegal command, error, function number, out of range */
+		return -1;
+	}
+	return (int)(r & 0xffff);
+}
+
+static int
+wf_rd8(uint32_t fn, uint32_t addr)
+{
+	int r = wf_cmd52(fn, addr, false, 0);
+	return r < 0 ? -1 : (r & 0xff);
+}
+
+static bool
+wf_wr8(uint32_t fn, uint32_t addr, uint8_t v)
+{
+	return wf_cmd52(fn, addr, true, v) >= 0;
+}
+
+static void
+wf_off(void)
+{
+	if (!wf_map()) {
+		return;
+	}
+	wf_regon(false);
+	wf_chipid = 0;
+	wf_fwup = false;
+	wf_w4init = false;
+	wr32(wf_mmc, M_CLKENA, 0);
+	(void)wf_clk_update();
+	wr32(wf_mmc, M_PWREN, 0);
+	printf("USB> wifi: off (REG_ON low, dwmmc1 clock and power off)\n");
+}
+
+static void
+wf_st(void)
+{
+	if (!wf_map()) {
+		return;
+	}
+	printf("USB> wifi: dwmmc1 CTRL 0x%08x PWREN 0x%x CLKDIV 0x%x CLKENA 0x%x CTYPE 0x%x STATUS 0x%08x "
+	    "RINTSTS 0x%08x CLKSEL 0x%08x\n", rd32(wf_mmc, M_CTRL), rd32(wf_mmc, M_PWREN), rd32(wf_mmc, M_CLKDIV),
+	    rd32(wf_mmc, M_CLKENA), rd32(wf_mmc, M_CTYPE), rd32(wf_mmc, M_STATUS), rd32(wf_mmc, M_RINTSTS),
+	    rd32(wf_mmc, M_CLKSEL));
+	printf("USB> wifi: gpd3 CON 0x%08x DAT 0x%02x  gpr2 CON 0x%08x PUD 0x%04x  gpr3 CON 0x%08x PUD 0x%04x\n",
+	    rd32(wf_pind, GPD3 + G_CON), rd32(wf_pind, GPD3 + G_DAT), rd32(wf_pinr, GPR2 + G_CON),
+	    rd32(wf_pinr, GPR2 + G_PUD), rd32(wf_pinr, GPR3 + G_CON), rd32(wf_pinr, GPR3 + G_PUD));
+}
+
+static bool
+wf_enumerate(void)
+{
+	uint32_t r = 0, e;
+
+	/* CMD0 with the 80 initialisation clocks; an SDIO-only card may not answer, which is fine */
+	(void)wf_cmd(0, 0, CMD_INIT, NULL);
+	delay(2000);
+
+	e = wf_cmd(5, 0, CMD_RESP, &r);
+	if (e) {
+		printf("USB> wifi: CMD5 (arg 0): no answer (RINTSTS bits 0x%08x) -- no SDIO card\n", e);
+		return false;
+	}
+	uint32_t ocr = r;
+	printf("USB> wifi: CMD5: OCR 0x%08x, %u function(s), memory %s\n", ocr, (ocr >> 28) & 7,
+	    (ocr & (1u << 27)) ? "present" : "absent");
+	uint32_t want = ocr & 0x00ff8000u;
+	if (!want) {
+		want = 0x00ff8000u;
+	}
+	uint32_t i;
+	for (i = 0; i < 100; i++) {
+		e = wf_cmd(5, want, CMD_RESP, &r);
+		if (!e && (r & (1u << 31))) {
+			break;
+		}
+		delay(10000);
+	}
+	if (i == 100) {
+		printf("USB> wifi: CMD5: card never ready (last 0x%08x, err 0x%08x)\n", r, e);
+		return false;
+	}
+	printf("USB> wifi: CMD5: ready after %u tries, OCR 0x%08x\n", i + 1, r);
+
+	e = wf_cmd(3, 0, CMD_RESP | CMD_CRC, &r);
+	if (e) {
+		printf("USB> wifi: CMD3 failed (0x%08x)\n", e);
+		return false;
+	}
+	uint32_t rca = r >> 16;
+	e = wf_cmd(7, rca << 16, CMD_RESP | CMD_CRC, &r);
+	if (e) {
+		printf("USB> wifi: CMD7 (RCA 0x%04x) failed (0x%08x)\n", rca, e);
+		return false;
+	}
+	printf("USB> wifi: card selected, RCA 0x%04x (R1 0x%08x)\n", rca, r);
+	return true;
+}
+
+static bool
+wf_bringup(void)
+{
+	if (!wf_map()) {
+		return false;
+	}
+	wf_win = 0xffffffffu;
+	wf_chipid = 0;
+	printf("USB> wifi: probe: pins to SD, REG_ON high\n");
+	wf_regon(false);
+	delay(20000);
+	wf_pins_sd();
+	wf_regon(true);
+	delay(200000);                  /* dhd: the chip's power-on and its SDIO core */
+	if (!wf_host_init() || !wf_enumerate()) {
+		return false;
+	}
+
+	int cccr = wf_rd8(0, 0x00), sdr = wf_rd8(0, 0x01), caps = wf_rd8(0, 0x08), hs = wf_rd8(0, 0x13);
+	int cis = wf_rd8(0, 0x09) | (wf_rd8(0, 0x0a) << 8) | (wf_rd8(0, 0x0b) << 16);
+	printf("USB> wifi: CCCR rev 0x%02x SD 0x%02x caps 0x%02x high-speed 0x%02x CIS 0x%06x\n",
+	    cccr, sdr, caps, hs, cis);
+	if (cccr < 0) {
+		return false;
+	}
+	/* the first CIS tuples: MANFID 0x20 gives vendor (0x02d0 Broadcom) and device */
+	for (int a = cis, n = 0; a > 0 && n < 8; n++) {
+		int code = wf_rd8(0, (uint32_t)a), len = wf_rd8(0, (uint32_t)a + 1);
+		if (code < 0 || code == 0xff || len < 0) {
+			break;
+		}
+		if (code == 0x20 && len >= 4) {
+			printf("USB> wifi: CIS MANFID vendor 0x%04x device 0x%04x\n",
+			    wf_rd8(0, (uint32_t)a + 2) | (wf_rd8(0, (uint32_t)a + 3) << 8),
+			    wf_rd8(0, (uint32_t)a + 4) | (wf_rd8(0, (uint32_t)a + 5) << 8));
+		}
+		a += 2 + len;
+	}
+
+	/* function 1 on */
+	wf_wr8(0, 0x02, 0x02);
+	int ready = 0;
+	for (int t = 0; t < 100 && !(ready & 0x02); t++) {
+		ready = wf_rd8(0, 0x03);
+		if (ready < 0) {
+			ready = 0;
+		}
+		delay(10000);
+	}
+	printf("USB> wifi: function 1 %s (IORx 0x%02x)\n", (ready & 0x02) ? "ready" : "NOT ready", ready);
+	if (!(ready & 0x02)) {
+		return false;
+	}
+
+	/* ALP clock, as brcmf_sdio_probe_attach() asks for it */
+	wf_wr8(1, SB_CHIPCLKCSR, CLK_HW_OFF | CLK_ALP_REQ);
+	int clk = 0;
+	for (int t = 0; t < 100 && !(clk & CLK_ALP_AVAIL); t++) {
+		clk = wf_rd8(1, SB_CHIPCLKCSR);
+		if (clk < 0) {
+			clk = 0;
+		}
+		delay(1000);
+	}
+	printf("USB> wifi: ALP clock %s (CHIPCLKCSR 0x%02x)\n", (clk & CLK_ALP_AVAIL) ? "available" : "NOT available",
+	    clk);
+	if (!(clk & CLK_ALP_AVAIL)) {
+		return false;
+	}
+	wf_wr8(1, SB_CHIPCLKCSR, CLK_HW_OFF | CLK_FORCE_ALP);
+	wf_wr8(1, SB_SDIOPULLUP, 0);
+
+	/* the backplane window on chipcommon, then its ID register byte by byte */
+	wf_wr8(1, SB_SBADDRLOW, (SI_ENUM_BASE >> 8) & 0x80);
+	wf_wr8(1, SB_SBADDRMID, (SI_ENUM_BASE >> 16) & 0xff);
+	wf_wr8(1, SB_SBADDRHIGH, (SI_ENUM_BASE >> 24) & 0xff);
+	uint32_t id = 0;
+	bool ok = true;
+	for (uint32_t b = 0; b < 4; b++) {
+		int v = wf_rd8(1, (SI_ENUM_BASE & 0x7fff) + b);
+		if (v < 0) {
+			ok = false;
+			break;
+		}
+		id |= (uint32_t)v << (8 * b);
+	}
+	if (ok) {
+		printf("USB> wifi: chipcommon ID 0x%08x: chip 0x%04x (%u) rev %u, package %u, %u cores\n",
+		    id, id & 0xffff, id & 0xffff, (id >> 16) & 0xf, (id >> 20) & 0xf, (id >> 24) & 0xf);
+	} else {
+		printf("USB> wifi: chipcommon ID read failed\n");
+	}
+	wf_chipid = ok ? id : 0;
+	return ok;
+}
+
+static void
+wf_probe(bool keep)
+{
+	(void)wf_bringup();
+	if (keep) {
+		printf("USB> wifi: probe done, left powered (wifi off turns it off)\n");
+		wf_st();
+	} else {
+		wf_off();
+	}
+}
+
+/*
+ * ---- W3 (0161): data transfers, the backplane, the firmware download ----
+ *
+ * As bcmdhd (dhd_sdio.c dhdsdio_download_state / dhdsdio_write_vars / dhdsdio_bus_init, aiutils.c) does it
+ * for a Cortex-M3 chip: ARM core held in reset, SOCRAM reset (bank 3 remap off on the 43430), the image at
+ * RAM address 0, the NVRAM variables at the top of RAM under their length token, SDIO-core interrupts
+ * cleared, ARM out of reset; then the HT clock, function 2 with the SDPCM protocol version, and the
+ * firmware's own word at the end of RAM: the address of its sdpcm_shared, which names its console.
+ */
+#define M_BLKSIZ        0x01cu
+#define M_BYTCNT        0x020u
+#define M_FIFO          0x200u          /* DW MSHC >= 2.40a */
+#define CTRL_FIFO_RST   0x2u
+#define CMD_DATA        (1u << 9)
+#define CMD_WRITE       (1u << 10)
+#define RINT_DTO        (1u << 3)
+#define RINT_TXDR       (1u << 4)
+#define RINT_RXDR       (1u << 5)
+#define RINT_DERR       ((1u << 7) | (1u << 9) | (1u << 10) | (1u << 11) | (1u << 13) | (1u << 15))
+#define SB_ACCESS_4B    0x8000u
+#define SB_OFT_MASK     0x7fffu
+#define WF_CHUNK        64u             /* function-1 block size; one CMD53 in byte mode */
+
+#define CLK_FORCE_HT    0x02u
+#define CLK_HT_REQ      0x10u
+#define CLK_HT_AVAIL    0x80u
+#define SB_WATERMARK    0x10008u
+
+#define CORE_SOCRAM     0x80eu
+#define CORE_D11        0x812u
+#define CORE_SDIOD      0x829u
+#define CORE_CM3        0x82au
+
+#define AI_IOCTRL       0x408u
+#define AI_RESETCTRL    0x800u
+#define AI_RESETSTATUS  0x804u
+#define SICF_FGC        0x2u
+#define SICF_CLOCK_EN   0x1u
+
+#define SR_COREINFO     0x00u
+#define SR_BANKIDX      0x10u
+#define SR_BANKINFO     0x40u
+#define SR_BANKPDA      0x44u
+#define SD_INTSTATUS    0x20u
+#define SD_TOSBMAILBOXDATA 0x48u
+
+#define WF_FW_PATH      "/usr/share/firmware/wifi/on7xelte/bcm43430a1-sdio.bin"
+#define WF_NV_PATH      "/usr/share/firmware/wifi/on7xelte/bcm43430a1-sdio.txt"
+
+struct wf_core {
+	uint32_t id, rev, base, wrap;
+};
+static struct wf_core wf_cores[16];
+static uint32_t wf_ncores;
+static bool wf_bad;                     /* a backplane access failed since it was last cleared */
+static uint32_t wf_errs;                /* data-transfer errors, the first few of which are told */
+
+/* CMD53 in byte mode, incrementing: n (4..64, a multiple of 4) bytes of function fn at addr */
+static bool wf_cmd53_once(uint32_t fn, uint32_t addr, bool wr, uint32_t *buf, uint32_t n, bool quiet);
+
+static bool
+wf_cmd53(uint32_t fn, uint32_t addr, bool wr, uint32_t *buf, uint32_t n)
+{
+	if (wf_cmd53_once(fn, addr, wr, buf, n, true)) {
+		return true;
+	}
+	delay(1000);
+	return wf_cmd53_once(fn, addr, wr, buf, n, false);   /* 0163: once more, and tell if that fails too */
+}
+
+/*
+ * 0168: how a FIFO entry is written ('wifi fifo N'). 0167 (xnu51): one 64-bit str at 0x200 after TXDR, still
+ * FIFO count 0 and the card left waiting in TRN. 0 = 64-bit str at 0x200, 1 = 32-bit low at 0x200 and high at
+ * 0x204, 2 = both 32-bit halves at 0x200, 3 = only 32-bit words at 0x200 (no padding).
+ */
+static uint32_t wf_fifo_mode = 1;      /* 0169: mode 1 works (xnu52): SOCRAM written right */
+static uint32_t wf_div = 4;             /* 0169: 'wifi div N' (hex); 0170: 4 by default (xnu53: 2.4 s, clean) */
+
+static void
+wf_fifo_put(uint32_t lo, uint32_t hi)
+{
+	switch (wf_fifo_mode) {
+	case 1:
+		wr32(wf_mmc, M_FIFO, lo);
+		wr32(wf_mmc, M_FIFO + 4, hi);
+		break;
+	case 2:
+		wr32(wf_mmc, M_FIFO, lo);
+		wr32(wf_mmc, M_FIFO, hi);
+		break;
+	default:
+		*(volatile uint64_t *)(wf_mmc + M_FIFO) = lo | ((uint64_t)hi << 32);
+		break;
+	}
+}
+
+/* 0171: up to max FIFO entries into buf[got..nw), each as 0x200 (low) then 0x204 (high); returns the new got */
+static uint32_t
+wf_fifo_take(uint32_t *buf, uint32_t got, uint32_t nw, uint32_t max)
+{
+	for (uint32_t e = 0; e < max && got < nw; e++) {
+		buf[got] = rd32(wf_mmc, M_FIFO);
+		uint32_t hi = rd32(wf_mmc, M_FIFO + 4);
+		if (got + 1 < nw) {
+			buf[got + 1] = hi;
+		}
+		got += 2;
+	}
+	return got;
+}
+
+static bool
+wf_cmd53_once(uint32_t fn, uint32_t addr, bool wr, uint32_t *buf, uint32_t n, bool quiet)
+{
+	uint32_t arg = (wr ? (1u << 31) : 0) | ((fn & 7) << 28) | (1u << 26) | ((addr & 0x1ffff) << 9) | (n & 0x1ff);
+	uint32_t st = 0, r = 0, pre = 0, sent = 0, nw = n / 4;
+
+	(void)wf_idle();
+	wr32(wf_mmc, M_CTRL, rd32(wf_mmc, M_CTRL) | CTRL_FIFO_RST);
+	if (!wf_wait_clear(M_CTRL, CTRL_FIFO_RST, 10000)) {
+		goto bad;
+	}
+	wr32(wf_mmc, M_BLKSIZ, n);
+	wr32(wf_mmc, M_BYTCNT, n);
+	/*
+	 * 0167: no FIFO prefill. 0166 showed the FIFO still empty after it (stores before the data command are
+	 * dropped) and RINTSTS TXDR set: the controller was asking for data. As dw_mmc's PIO path
+	 * (dw_mci_write_data_pio on TXDR), push the data once the command runs and TXDR is raised.
+	 */
+	wr32(wf_mmc, M_RINTSTS, 0xffffffffu);
+	wr32(wf_mmc, M_CMDARG, arg);
+	wr32(wf_mmc, M_CMD, CMD_START | CMD_HOLD | CMD_WAIT_PRV | CMD_RESP | CMD_CRC | CMD_DATA |
+	    (wr ? CMD_WRITE : 0) | 53);
+	for (uint32_t t = 0; t < 500000; t += 5) {
+		st = rd32(wf_mmc, M_RINTSTS);
+		if (wr && sent < nw && (st & RINT_TXDR)) {
+			/* 64-bit FIFO (HCON H_DATA_WIDTH 2), depth 64: push while there is room; odd last word + zeros */
+			uint32_t fc = (rd32(wf_mmc, M_STATUS) >> 17) & 0x1fff;
+			uint32_t before = rd32(wf_mmc, M_STATUS);
+			while (sent < nw && fc < 64) {
+				if (wf_fifo_mode == 3) {
+					wr32(wf_mmc, M_FIFO, buf[sent]);
+					sent += 1;
+				} else {
+					wf_fifo_put(buf[sent], (sent + 1 < nw) ? buf[sent + 1] : 0);
+					sent += 2;
+				}
+				fc++;
+			}
+			pre = rd32(wf_mmc, M_STATUS);
+			(void)before;
+			wr32(wf_mmc, M_RINTSTS, RINT_TXDR);
+			continue;
+		}
+		if (!wr && wf_fifo_mode == 1 && sent < nw && (st & RINT_RXDR)) {
+			/* 0171: as dw_mci_read_data_pio on RXDR: take what the FIFO holds (entries of 64 bits) */
+			uint32_t fc = (rd32(wf_mmc, M_STATUS) >> 17) & 0x1fff;
+			sent = wf_fifo_take(buf, sent, nw, fc);
+			wr32(wf_mmc, M_RINTSTS, RINT_RXDR);
+			continue;
+		}
+		if ((st & RINT_DTO) || (st & (RINT_HLE | RINT_DERR)) ||
+		    ((st & RINT_CMD_DONE) && (st & (RINT_RE | RINT_RTO | RINT_RCRC)))) {
+			break;
+		}
+		delay(5);
+	}
+	r = rd32(wf_mmc, M_RESP0);
+	wr32(wf_mmc, M_RINTSTS, st);
+	if (!(st & RINT_DTO) || (st & (RINT_HLE | RINT_DERR | RINT_RE | RINT_RTO | RINT_RCRC)) || (r & 0xcb00u)) {
+		goto bad;
+	}
+	if (!wr && wf_fifo_mode == 1) {
+		/* 0169: a 64-bit FIFO entry read as two 32-bit halves, 0x200 then 0x204; 0171: the rest after DTO */
+		sent = wf_fifo_take(buf, sent, nw, 64);
+	} else if (!wr) {
+		for (uint32_t i = 0; i < n / 4; i++) {
+			buf[i] = rd32(wf_mmc, M_FIFO);
+		}
+	}
+	return true;
+bad:
+	{
+		uint32_t stat = rd32(wf_mmc, M_STATUS);
+		wr32(wf_mmc, M_CTRL, rd32(wf_mmc, M_CTRL) | CTRL_RESETS);
+		(void)wf_wait_clear(M_CTRL, CTRL_RESETS, 100000);
+		wr32(wf_mmc, M_RINTSTS, 0xffffffffu);
+		(void)wf_clk_update();
+		(void)wf_wr8(0, 0x06, (uint8_t)(fn & 7));       /* CCCR I/O abort of this function */
+		wr32(wf_mmc, M_RINTSTS, 0xffffffffu);
+		if (!quiet && wf_errs < 6) {
+			printf("USB> wifi: CMD53 recovery: STATUS 0x%08x -> 0x%08x (HCON data width %u)\n", stat,
+			    rd32(wf_mmc, M_STATUS), (rd32(wf_mmc, M_HCON) >> 7) & 7);
+		}
+	}
+	if (quiet) {
+		return false;
+	}
+	if (wf_errs++ < 6) {
+		printf("USB> wifi: CMD53 %s fn %u addr 0x%05x n %u failed twice: RINTSTS 0x%08x R5 0x%08x STATUS 0x%08x"
+		    " (pushed %u of %u words, then STATUS 0x%08x / %u in FIFO; CTRL 0x%08x BMOD 0x%08x; bus %u-bit)\n",
+		    wr ? "write" : "read", fn, addr, n, st, r, rd32(wf_mmc, M_STATUS), sent > nw ? nw : sent, nw, pre,
+		    (pre >> 17) & 0x1fff, rd32(wf_mmc, M_CTRL), rd32(wf_mmc, 0x080u), rd32(wf_mmc, M_CTYPE) ? 4 : 1);
+	}
+	wf_bad = true;
+	return false;
+}
+
+static bool
+wf_setwin(uint32_t addr)
+{
+	uint32_t w = addr & ~SB_OFT_MASK;
+
+	if (w == wf_win) {
+		return true;
+	}
+	static const uint32_t reg[3] = { SB_SBADDRLOW, SB_SBADDRMID, SB_SBADDRHIGH };
+	uint8_t val[3] = { (uint8_t)((w >> 8) & 0x80), (uint8_t)((w >> 16) & 0xff), (uint8_t)((w >> 24) & 0xff) };
+	for (uint32_t i = 0; i < 3; i++) {
+		if (!wf_wr8(1, reg[i], val[i])) {
+			/* 0162: say which byte and why; one retry, as the card may still be busy from a CMD53 */
+			uint32_t e1 = wf_last_e, r1 = wf_last_r;
+			delay(1000);
+			bool again = wf_wr8(1, reg[i], val[i]);
+			if (wf_errs++ < 6) {
+				printf("USB> wifi: window 0x%08x: CMD52 write 0x%05x = 0x%02x failed: err 0x%08x R5 0x%08x "
+				    "STATUS 0x%08x; retry %s (err 0x%08x R5 0x%08x)\n", w, reg[i], val[i], e1, r1,
+				    rd32(wf_mmc, M_STATUS), again ? "ok" : "failed", wf_last_e, wf_last_r);
+			}
+			if (!again) {
+				wf_win = 0xffffffffu;
+				wf_bad = true;
+				return false;
+			}
+		}
+	}
+	wf_win = w;
+	return true;
+}
+
+/* n <= 64 bytes at a backplane address, inside one 32 KiB window */
+static bool
+wf_bp(uint32_t addr, bool wr, uint32_t *buf, uint32_t n)
+{
+	if (wf_bad) {
+		return false;   /* 0164: fail fast after the first error */
+	}
+	return wf_setwin(addr) && wf_cmd53(1, (addr & SB_OFT_MASK) | SB_ACCESS_4B, wr, buf, n);
+}
+
+static uint32_t
+wf_rd32(uint32_t addr)
+{
+	uint32_t v = 0;
+
+	if (!wf_bp(addr, false, &v, 4)) {
+		return 0xffffffffu;
+	}
+	return v;
+}
+
+static void
+wf_wr32(uint32_t addr, uint32_t v)
+{
+	(void)wf_bp(addr, true, &v, 4);
+}
+
+/* len bytes of chip memory at addr (4-aligned), in 64-byte pieces; verify compares instead of storing */
+static bool
+wf_mem(uint32_t addr, bool wr, uint8_t *data, uint32_t len, bool verify, uint32_t *diffs)
+{
+	uint32_t chunk[WF_CHUNK / 4];
+
+	while (len) {
+		uint32_t n = WF_CHUNK - (addr & (WF_CHUNK - 1));
+		if (n > len) {
+			n = len;
+		}
+		uint32_t nw = (n + 3) & ~3u;
+		if (wr) {
+			bzero(chunk, sizeof(chunk));
+			memcpy(chunk, data, n);
+		}
+		if (!wf_bp(addr, wr, chunk, nw)) {
+			return false;
+		}
+		if (!wr) {
+			if (verify) {
+				if (memcmp(chunk, data, n)) {
+					if ((*diffs)++ < 3) {
+						printf("USB> wifi: verify: differs in the 64 bytes at 0x%05x\n", addr);
+					}
+				}
+			} else {
+				memcpy(data, chunk, n);
+			}
+		}
+		addr += n;
+		data += n;
+		len -= n;
+	}
+	return true;
+}
+
+static struct wf_core *
+wf_core(uint32_t id)
+{
+	for (uint32_t i = 0; i < wf_ncores; i++) {
+		if (wf_cores[i].id == id && wf_cores[i].base && wf_cores[i].wrap) {
+			return &wf_cores[i];
+		}
+	}
+	return NULL;
+}
+
+/* the backplane's enumeration ROM (aiutils.c ai_scan): each core's ID, revision, registers, wrapper */
+static void
+wf_erom(void)
+{
+	uint32_t p = wf_rd32(SI_ENUM_BASE + 0xfc);
+	struct wf_core *c = NULL;
+
+	wf_ncores = 0;
+	printf("USB> wifi: EROM at 0x%08x: %08x %08x %08x %08x\n", p, wf_rd32(p), wf_rd32(p + 4), wf_rd32(p + 8),
+	    wf_rd32(p + 12));
+	for (uint32_t i = 0; i < 256 && !wf_bad; i++) {
+		uint32_t e = wf_rd32(p);
+		p += 4;
+		if (e == 0xffffffffu) {
+			break;
+		}
+		if (!(e & 1)) {
+			continue;
+		}
+		if ((e & 0xe) == 0xe) {                 /* end */
+			break;
+		}
+		if ((e & 0x6) == 0) {                   /* component: CIA, then CIB */
+			uint32_t b = wf_rd32(p);
+			p += 4;
+			c = wf_ncores < 16 ? &wf_cores[wf_ncores++] : NULL;
+			if (c) {
+				c->id = (e >> 8) & 0xfff;
+				c->rev = b >> 24;
+				c->base = c->wrap = 0;
+			}
+		} else if ((e & 0xe) == 4) {            /* address descriptor */
+			if (e & 0x8) {
+				p += 4;                         /* upper 32 address bits */
+			}
+			if ((e & 0x30) == 0x30) {
+				uint32_t sz = wf_rd32(p);
+				p += 4;
+				if (sz & 0x8) {
+					p += 4;
+				}
+			}
+			uint32_t t = e & 0xc0, sp = (e >> 8) & 0xf, a = e & 0xfffff000u;
+			if (c) {
+				if (t == 0 && sp == 0 && !c->base) {
+					c->base = a;
+				}
+				if ((t == 0x80 || t == 0xc0) && !c->wrap) {
+					c->wrap = a;
+				}
+			}
+		}
+	}
+	for (uint32_t i = 0; i < wf_ncores; i++) {
+		printf("USB> wifi: core 0x%03x rev %u regs 0x%08x wrapper 0x%08x\n", wf_cores[i].id, wf_cores[i].rev,
+		    wf_cores[i].base, wf_cores[i].wrap);
+	}
+}
+
+static bool
+wf_core_up(struct wf_core *c)
+{
+	uint32_t io = wf_rd32(c->wrap + AI_IOCTRL), rc = wf_rd32(c->wrap + AI_RESETCTRL);
+	return (io & (SICF_FGC | SICF_CLOCK_EN)) == SICF_CLOCK_EN && !(rc & 1);
+}
+
+static void
+wf_core_disable(struct wf_core *c, uint32_t prereset, uint32_t reset)
+{
+	if (!(wf_rd32(c->wrap + AI_RESETCTRL) & 1)) {
+		wf_wr32(c->wrap + AI_IOCTRL, prereset | SICF_FGC | SICF_CLOCK_EN);
+		(void)wf_rd32(c->wrap + AI_IOCTRL);
+		wf_wr32(c->wrap + AI_RESETCTRL, 1);
+		delay(20);
+		for (uint32_t t = 0; t < 300 && !wf_bad && wf_rd32(c->wrap + AI_RESETCTRL) != 1; t++) {
+			delay(1);
+		}
+	}
+	wf_wr32(c->wrap + AI_IOCTRL, reset | SICF_FGC | SICF_CLOCK_EN);
+	(void)wf_rd32(c->wrap + AI_IOCTRL);
+}
+
+static void
+wf_core_reset(struct wf_core *c, uint32_t prereset, uint32_t reset, uint32_t postreset)
+{
+	wf_core_disable(c, prereset, reset);
+	for (uint32_t n = 0; n < 50 && !wf_bad && (wf_rd32(c->wrap + AI_RESETCTRL) & 1); n++) {
+		wf_wr32(c->wrap + AI_RESETCTRL, 0);
+		delay(50);
+	}
+	wf_wr32(c->wrap + AI_IOCTRL, postreset | SICF_CLOCK_EN);
+	(void)wf_rd32(c->wrap + AI_IOCTRL);
+}
+
+/* 0164: one line on a core's wrapper state */
+static void
+wf_core_show(const char *what, struct wf_core *c)
+{
+	printf("USB> wifi: %s: core 0x%03x ioctrl 0x%08x resetctrl 0x%08x resetstatus 0x%08x%s\n", what, c->id,
+	    wf_rd32(c->wrap + AI_IOCTRL), wf_rd32(c->wrap + AI_RESETCTRL), wf_rd32(c->wrap + AI_RESETSTATUS),
+	    wf_bad ? " (access failed)" : "");
+}
+
+/* a file of the root, whole, in memory of ours (as y2sios redwood_adsp.c root_file) */
+static uint8_t *
+wf_file(const char *path, uint32_t *size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	uint8_t *data;
+	int left = 0, error;
+
+	if (rootvnode == NULLVP || vnode_lookup(path, 0, &vp, ctx) != 0) {
+		printf("USB> wifi: %s: not found\n", path);
+		return NULL;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	if (vnode_getattr(vp, &va, ctx) != 0 || va.va_data_size == 0 || va.va_data_size > (1u << 20)) {
+		printf("USB> wifi: %s: no size, or too big\n", path);
+		vnode_put(vp);
+		return NULL;
+	}
+	data = kalloc_data((vm_size_t)va.va_data_size, Z_WAITOK);
+	if (data == NULL) {
+		vnode_put(vp);
+		return NULL;
+	}
+	error = vn_rdwr(UIO_READ, vp, (caddr_t)data, (int)va.va_data_size, 0, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(ctx), &left, vfs_context_proc(ctx));
+	vnode_put(vp);
+	if (error != 0 || left != 0) {
+		printf("USB> wifi: %s: read error %d, %d bytes left\n", path, error, left);
+		kfree_data(data, (vm_size_t)va.va_data_size);
+		return NULL;
+	}
+	*size = (uint32_t)va.va_data_size;
+	return data;
+}
+
+/*
+ * 0173: the board NVRAM has deadman_to=0xffffffff. The firmware's deadman counts backplane clocks
+ * (81.6 MHz): 2^32 of them are 52.6 s, then an NMI (TRAP 2, xnu56). Android's driver lets the chip
+ * sleep when idle, which stops that clock; here HT is forced, so the value is replaced.
+ * 'wifi dm HEX' sets it for the next fw, 'wifi dm keep' leaves the board's value.
+ */
+static uint32_t wf_dm_val = 0;
+static bool wf_dm_keep = false;
+
+/* NVRAM text to the chip's form: key=value lines, NUL-terminated, comments and blanks dropped, a final NUL */
+static uint32_t
+wf_nvram(const uint8_t *s, uint32_t n, uint8_t *out, uint32_t *count)
+{
+	uint32_t o = 0, i = 0, c = 0;
+
+	while (i < n) {
+		uint32_t a = i;
+		while (i < n && s[i] != '\n') {
+			i++;
+		}
+		uint32_t b = i++;
+		while (a < b && (s[a] == ' ' || s[a] == '\t' || s[a] == '\r')) {
+			a++;
+		}
+		while (b > a && (s[b - 1] == ' ' || s[b - 1] == '\t' || s[b - 1] == '\r')) {
+			b--;
+		}
+		bool eq = false;
+		for (uint32_t k = a; k < b && !eq; k++) {
+			eq = s[k] == '=';
+		}
+		if (a == b || s[a] == '#' || !eq) {
+			continue;
+		}
+		if (!wf_dm_keep && b - a >= 11 && !memcmp(s + a, "deadman_to=", 11)) {
+			char dm[24];
+			snprintf(dm, sizeof(dm), "deadman_to=0x%x", wf_dm_val);
+			uint32_t dl = (uint32_t)strlen(dm);
+			memcpy(out + o, dm, dl);
+			o += dl;
+			out[o++] = 0;
+			c++;
+			printf("USB> wifi: NVRAM: %s (the board's value replaced)\n", dm);
+			continue;
+		}
+		memcpy(out + o, s + a, b - a);
+		o += b - a;
+		out[o++] = 0;
+		c++;
+	}
+	out[o++] = 0;
+	*count = c;
+	return (o + 3) & ~3u;
+}
+
+/* the firmware's console ring (hndrte_cons_t: vcons_in, vcons_out, log {buf, buf_size, idx, out_idx}) */
+static void
+wf_console(uint32_t cons, uint32_t ramsize)
+{
+	uint32_t lg[4];
+	static uint8_t cbuf[2048];
+	char line[120];
+	uint32_t ln = 0;
+
+	if (!wf_mem(cons + 8, false, (uint8_t *)lg, sizeof(lg), false, NULL)) {
+		return;
+	}
+	uint32_t buf = lg[0], size = lg[1], idx = lg[2];
+	printf("USB> wifi: console at 0x%05x: log buf 0x%05x size %u idx %u\n", cons, buf, size, idx);
+	if (buf >= ramsize || size == 0 || size > sizeof(cbuf) || idx > size || (buf & 3)) {
+		return;
+	}
+	if (!wf_mem(buf, false, cbuf, (size + 3) & ~3u, false, NULL)) {
+		return;
+	}
+	/* oldest first: from idx to the end (if it ever wrapped), then from 0 to idx */
+	for (uint32_t k = 0; k < size; k++) {
+		uint8_t ch = cbuf[(idx + k) % size];
+		if (ch == '\n' || ch == 0 || ln == sizeof(line) - 1) {
+			if (ln) {
+				line[ln] = 0;
+				printf("USB> wifi: fw| %s\n", line);
+				ln = 0;
+			}
+			continue;
+		}
+		if (ch >= 0x20 && ch < 0x7f) {
+			line[ln++] = (char)ch;
+		}
+	}
+}
+
+static bool wf_bus4 = true;     /* 0166: 'wifi fw1' keeps the 1-bit bus */
+
+static void
+wf_fw(void)
+{
+	uint32_t fwlen = 0, nvlen = 0, nvars = 0, vlen = 0, vcap = 0;
+	uint8_t *fw = wf_file(WF_FW_PATH, &fwlen), *nv = wf_file(WF_NV_PATH, &nvlen), *vars = NULL;
+	uint64_t t0, t1;
+
+	if (!fw || !nv) {
+		goto out;
+	}
+	printf("USB> wifi: firmware %u bytes, NVRAM %u bytes\n", fwlen, nvlen);
+	for (uint32_t i = 0; i + 9 < fwlen; i++) {
+		if (!memcmp(fw + i, "Version: ", 9)) {
+			char v[48];
+			uint32_t k;
+			for (k = 0; k < sizeof(v) - 1 && i + 9 + k < fwlen && fw[i + 9 + k] >= 0x20 &&
+			    fw[i + 9 + k] < 0x7f; k++) {
+				v[k] = (char)fw[i + 9 + k];
+			}
+			v[k] = 0;
+			printf("USB> wifi: firmware says: Version: %s\n", v);
+			break;
+		}
+	}
+	vcap = nvlen + 16;
+	vars = kalloc_data(vcap, Z_WAITOK | Z_ZERO);
+	if (!vars) {
+		goto out;
+	}
+	vlen = wf_nvram(nv, nvlen, vars, &nvars);
+	printf("USB> wifi: NVRAM: %u variables, %u bytes for the chip\n", nvars, vlen);
+
+	if (!wf_bringup()) {
+		goto off;
+	}
+	/* 4-bit bus (CCCR bus interface control), then function 1's block size */
+	int bic = wf_rd8(0, 0x07);
+	if (!wf_bus4) {
+		printf("USB> wifi: 1-bit bus kept (CCCR 0x07 0x%02x, CTYPE %u)\n", bic, rd32(wf_mmc, M_CTYPE));
+	} else if (bic >= 0 && wf_wr8(0, 0x07, (uint8_t)((bic & ~3) | 2))) {
+		wr32(wf_mmc, M_CTYPE, 1);
+		printf("USB> wifi: 4-bit bus (CCCR 0x07 0x%02x -> 0x%02x)\n", bic, wf_rd8(0, 0x07));
+	}
+	if (wf_div != WF_CLKDIV_SLOW) {
+		/* 0169: faster card clock for the download (cclk_in / (2 * div)) */
+		wr32(wf_mmc, M_CLKENA, 0);
+		bool ck = wf_clk_update();
+		wr32(wf_mmc, M_CLKDIV, wf_div);
+		ck = ck && wf_clk_update();
+		wr32(wf_mmc, M_CLKENA, 1);
+		ck = ck && wf_clk_update();
+		printf("USB> wifi: CLKDIV %u -> %u (%s)\n", WF_CLKDIV_SLOW, rd32(wf_mmc, M_CLKDIV), ck ? "ok" : "update FAILED");
+	}
+	wf_wr8(0, 0x110, WF_CHUNK);
+	wf_wr8(0, 0x111, 0);
+	wf_bad = false;
+	wf_errs = 0;
+	uint32_t id = wf_rd32(SI_ENUM_BASE);
+	printf("USB> wifi: chipcommon ID by CMD53: 0x%08x (%s)\n", id, id == wf_chipid ? "same" : "DIFFERENT");
+	if (wf_bad || id != wf_chipid) {
+		goto off;
+	}
+	wf_erom();
+	struct wf_core *cm3 = wf_core(CORE_CM3), *sr = wf_core(CORE_SOCRAM), *sd = wf_core(CORE_SDIOD),
+	    *d11 = wf_core(CORE_D11);
+	if (wf_bad || !cm3 || !sr || !sd || !d11) {
+		printf("USB> wifi: ARM CM3 / SOCRAM / SDIO core not all found\n");
+		goto off;
+	}
+
+	/* download state: ARM disabled, SOCRAM reset, its size, bank 3 remap off, the top word cleared */
+	wf_core_show("before", cm3);
+	wf_core_show("before", d11);
+	wf_core_show("before", sr);
+	wf_core_disable(cm3, 0, 0);
+	wf_core_show("ARM disabled", cm3);
+	wf_core_reset(d11, 0x8u | 0x4u, 0x4u, 0x4u);  /* D11 PHYRESET | PHYCLOCKEN, then PHYCLOCKEN */
+	wf_core_show("D11 reset", d11);
+	wf_core_reset(sr, 0, 0, 0);
+	wf_core_show("SOCRAM reset", sr);
+	uint32_t ci = wf_rd32(sr->base + SR_COREINFO), nb = (ci >> 4) & 0xf, ramsize = 0;
+	for (uint32_t b = 0; b < nb; b++) {
+		wf_wr32(sr->base + SR_BANKIDX, b);
+		ramsize += 8192u * ((wf_rd32(sr->base + SR_BANKINFO) & 0x7f) + 1);
+	}
+	if ((wf_chipid & 0xffff) == 43430) {
+		wf_wr32(sr->base + SR_BANKIDX, 3);
+		wf_wr32(sr->base + SR_BANKPDA, 0);
+	}
+	printf("USB> wifi: download state: CM3 %s, SOCRAM %s, coreinfo 0x%08x, %u banks, RAM %u KiB\n",
+	    (wf_rd32(cm3->wrap + AI_RESETCTRL) & 1) ? "in reset" : "NOT in reset", wf_core_up(sr) ? "up" : "DOWN",
+	    ci, nb, ramsize / 1024);
+	if (wf_bad || ramsize < 0x20000 || ramsize > 0x100000 || fwlen > ramsize - vlen - 8) {
+		goto off;
+	}
+	wf_wr32(ramsize - 4, 0);
+
+	/* the image at 0, then read back */
+	uint32_t diffs = 0;
+	t0 = mach_absolute_time();
+	if (!wf_mem(0, true, fw, fwlen, false, NULL)) {
+		goto off;
+	}
+	t1 = mach_absolute_time();
+	uint64_t ns;
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	printf("USB> wifi: firmware written in %llu ms (%llu KiB/s)\n", ns / 1000000,
+	    ns ? (uint64_t)fwlen * 1000000000ull / ns / 1024 : 0);
+	if (!wf_mem(0, false, fw, fwlen, true, &diffs)) {
+		goto off;
+	}
+	printf("USB> wifi: firmware read back: %s (%u differing pieces)\n", diffs ? "DIFFERS" : "same", diffs);
+	if (diffs) {
+		goto off;
+	}
+
+	/* the variables under the top word, as dhdsdio_write_vars, and the length token in it */
+	uint32_t varsize = vlen, varaddr = ramsize - 4 - varsize;
+	if (sd->rev == 7 && (varaddr & 0x3c) == 0x3c && varsize > 4) {
+		varsize += 4;
+		varaddr -= 4;
+	}
+	if (!wf_mem(varaddr, true, vars, varsize, false, NULL) ||
+	    !wf_mem(varaddr, false, vars, varsize, true, &diffs) || diffs) {
+		printf("USB> wifi: NVRAM write/read-back failed (%u differing)\n", diffs);
+		goto off;
+	}
+	uint32_t w = ((ramsize - 4) - varaddr) / 4, token = (~w << 16) | (w & 0xffff);
+	wf_wr32(ramsize - 4, token);
+	printf("USB> wifi: NVRAM at 0x%05x (%u bytes), token 0x%08x\n", varaddr, varsize, token);
+
+	/* out of download state: SDIO-core interrupts cleared, ARM out of reset */
+	if (!wf_core_up(sr)) {
+		printf("USB> wifi: SOCRAM down after the download?\n");
+		goto off;
+	}
+	wf_wr32(sd->base + SD_INTSTATUS, 0xffffffffu);
+	wf_core_reset(cm3, 0, 0, 0);
+	printf("USB> wifi: ARM released (%s)\n", wf_core_up(cm3) ? "up" : "NOT up");
+	if (wf_bad) {
+		goto off;
+	}
+
+	/* HT clock (dhdsdio_htclk) */
+	wf_wr8(1, SB_CHIPCLKCSR, CLK_HT_REQ);
+	int clk = 0;
+	for (int t = 0; t < 500 && !(clk & CLK_HT_AVAIL); t++) {
+		clk = wf_rd8(1, SB_CHIPCLKCSR);
+		if (clk < 0) {
+			clk = 0;
+		}
+		delay(1000);
+	}
+	printf("USB> wifi: HT clock %s (CHIPCLKCSR 0x%02x)\n", (clk & CLK_HT_AVAIL) ? "available" : "NOT available", clk);
+	if (!(clk & CLK_HT_AVAIL)) {
+		goto off;
+	}
+
+	/* function 2 (dhdsdio_bus_init): HT forced, the protocol version to the dongle, F1|F2 on, IOR2 */
+	wf_wr8(1, SB_CHIPCLKCSR, (uint8_t)(clk | CLK_FORCE_HT));
+	wf_wr32(sd->base + SD_TOSBMAILBOXDATA, 4u << 16);
+	wf_wr8(0, 0x02, 0x06);
+	int ready = 0;
+	t0 = mach_absolute_time();
+	for (int t = 0; t < 300 && ready != 0x06; t++) {
+		ready = wf_rd8(0, 0x03);
+		if (ready < 0) {
+			ready = 0;
+		}
+		if (ready != 0x06) {
+			delay(10000);
+		}
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("USB> wifi: function 2 %s (IORx 0x%02x after %llu ms)\n", ready == 0x06 ? "ready" : "NOT ready", ready,
+	    ns / 1000000);
+	if (ready == 0x06 && sd->rev < 15) {
+		wf_wr8(1, SB_WATERMARK, 8);
+	}
+
+	/* the firmware's word at the end of RAM: its sdpcm_shared */
+	uint32_t sh = token;
+	for (int t = 0; t < 200; t++) {
+		sh = wf_rd32(ramsize - 4);
+		if (sh != token && sh < ramsize && !(sh & 3)) {
+			break;
+		}
+		delay(10000);
+	}
+	if (sh == token || sh >= ramsize || (sh & 3)) {
+		printf("USB> wifi: no sdpcm_shared (top word 0x%08x)\n", sh);
+		goto off;
+	}
+	uint32_t s[8];
+	if (!wf_mem(sh, false, (uint8_t *)s, sizeof(s), false, NULL)) {
+		goto off;
+	}
+	printf("USB> wifi: firmware RUNNING: sdpcm_shared at 0x%05x: version %u flags 0x%x trap 0x%x assert line %u "
+	    "console 0x%x fwid 0x%08x\n", sh, s[0] & 0xff, s[0], s[1], s[4], s[5], s[7]);
+	if (s[0] & 0x400) {
+		printf("USB> wifi: the firmware TRAPPED (trap record at 0x%x)\n", s[1]);
+	}
+	if (s[5] && s[5] < ramsize) {
+		wf_console(s[5], ramsize);
+	}
+	wf_fw_cons = (s[5] && s[5] < ramsize) ? s[5] : 0;
+	wf_fw_ram = ramsize;
+	wf_fwup = true;
+	wf_w4init = false;
+	printf("USB> wifi: W3 done; left powered with the firmware running (wifi off turns it off)\n");
+	goto out;
+
+off:
+	printf("USB> wifi: firmware step stopped%s; left powered for 'wifi rd' ('wifi off' turns it off)\n",
+	    wf_bad ? " (a backplane access failed)" : "");
+	wf_bad = false;
+out:
+	if (vars) {
+		kfree_data(vars, vcap);
+	}
+	if (fw) {
+		kfree_data(fw, fwlen);
+	}
+	if (nv) {
+		kfree_data(nv, nvlen);
+	}
+}
+
+/* 0162: a hex number of the command line; *ok false if there was none */
+static uint32_t
+wf_hex(const char **pp, bool *ok)
+{
+	const char *p = *pp;
+	uint32_t v = 0, n = 0;
+
+	while (*p == ' ') {
+		p++;
+	}
+	if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
+		p += 2;
+	}
+	for (;; p++, n++) {
+		char c = *p;
+		uint32_t d;
+		if (c >= '0' && c <= '9') {
+			d = (uint32_t)(c - '0');
+		} else if (c >= 'a' && c <= 'f') {
+			d = (uint32_t)(c - 'a' + 10);
+		} else if (c >= 'A' && c <= 'F') {
+			d = (uint32_t)(c - 'A' + 10);
+		} else {
+			break;
+		}
+		v = (v << 4) | d;
+	}
+	*ok = n > 0;
+	*pp = p;
+	return v;
+}
+
+/* 0162: 'wifi rd ADDR [N]': N (hex, <= 0x40) words of the backplane; 'wifi cr FN ADDR': one CMD52 read */
+static void
+wf_rd_cmd(const char *a, bool c52)
+{
+	bool ok1, ok2;
+	uint32_t x = wf_hex(&a, &ok1), y = wf_hex(&a, &ok2);
+
+	if (!wf_chipid || !wf_mmc) {
+		printf("USB> wifi: not powered (wifi probe keep, or a stopped wifi fw, first)\n");
+		return;
+	}
+	if (c52) {
+		if (!ok1 || !ok2) {
+			printf("USB> wifi: cr FN ADDR\n");
+			return;
+		}
+		int v = wf_rd8(x & 7, y);
+		printf("USB> wifi: CMD52 fn %u 0x%05x = %d (0x%02x) err 0x%08x R5 0x%08x\n", x & 7, y & 0x1ffff, v,
+		    v & 0xff, wf_last_e, wf_last_r);
+		return;
+	}
+	if (!ok1) {
+		printf("USB> wifi: rd ADDR [N]\n");
+		return;
+	}
+	uint32_t n = ok2 ? y : 1;
+	if (n == 0 || n > 0x40) {
+		n = 1;
+	}
+	x &= ~3u;
+	wf_bad = false;
+	for (uint32_t i = 0; i < n && !wf_bad; i += 4) {
+		uint32_t v[4] = { 0, 0, 0, 0 };
+		for (uint32_t k = 0; k < 4 && i + k < n; k++) {
+			v[k] = wf_rd32(x + 4 * (i + k));
+		}
+		printf("USB> wifi: 0x%08x: %08x %08x %08x %08x%s\n", x + 4 * i, v[0], v[1], v[2], v[3],
+		    wf_bad ? " (a read failed)" : "");
+	}
+	wf_bad = false;
+}
+
+/* 0166: 'wifi wr ADDR VAL': one 32-bit backplane write (CMD53), then the word read back */
+static void
+wf_wr_cmd(const char *a)
+{
+	bool ok1, ok2;
+	uint32_t x = wf_hex(&a, &ok1), v = wf_hex(&a, &ok2);
+
+	if (!wf_chipid || !wf_mmc) {
+		printf("USB> wifi: not powered (wifi probe keep, or a stopped wifi fw, first)\n");
+		return;
+	}
+	if (!ok1 || !ok2) {
+		printf("USB> wifi: wr ADDR VAL\n");
+		return;
+	}
+	x &= ~3u;
+	wf_bad = false;
+	wf_errs = 0;
+	uint32_t before = wf_rd32(x);
+	bool rb = !wf_bad;
+	wf_wr32(x, v);
+	bool wok = !wf_bad;
+	wf_bad = false;
+	uint32_t after = wf_rd32(x);
+	printf("USB> wifi: wr 0x%08x = 0x%08x: before 0x%08x%s, write %s, after 0x%08x%s (bus %u-bit)\n", x, v, before,
+	    rb ? "" : " (read failed)", wok ? "ok" : "FAILED", after, wf_bad ? " (read failed)" : "",
+	    rd32(wf_mmc, M_CTYPE) ? 4 : 1);
+	wf_bad = false;
+}
+
+/*
+ * ---- W4 (0170): SDPCM frames on function 2, BCDC control messages, escan ----
+ * After Linux brcmfmac (sdio.c brcmf_sdio_readframes / brcmf_sdio_bus_txctl, bcdc.c, fwil.c, cfg80211.c escan).
+ * Frames: hw header (len, ~len), sw header (seq | chan << 8 | doffset << 24, then tx window << 8),
+ * then the payload at doffset. Channel 0 = control (BCDC), 1 = events, 2 = data. Polled, no SDIO interrupt.
+ */
+#define SD_HOSTINTMASK          0x24u
+#define SD_TOSBMAILBOX          0x40u
+#define SD_TOHOSTMAILBOXDATA    0x4cu
+#define I_HMB_FRAME_IND         (1u << 6)
+#define I_HMB_HOST_INT          (1u << 7)
+#define WF_F2ADDR               ((0x18000000u & SB_OFT_MASK) | SB_ACCESS_4B)
+#define WF_RXMAX                24576u         /* 0177: rx superframes (xnu61: 9248 bytes) */
+#define WLC_UP                  2u
+#define WLC_GET_VAR             262u
+#define WLC_SET_VAR             263u
+
+static uint8_t wf_txseq, wf_txmax = 4;
+static uint16_t wf_reqid;
+static uint32_t wf_rxbuf[WF_RXMAX / 4];
+static uint32_t wf_rxlen;
+static uint8_t wf_ctl[1600];            /* the last control response's payload */
+static uint32_t wf_ctl_len;
+static int wf_ctl_status;
+static uint16_t wf_ctl_id;
+static bool wf_ctl_got;
+static uint32_t wf_events, wf_scan_n, wf_scan_done;
+static uint8_t wf_seen[32][6];
+
+static struct wf_core *
+wf_sd(void)
+{
+	return wf_core(CORE_SDIOD);
+}
+
+static bool
+wf_w4_ready(void)
+{
+	if (!wf_fwup || !wf_chipid || !wf_mmc || !wf_sd()) {
+		printf("USB> wifi: the firmware is not running ('wifi fw' first)\n");
+		return false;
+	}
+	wf_bad = false;
+	wf_errs = 0;
+	if (!wf_w4init) {
+		/* function 2 block size 512 (FBR 0x210), host interrupt mask for the mailbox/frame bits */
+		(void)wf_wr8(0, 0x210, 0x00);
+		(void)wf_wr8(0, 0x211, 0x02);
+		wf_wr32(wf_sd()->base + SD_HOSTINTMASK, 0xf0u);
+		wf_txseq = 0;
+		wf_w4init = true;
+		printf("USB> wifi: W4: F2 block size %u, hostintmask 0x%08x, intstatus 0x%08x\n",
+		    (uint32_t)wf_rd8(0, 0x210) | ((uint32_t)wf_rd8(0, 0x211) << 8),
+		    wf_rd32(wf_sd()->base + SD_HOSTINTMASK), wf_rd32(wf_sd()->base + SD_INTSTATUS));
+	}
+	return !wf_bad;
+}
+
+static bool
+wf_sdpcm_send(uint32_t chan, const uint8_t *pl, uint32_t len)
+{
+	static uint32_t tx[(12 + 4 + 1518 + 3) / 4 + 1];        /* 0175: a whole ethernet frame */
+	uint32_t total = 12 + len, n = (total + 3) & ~3u;
+
+	if (n > sizeof(tx)) {
+		return false;
+	}
+	bzero(tx, n);
+	tx[0] = (total & 0xffff) | ((~total & 0xffffu) << 16);
+	tx[1] = wf_txseq | (chan << 8) | (12u << 24);
+	tx[2] = 0;
+	memcpy((uint8_t *)tx + 12, pl, len);
+	if (!wf_setwin(0x18000000u)) {
+		return false;
+	}
+	for (uint32_t o = 0; o < n; o += 512) {
+		/* 0175: byte mode carries at most 512 bytes; F2 takes a frame over several CMD53s (Linux
+		 * sdio_io_rw_ext_helper splits the same way) */
+		if (!wf_cmd53_once(2, WF_F2ADDR, true, tx + o / 4, n - o < 512 ? n - o : 512, false)) {
+			return false;
+		}
+	}
+	wf_txseq++;
+	return true;
+}
+
+/* one frame into wf_rxbuf: 1 = got one (wf_rxlen), 0 = none, -1 = error */
+static int
+wf_sdpcm_recv(void)
+{
+	static uint32_t junk[128];
+
+	if (!wf_setwin(0x18000000u) || !wf_cmd53_once(2, WF_F2ADDR, false, wf_rxbuf, 64, false)) {
+		return -1;
+	}
+	uint32_t len = wf_rxbuf[0] & 0xffff, chk = wf_rxbuf[0] >> 16;
+	if (len == 0 && chk == 0) {
+		return 0;
+	}
+	if ((len ^ chk) != 0xffffu || len < 12) {
+		printf("USB> wifi: rx: bad frame header 0x%08x\n", wf_rxbuf[0]);
+		return -1;
+	}
+	uint32_t got = 64;
+	while (got < len) {
+		uint32_t k = (len - got + 3) & ~3u;
+		if (k > 512) {
+			k = 512;
+		}
+		uint32_t *dst = (got + k <= WF_RXMAX) ? wf_rxbuf + got / 4 : junk;
+		if (!wf_cmd53_once(2, WF_F2ADDR, false, dst, k, false)) {
+			return -1;
+		}
+		got += k;
+	}
+	if (len > WF_RXMAX) {
+		printf("USB> wifi: rx: frame of %u bytes dropped (buffer %u)\n", len, WF_RXMAX);
+		return 0;
+	}
+	wf_rxlen = len;
+	uint8_t win = (uint8_t)((wf_rxbuf[2] >> 8) & 0xff);
+	if ((uint8_t)(win - wf_txseq) <= 0x40) {
+		wf_txmax = win;
+	}
+	return 1;
+}
+
+static void wf_event(const uint8_t *eth, uint32_t len);
+static void wf_eapol(const uint8_t *e, uint32_t len);
+static void wf_net_rx(const uint8_t *e, uint32_t len);
+/* 0179: Apple80211 (wifid): what a scan heard, the network joined, the link, the requests */
+static void wf_a8_bss(const uint8_t *b, uint32_t blen);
+static void wf_a8_scan_start(void);
+static void wf_a8_scan_over(void);
+static void wf_a8_joined(const uint8_t *ssid, int sl, bool sec);
+static void wf_a8_link(bool up);
+static errno_t wf_a8_ioctl(unsigned long cmd, void *data);
+static bool wf_scan_loud = true;        /* 'wifi scan' prints every network; wifid's scans do not */
+static uint32_t wf_j_why;               /* the last join that failed, as Apple80211's result: 21 key, 9 timeout, 2 */
+static bool wf_net_event(uint32_t type, uint32_t status, uint32_t reason, uint32_t flags);
+static uint64_t wf_rxn;
+static void wf_glom_frame(uint8_t *f, uint32_t flen, uint32_t doff);
+
+/* one SDPCM frame (wf_rxbuf, or a subframe of a superframe): a control response is kept, events and data handed on */
+static void
+wf_frame_at(uint8_t *f, uint32_t flen)
+{
+	uint32_t chan = f[5] & 0xfu, doff = f[7];
+
+	wf_rxn++;
+
+	if (doff < 12 || doff > flen) {
+		printf("USB> wifi: rx: chan %u doffset %u of %u?\n", chan, doff, flen);
+		return;
+	}
+	uint8_t *pl = f + doff;
+	uint32_t plen = flen - doff;
+	if (chan == 0) {
+		if (plen < 16) {
+			return;
+		}
+		uint32_t h[4];
+		memcpy(h, pl, 16);
+		wf_ctl_id = (uint16_t)(h[2] >> 16);
+		wf_ctl_status = (h[2] & 1) ? (int)h[3] : 0;
+		wf_ctl_len = plen - 16 < sizeof(wf_ctl) ? plen - 16 : (uint32_t)sizeof(wf_ctl);
+		memcpy(wf_ctl, pl + 16, wf_ctl_len);
+		wf_ctl_got = true;
+	} else if (chan == 1 || chan == 2) {
+		/* BDC header: flags, priority, flags2, data offset in words; then the ethernet frame */
+		if (plen < 4 || 4u + pl[3] * 4u > plen) {
+			return;
+		}
+		uint32_t o = 4u + pl[3] * 4u;
+		if (chan == 1) {
+			wf_event(pl + o, plen - o);
+		} else if (plen - o >= 14 && pl[o + 12] == 0x88 && pl[o + 13] == 0x8e) {
+			wf_eapol(pl + o, plen - o);     /* 0174: EAPOL, for the host's handshake */
+		} else {
+			wf_net_rx(pl + o, plen - o);    /* 0175: data, to en0 */
+		}
+	} else if (chan == 3 && f == (uint8_t *)wf_rxbuf) {
+		wf_glom_frame(f, flen, doff);   /* 0177: a superframe or its descriptor */
+	} else {
+		printf("USB> wifi: rx: frame on channel %u (%u bytes): %02x %02x %02x %02x %02x %02x %02x %02x\n", chan,
+		    flen, pl[0], pl[1], pl[2], pl[3], pl[4], pl[5], pl[6], pl[7]);
+	}
+}
+
+/*
+ * 0177: rx superframes (glom). The firmware sends them though bus:rxglom is 0 (xnu61): first a descriptor
+ * on channel 3 (after its header, the subframes' lengths as 16-bit words), then the superframe, whose length
+ * is their sum. Subframe i takes its length's bytes from the running offset; the first one starts with the
+ * superframe's own header (channel 3), its SDPCM header at that header's data offset. Each subframe is an
+ * ordinary SDPCM frame (brcmfmac brcmf_sdio_rxglom).
+ */
+static uint16_t wf_glom[64];
+static uint32_t wf_glom_n, wf_glom_sum, wf_glom_bad;
+static uint64_t wf_glom_frames, wf_glom_subs;
+static void wf_frame_at(uint8_t *f, uint32_t flen);
+
+static void
+wf_glom_frame(uint8_t *f, uint32_t flen, uint32_t doff)
+{
+	if (wf_glom_n && flen == wf_glom_sum) {
+		uint32_t off = 0;
+		wf_glom_frames++;
+		for (uint32_t i = 0; i < wf_glom_n; off += wf_glom[i], i++) {
+			uint32_t sl = wf_glom[i], hs = i == 0 ? doff : 0;
+			if (off + sl > flen || hs + 12 > sl) {
+				break;
+			}
+			uint8_t *h = f + off + hs;
+			uint32_t len = (uint32_t)h[0] | (uint32_t)h[1] << 8, chk = (uint32_t)h[2] | (uint32_t)h[3] << 8;
+			if ((len ^ chk) != 0xffffu || len < 12 || len > sl - hs || (h[5] & 0xfu) == 3) {
+				if (wf_glom_bad++ < 10) {
+					printf("USB> wifi: rx glom: subframe %u/%u at %u (+%u) of %u: bad header %02x %02x %02x %02x %02x %02x %02x %02x\n",
+					    i, wf_glom_n, off, hs, flen, h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]);
+				}
+				continue;
+			}
+			uint8_t win = h[9];
+			if ((uint8_t)(win - wf_txseq) <= 0x40) {
+				wf_txmax = win;
+			}
+			wf_glom_subs++;
+			wf_frame_at(h, len);
+		}
+		wf_glom_n = 0;
+		return;
+	}
+	if (wf_glom_n) {
+		if (wf_glom_bad++ < 10) {
+			printf("USB> wifi: rx glom: frame of %u bytes, the descriptor said %u\n", flen, wf_glom_sum);
+		}
+		wf_glom_n = 0;
+	}
+	uint32_t sum = 0, k = 0;
+	for (uint32_t o = doff; o + 2 <= flen && k < 64; o += 2) {
+		uint32_t v = (uint32_t)f[o] | (uint32_t)f[o + 1] << 8;
+		if (!v) {
+			break;
+		}
+		wf_glom[k++] = (uint16_t)v;
+		sum += v;
+	}
+	wf_glom_n = k;
+	wf_glom_sum = sum;
+}
+
+static void
+wf_frame(void)
+{
+	wf_frame_at((uint8_t *)wf_rxbuf, wf_rxlen);
+}
+
+/* what the dongle flagged: mailbox data acked, frames read until it has none */
+static void
+wf_poll(void)
+{
+	uint32_t base = wf_sd()->base, st = wf_rd32(base + SD_INTSTATUS);
+
+	if (wf_bad || !st) {
+		return;
+	}
+	wf_wr32(base + SD_INTSTATUS, st);
+	if (st & I_HMB_HOST_INT) {
+		uint32_t mb = wf_rd32(base + SD_TOHOSTMAILBOXDATA);
+		wf_wr32(base + SD_TOSBMAILBOX, 1u << 1);        /* SMB_INT_ACK */
+		printf("USB> wifi: mailbox from the dongle: 0x%08x\n", mb);
+	}
+	if (st & I_HMB_FRAME_IND) {
+		for (int k = 0; k < 64; k++) {
+			if (wf_sdpcm_recv() <= 0) {
+				break;
+			}
+			wf_frame();
+		}
+	}
+}
+
+/* one BCDC request; the answer's payload is left in wf_ctl. Returns the firmware's status, or -999 */
+static int
+wf_dcmd(uint32_t cmd, bool set, const uint8_t *data, uint32_t len)
+{
+	static uint8_t m[16 + 400];
+
+	if (len > sizeof(m) - 16) {
+		return -999;
+	}
+	uint16_t id = ++wf_reqid;
+	uint32_t h[4] = { cmd, len, ((uint32_t)id << 16) | (set ? 2u : 0u), 0 };
+	memcpy(m, h, 16);
+	memcpy(m + 16, data, len);
+	wf_ctl_got = false;
+	if (!wf_sdpcm_send(0, m, 16 + len)) {
+		printf("USB> wifi: dcmd %u: send failed\n", cmd);
+		return -999;
+	}
+	for (int t = 0; t < 1000 && !wf_bad; t++) {
+		wf_poll();
+		if (wf_ctl_got && wf_ctl_id == id) {
+			return wf_ctl_status;
+		}
+		delay(2000);
+	}
+	printf("USB> wifi: dcmd %u: no answer (id %u, last id %u, txseq %u window %u)\n", cmd, id, wf_ctl_id, wf_txseq,
+	    wf_txmax);
+	return -999;
+}
+
+/* iovar get: name, then room for the answer */
+static int
+wf_iovar_get(const char *name, uint32_t room)
+{
+	static uint8_t b[400];
+	uint32_t nl = (uint32_t)strlen(name) + 1;
+
+	if (room < nl) {
+		room = nl;
+	}
+	if (room > sizeof(b)) {
+		room = sizeof(b);
+	}
+	bzero(b, room);
+	memcpy(b, name, nl);
+	return wf_dcmd(WLC_GET_VAR, false, b, room);
+}
+
+static int
+wf_iovar_set(const char *name, const void *v, uint32_t vlen)
+{
+	static uint8_t b[400];
+	uint32_t nl = (uint32_t)strlen(name) + 1;
+
+	if (nl + vlen > sizeof(b)) {
+		return -999;
+	}
+	memcpy(b, name, nl);
+	memcpy(b + nl, v, vlen);
+	return wf_dcmd(WLC_SET_VAR, true, b, nl + vlen);
+}
+
+static void
+wf_ver_cmd(void)
+{
+	if (!wf_w4_ready()) {
+		return;
+	}
+	int st = wf_iovar_get("ver", 256);
+	if (st) {
+		printf("USB> wifi: ver: status %d\n", st);
+		return;
+	}
+	char v[120];
+	uint32_t k = 0;
+	for (; k < wf_ctl_len && k < sizeof(v) - 1 && wf_ctl[k]; k++) {
+		v[k] = (wf_ctl[k] >= 0x20 && wf_ctl[k] < 0x7f) ? (char)wf_ctl[k] : ' ';
+	}
+	v[k] = 0;
+	printf("USB> wifi: BCDC works: ver = \"%s\"\n", v);
+}
+
+static void
+wf_mac_cmd(void)
+{
+	if (!wf_w4_ready()) {
+		return;
+	}
+	int st = wf_iovar_get("cur_etheraddr", 8);
+	if (st || wf_ctl_len < 6) {
+		printf("USB> wifi: cur_etheraddr: status %d (%u bytes)\n", st, wf_ctl_len);
+		return;
+	}
+	printf("USB> wifi: MAC %02x:%02x:%02x:%02x:%02x:%02x\n", wf_ctl[0], wf_ctl[1], wf_ctl[2], wf_ctl[3], wf_ctl[4],
+	    wf_ctl[5]);
+}
+
+static uint32_t
+wf_be32(const uint8_t *p)
+{
+	return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+
+/*
+ * ---- W5 (0172): joining a network with the firmware's own supplicant ----
+ * After brcmfmac cfg80211.c brcmf_cfg80211_connect / brcmf_set_pmk (firmware PSK supplicant, "sup_wpa").
+ * Events seen during a join are told by name; LINK (flags bit 0) and PSK_SUP keyed (status 6) end it.
+ */
+static bool wf_joining;
+static uint32_t wf_j_link, wf_j_keyed, wf_j_fail, wf_j_ssid;
+
+static const char *
+wf_evname(uint32_t t)
+{
+	switch (t) {
+	case 0: return "SET_SSID";
+	case 1: return "JOIN";
+	case 3: return "AUTH";
+	case 5: return "DEAUTH";
+	case 6: return "DEAUTH_IND";
+	case 7: return "ASSOC";
+	case 9: return "REASSOC";
+	case 11: return "DISASSOC";
+	case 12: return "DISASSOC_IND";
+	case 16: return "LINK";
+	case 46: return "PSK_SUP";
+	case 54: return "IF";
+	default: return "event";
+	}
+}
+
+static void
+wf_join_event(uint32_t type, uint32_t status, uint32_t reason, uint32_t flags)
+{
+	printf("USB> wifi: JOIN event %s (%u) status %u reason %u flags 0x%x\n", wf_evname(type), type, status, reason,
+	    flags);
+	if (type == 0) {
+		wf_j_ssid = status + 1;
+		if (status != 0) {
+			wf_j_fail = 1;
+		}
+	} else if (type == 16) {
+		if (flags & 1) {
+			wf_j_link = 1;
+		} else {
+			wf_j_link = 0;
+			wf_j_fail = 2;
+		}
+	} else if (type == 46) {
+		if (status == 6) {              /* WLC_SUP_KEYED */
+			wf_j_keyed = 1;
+		} else if (status != 0 && status != 4 && status != 5) {
+			wf_j_fail = 3;
+		}
+	} else if (type == 6 || type == 12 || (type == 3 && status != 0)) {
+		wf_j_fail = 4;
+	}
+}
+
+/* a Broadcom event (ethertype 0x886c): escan results printed, the rest told briefly */
+static void
+wf_event(const uint8_t *e, uint32_t len)
+{
+	if (len < 72 || e[12] != 0x88 || e[13] != 0x6c) {
+		return;
+	}
+	const uint8_t *m = e + 24;              /* after the ethernet (14) and bcmeth (10) headers */
+	uint32_t type = wf_be32(m + 4), status = wf_be32(m + 8), dlen = wf_be32(m + 20);
+	const uint8_t *d = m + 48;
+	wf_events++;
+	if (wf_joining && type != 69) {         /* 0172: a join's events, by name */
+		wf_join_event(type, status, wf_be32(m + 12), (uint32_t)m[2] << 8 | m[3]);
+		return;
+	}
+	if (type != 69 && wf_net_event(type, status, wf_be32(m + 12), (uint32_t)m[2] << 8 | m[3])) {
+		return;                         /* 0175: link changes after the join */
+	}
+	if (type != 69) {                       /* WLC_E_ESCAN_RESULT */
+		if (wf_events < 20) {
+			printf("USB> wifi: event %u status %u (%u bytes)\n", type, status, dlen);
+		}
+		return;
+	}
+	if (status != 8) {                      /* not PARTIAL: the scan is over */
+		wf_scan_done = status + 1;
+		return;
+	}
+	if (dlen < 12 + 80 || 72 + dlen > len) {
+		return;
+	}
+	const uint8_t *b = d + 12;              /* escan_result: buflen, version, sync_id, bss_count; then bss_info */
+	const uint8_t *bssid = b + 8;
+	wf_a8_bss(b, dlen - 12);                /* 0179 */
+	for (uint32_t i = 0; i < wf_scan_n && i < 32; i++) {
+		if (!memcmp(wf_seen[i], bssid, 6)) {
+			return;
+		}
+	}
+	if (wf_scan_n < 32) {
+		memcpy(wf_seen[wf_scan_n], bssid, 6);
+	}
+	wf_scan_n++;
+	if (!wf_scan_loud) {
+		return;
+	}
+	char ssid[33];
+	uint32_t sl = b[18] > 32 ? 32 : b[18];
+	for (uint32_t k = 0; k < sl; k++) {
+		ssid[k] = (b[19 + k] >= 0x20 && b[19 + k] < 0x7f) ? (char)b[19 + k] : '?';
+	}
+	ssid[sl] = 0;
+	uint32_t chanspec = (uint32_t)b[72] | ((uint32_t)b[73] << 8);    /* 0171: struct is not packed */
+	int rssi = (int16_t)(b[78] | (b[79] << 8));
+	printf("USB> wifi: AP %02x:%02x:%02x:%02x:%02x:%02x ch %u rssi %d \"%s\"\n", bssid[0], bssid[1], bssid[2],
+	    bssid[3], bssid[4], bssid[5], chanspec & 0xff, rssi, ssid);
+}
+
+static void
+wf_scan_cmd(void)
+{
+	if (!wf_w4_ready()) {
+		return;
+	}
+	static const uint8_t zero4[4] = { 0, 0, 0, 0 };
+	int st = wf_dcmd(WLC_UP, true, zero4, 4);
+	if (wf_scan_loud || st) {
+		printf("USB> wifi: WLC_UP: status %d\n", st);
+	}
+	if (st == -999) {
+		return;
+	}
+	/* event_msgs: ESCAN_RESULT (69) on */
+	st = wf_iovar_get("event_msgs", 16);
+	if (st == 0 && wf_ctl_len >= 16) {
+		uint8_t mask[16];
+		memcpy(mask, wf_ctl, 16);
+		mask[69 / 8] |= (uint8_t)(1u << (69 % 8));
+		st = wf_iovar_set("event_msgs", mask, 16);
+	}
+	if (wf_scan_loud || st) {
+		printf("USB> wifi: event_msgs: status %d\n", st);
+	}
+	/* escan_params: version 1, action START, sync id; scan_params: any SSID/BSSID/BSS type, all channels */
+	uint8_t ep[76];
+	bzero(ep, sizeof(ep));
+	ep[0] = 1;
+	ep[4] = 1;
+	ep[6] = 0x34;
+	ep[7] = 0x12;
+	memset(ep + 8 + 36, 0xff, 6);
+	ep[8 + 42] = 2;
+	ep[8 + 43] = 0;
+	memset(ep + 8 + 44, 0xff, 16);          /* nprobes, active, passive, home time: -1 (defaults) */
+	ep[8 + 48] = 80;                        /* 0183: active 80 ms a channel (the default ~30 heard few) */
+	ep[8 + 49] = ep[8 + 50] = ep[8 + 51] = 0;
+	wf_events = 0;
+	wf_scan_n = 0;
+	wf_scan_done = 0;
+	wf_a8_scan_start();
+	st = wf_iovar_set("escan", ep, sizeof(ep));
+	if (wf_scan_loud || st) {
+		printf("USB> wifi: escan: status %d\n", st);
+	}
+	if (st) {
+		return;
+	}
+	uint64_t t0 = mach_absolute_time(), ns = 0;
+	for (int t = 0; t < 6000 && !wf_scan_done && !wf_bad; t++) {
+		wf_poll();
+		delay(2000);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("USB> wifi: scan %s after %llu ms: %u networks, %u events%s\n", wf_scan_done ? "done" : "NOT done",
+	    ns / 1000000, wf_scan_n, wf_events, wf_bad ? " (a bus access failed)" : "");
+	wf_a8_scan_over();
+}
+
+/*
+ * ---- 0174: WPA2-PSK in the host (this firmware has no supplicant: sup_wpa -23, xnu57) ----
+ * SHA-1, HMAC-SHA1, PBKDF2 (the PMK), the 802.11 PRF (the PTK), AES-128 decryption and the RFC 3394
+ * key unwrap (the GTK). Self-contained: nothing here needs corecrypto.
+ */
+typedef struct {
+	uint32_t h[5];
+	uint64_t n;
+	uint8_t b[64];
+	uint32_t bl;
+} wf_sha1_t;
+
+static uint32_t
+wf_rol(uint32_t x, int k)
+{
+	return (x << k) | (x >> (32 - k));
+}
+
+static void
+wf_sha1_blk(uint32_t *h, const uint8_t *p)
+{
+	uint32_t w[80], a = h[0], b = h[1], c = h[2], d = h[3], e = h[4];
+
+	for (int i = 0; i < 16; i++) {
+		w[i] = (uint32_t)p[4 * i] << 24 | (uint32_t)p[4 * i + 1] << 16 | (uint32_t)p[4 * i + 2] << 8 | p[4 * i + 3];
+	}
+	for (int i = 16; i < 80; i++) {
+		w[i] = wf_rol(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
+	}
+	for (int i = 0; i < 80; i++) {
+		uint32_t f, k;
+		if (i < 20) {
+			f = (b & c) | (~b & d);
+			k = 0x5a827999u;
+		} else if (i < 40) {
+			f = b ^ c ^ d;
+			k = 0x6ed9eba1u;
+		} else if (i < 60) {
+			f = (b & c) | (b & d) | (c & d);
+			k = 0x8f1bbcdcu;
+		} else {
+			f = b ^ c ^ d;
+			k = 0xca62c1d6u;
+		}
+		uint32_t t = wf_rol(a, 5) + f + e + k + w[i];
+		e = d;
+		d = c;
+		c = wf_rol(b, 30);
+		b = a;
+		a = t;
+	}
+	h[0] += a;
+	h[1] += b;
+	h[2] += c;
+	h[3] += d;
+	h[4] += e;
+}
+
+static void
+wf_sha1_init(wf_sha1_t *s)
+{
+	s->h[0] = 0x67452301u;
+	s->h[1] = 0xefcdab89u;
+	s->h[2] = 0x98badcfeu;
+	s->h[3] = 0x10325476u;
+	s->h[4] = 0xc3d2e1f0u;
+	s->n = 0;
+	s->bl = 0;
+}
+
+static void
+wf_sha1_up(wf_sha1_t *s, const uint8_t *p, uint32_t n)
+{
+	s->n += n;
+	while (n) {
+		uint32_t k = 64 - s->bl < n ? 64 - s->bl : n;
+		memcpy(s->b + s->bl, p, k);
+		s->bl += k;
+		p += k;
+		n -= k;
+		if (s->bl == 64) {
+			wf_sha1_blk(s->h, s->b);
+			s->bl = 0;
+		}
+	}
+}
+
+static void
+wf_sha1_fin(wf_sha1_t *s, uint8_t out[20])
+{
+	uint64_t bits = s->n * 8;
+	uint8_t z = 0x80;
+
+	wf_sha1_up(s, &z, 1);
+	z = 0;
+	while (s->bl != 56) {
+		wf_sha1_up(s, &z, 1);
+	}
+	uint8_t L[8];
+	for (int i = 0; i < 8; i++) {
+		L[i] = (uint8_t)(bits >> (56 - 8 * i));
+	}
+	wf_sha1_up(s, L, 8);
+	for (int i = 0; i < 5; i++) {
+		out[4 * i] = (uint8_t)(s->h[i] >> 24);
+		out[4 * i + 1] = (uint8_t)(s->h[i] >> 16);
+		out[4 * i + 2] = (uint8_t)(s->h[i] >> 8);
+		out[4 * i + 3] = (uint8_t)s->h[i];
+	}
+}
+
+typedef struct {
+	wf_sha1_t i, o;
+} wf_hmac_t;
+
+static void
+wf_hmac_init(wf_hmac_t *c, const uint8_t *k, uint32_t kl)
+{
+	uint8_t pad[64], kh[20];
+
+	if (kl > 64) {
+		wf_sha1_t t;
+		wf_sha1_init(&t);
+		wf_sha1_up(&t, k, kl);
+		wf_sha1_fin(&t, kh);
+		k = kh;
+		kl = 20;
+	}
+	for (int i = 0; i < 64; i++) {
+		pad[i] = (uint8_t)(((uint32_t)i < kl ? k[i] : 0) ^ 0x36);
+	}
+	wf_sha1_init(&c->i);
+	wf_sha1_up(&c->i, pad, 64);
+	for (int i = 0; i < 64; i++) {
+		pad[i] = (uint8_t)(((uint32_t)i < kl ? k[i] : 0) ^ 0x5c);
+	}
+	wf_sha1_init(&c->o);
+	wf_sha1_up(&c->o, pad, 64);
+	bzero(pad, sizeof(pad));
+	bzero(kh, sizeof(kh));
+}
+
+static void
+wf_hmac(const wf_hmac_t *c, const uint8_t *m, uint32_t ml, uint8_t out[20])
+{
+	wf_sha1_t t = c->i;
+	uint8_t d[20];
+
+	wf_sha1_up(&t, m, ml);
+	wf_sha1_fin(&t, d);
+	t = c->o;
+	wf_sha1_up(&t, d, 20);
+	wf_sha1_fin(&t, out);
+	bzero(d, sizeof(d));
+}
+
+/* PMK = PBKDF2-HMAC-SHA1(passphrase, SSID, 4096, 32) */
+static void
+wf_pmk(const uint8_t *pw, uint32_t pl, const uint8_t *ssid, uint32_t sl, uint8_t pmk[32])
+{
+	wf_hmac_t c;
+	uint8_t m[36], u[20], t[20];
+
+	wf_hmac_init(&c, pw, pl);
+	for (uint32_t blk = 1; blk <= 2; blk++) {
+		memcpy(m, ssid, sl);
+		m[sl] = 0;
+		m[sl + 1] = 0;
+		m[sl + 2] = 0;
+		m[sl + 3] = (uint8_t)blk;
+		wf_hmac(&c, m, sl + 4, u);
+		memcpy(t, u, 20);
+		for (int j = 1; j < 4096; j++) {
+			wf_hmac(&c, u, 20, u);
+			for (int k = 0; k < 20; k++) {
+				t[k] ^= u[k];
+			}
+		}
+		memcpy(pmk + (blk - 1) * 20, t, blk == 1 ? 20 : 12);
+	}
+	bzero(&c, sizeof(c));
+	bzero(u, sizeof(u));
+	bzero(t, sizeof(t));
+}
+
+/* PRF-384: HMAC-SHA1(key, label 0 data i) for i = 0.. */
+static void
+wf_prf(const uint8_t *key, uint32_t kl, const char *label, const uint8_t *data, uint32_t dl, uint8_t *out,
+    uint32_t ol)
+{
+	wf_hmac_t c;
+	uint8_t m[128], h[20];
+	uint32_t ll = (uint32_t)strlen(label);
+
+	wf_hmac_init(&c, key, kl);
+	memcpy(m, label, ll);
+	m[ll] = 0;
+	memcpy(m + ll + 1, data, dl);
+	for (uint32_t i = 0, o = 0; o < ol; i++) {
+		m[ll + 1 + dl] = (uint8_t)i;
+		wf_hmac(&c, m, ll + 2 + dl, h);
+		uint32_t k = ol - o < 20 ? ol - o : 20;
+		memcpy(out + o, h, k);
+		o += k;
+	}
+	bzero(&c, sizeof(c));
+	bzero(h, sizeof(h));
+}
+
+static uint8_t wf_sb[256], wf_isb[256];
+
+static uint8_t
+wf_rol8(uint8_t x, int k)
+{
+	return (uint8_t)((x << k) | (x >> (8 - k)));
+}
+
+static void
+wf_aes_tables(void)
+{
+	uint8_t p = 1, q = 1;
+
+	if (wf_sb[0] == 0x63) {
+		return;
+	}
+	do {
+		p = (uint8_t)(p ^ (uint8_t)(p << 1) ^ ((p & 0x80) ? 0x1b : 0));
+		q ^= (uint8_t)(q << 1);
+		q ^= (uint8_t)(q << 2);
+		q ^= (uint8_t)(q << 4);
+		if (q & 0x80) {
+			q ^= 0x09;
+		}
+		wf_sb[p] = (uint8_t)(q ^ wf_rol8(q, 1) ^ wf_rol8(q, 2) ^ wf_rol8(q, 3) ^ wf_rol8(q, 4) ^ 0x63);
+	} while (p != 1);
+	wf_sb[0] = 0x63;
+	for (int i = 0; i < 256; i++) {
+		wf_isb[wf_sb[i]] = (uint8_t)i;
+	}
+}
+
+static uint8_t
+wf_gmul(uint8_t a, uint8_t b)
+{
+	uint8_t r = 0;
+
+	while (b) {
+		if (b & 1) {
+			r ^= a;
+		}
+		a = (uint8_t)((a << 1) ^ ((a & 0x80) ? 0x1b : 0));
+		b >>= 1;
+	}
+	return r;
+}
+
+static void
+wf_aes_keyexp(const uint8_t key[16], uint8_t rk[176])
+{
+	uint8_t rc = 1;
+
+	wf_aes_tables();
+	memcpy(rk, key, 16);
+	for (int i = 4; i < 44; i++) {
+		uint8_t t[4];
+		memcpy(t, rk + 4 * (i - 1), 4);
+		if (i % 4 == 0) {
+			uint8_t x = t[0];
+			t[0] = (uint8_t)(wf_sb[t[1]] ^ rc);
+			t[1] = wf_sb[t[2]];
+			t[2] = wf_sb[t[3]];
+			t[3] = wf_sb[x];
+			rc = (uint8_t)((rc << 1) ^ ((rc & 0x80) ? 0x1b : 0));
+		}
+		for (int k = 0; k < 4; k++) {
+			rk[4 * i + k] = rk[4 * (i - 4) + k] ^ t[k];
+		}
+	}
+}
+
+static void
+wf_aes_dec(const uint8_t rk[176], uint8_t s[16])
+{
+	uint8_t t[16];
+
+	for (int i = 0; i < 16; i++) {
+		s[i] ^= rk[160 + i];
+	}
+	for (int r = 9; r >= 0; r--) {
+		for (int c = 0; c < 4; c++) {           /* InvShiftRows + InvSubBytes */
+			for (int w = 0; w < 4; w++) {
+				t[c * 4 + w] = wf_isb[s[((c - w + 4) % 4) * 4 + w]];
+			}
+		}
+		for (int i = 0; i < 16; i++) {
+			s[i] = t[i] ^ rk[16 * r + i];
+		}
+		if (r == 0) {
+			break;
+		}
+		for (int c = 0; c < 4; c++) {           /* InvMixColumns */
+			uint8_t a0 = s[4 * c], a1 = s[4 * c + 1], a2 = s[4 * c + 2], a3 = s[4 * c + 3];
+			s[4 * c] = wf_gmul(a0, 14) ^ wf_gmul(a1, 11) ^ wf_gmul(a2, 13) ^ wf_gmul(a3, 9);
+			s[4 * c + 1] = wf_gmul(a0, 9) ^ wf_gmul(a1, 14) ^ wf_gmul(a2, 11) ^ wf_gmul(a3, 13);
+			s[4 * c + 2] = wf_gmul(a0, 13) ^ wf_gmul(a1, 9) ^ wf_gmul(a2, 14) ^ wf_gmul(a3, 11);
+			s[4 * c + 3] = wf_gmul(a0, 11) ^ wf_gmul(a1, 13) ^ wf_gmul(a2, 9) ^ wf_gmul(a3, 14);
+		}
+	}
+	bzero(t, sizeof(t));
+}
+
+/* RFC 3394 unwrap: in has n+1 64-bit blocks, out gets n; false if the integrity check fails */
+static bool
+wf_unwrap(const uint8_t kek[16], const uint8_t *in, uint32_t len, uint8_t *out)
+{
+	uint8_t rk[176], a[8], b[16];
+	uint32_t n = len / 8 - 1;
+
+	if (len < 24 || len % 8) {
+		return false;
+	}
+	wf_aes_keyexp(kek, rk);
+	memcpy(a, in, 8);
+	memcpy(out, in + 8, 8 * n);
+	for (int j = 5; j >= 0; j--) {
+		for (uint32_t i = n; i >= 1; i--) {
+			uint64_t t = (uint64_t)n * (uint64_t)j + i;
+			memcpy(b, a, 8);
+			for (int k = 0; k < 8; k++) {
+				b[7 - k] ^= (uint8_t)(t >> (8 * k));
+			}
+			memcpy(b + 8, out + 8 * (i - 1), 8);
+			wf_aes_dec(rk, b);
+			memcpy(a, b, 8);
+			memcpy(out + 8 * (i - 1), b + 8, 8);
+		}
+	}
+	bzero(rk, sizeof(rk));
+	bzero(b, sizeof(b));
+	for (int k = 0; k < 8; k++) {
+		if (a[k] != 0xa6) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/*
+ * 0174: the 4-way handshake (IEEE 802.11-2016 12.7.6) and the group key handshake, EAPOL-Key
+ * descriptor version 2 (HMAC-SHA1-128 MIC, AES key wrap). EAPOL frames come on SDPCM channel 2
+ * (wf_frame); the work that needs a dcmd is left to the join loop (wf_hs_step), as a dcmd polls.
+ * No key, PMK or passphrase is ever printed.
+ */
+#define KI_VER2         0x0002u
+#define KI_PAIRWISE     0x0008u
+#define KI_INSTALL      0x0040u
+#define KI_ACK          0x0080u
+#define KI_MIC          0x0100u
+#define KI_SECURE       0x0200u
+#define KI_ENCDATA      0x1000u
+
+static struct {
+	bool on, msg1, msg3, grp, keys_set, ptk_ok;
+	uint8_t pmk[32], ptk[48], anonce[32], snonce[32], aa[6], spa[6];
+	uint8_t ie[64];
+	uint32_t iel;
+	uint8_t replay[8];
+	uint8_t gtk[32];
+	uint32_t gtkl, gid;
+	uint8_t rsc[8];
+	uint32_t steps;                 /* bit per message handled: 1..4, group 5 */
+} wf_hs;
+
+static uint32_t
+wf_be16(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 8 | p[1];
+}
+
+static void
+wf_hs_clear(void)
+{
+	bzero(&wf_hs, sizeof(wf_hs));
+}
+
+/* KCK = PTK[0..15], KEK = PTK[16..31], TK = PTK[32..47] */
+static void
+wf_hs_ptk(void)
+{
+	uint8_t d[76];
+	bool alo = memcmp(wf_hs.aa, wf_hs.spa, 6) < 0, nlo = memcmp(wf_hs.anonce, wf_hs.snonce, 32) < 0;
+
+	memcpy(d, alo ? wf_hs.aa : wf_hs.spa, 6);
+	memcpy(d + 6, alo ? wf_hs.spa : wf_hs.aa, 6);
+	memcpy(d + 12, nlo ? wf_hs.anonce : wf_hs.snonce, 32);
+	memcpy(d + 44, nlo ? wf_hs.snonce : wf_hs.anonce, 32);
+	wf_prf(wf_hs.pmk, 32, "Pairwise key expansion", d, sizeof(d), wf_hs.ptk, 48);
+	bzero(d, sizeof(d));
+	wf_hs.ptk_ok = true;
+}
+
+static void
+wf_hs_mic(const uint8_t *eapol, uint32_t len, uint8_t mic[16])
+{
+	wf_hmac_t c;
+	uint8_t h[20];
+
+	wf_hmac_init(&c, wf_hs.ptk, 16);
+	wf_hmac(&c, eapol, len, h);
+	memcpy(mic, h, 16);
+	bzero(&c, sizeof(c));
+	bzero(h, sizeof(h));
+}
+
+/* one EAPOL-Key frame to the AP: key_info, replay counter, nonce (or zero), key data; MIC filled in */
+static bool
+wf_hs_send(uint32_t ki, const uint8_t *nonce, const uint8_t *kd, uint32_t kdl)
+{
+	static uint8_t f[4 + 14 + 4 + 95 + 64];
+	uint8_t *e = f + 4, *x = e + 14, *k = x + 4;
+	uint32_t bl = 95 + kdl;
+
+	if (kdl > 64) {
+		return false;
+	}
+	bzero(f, sizeof(f));
+	f[0] = 0x20;                            /* BDC: protocol version 2; priority 0, interface 0 */
+	memcpy(e, wf_hs.aa, 6);
+	memcpy(e + 6, wf_hs.spa, 6);
+	e[12] = 0x88;
+	e[13] = 0x8e;
+	x[0] = 1;                               /* 802.1X-2001, as wpa_supplicant sends by default */
+	x[1] = 3;                               /* EAPOL-Key */
+	x[2] = (uint8_t)(bl >> 8);
+	x[3] = (uint8_t)bl;
+	k[0] = 2;                               /* RSN key descriptor */
+	k[1] = (uint8_t)(ki >> 8);
+	k[2] = (uint8_t)ki;
+	memcpy(k + 5, wf_hs.replay, 8);
+	if (nonce) {
+		memcpy(k + 13, nonce, 32);
+	}
+	k[93] = (uint8_t)(kdl >> 8);
+	k[94] = (uint8_t)kdl;
+	if (kdl) {
+		memcpy(k + 95, kd, kdl);
+	}
+	wf_hs_mic(x, 4 + bl, k + 77);
+	bool ok = wf_sdpcm_send(2, f, 4 + 14 + 4 + bl);
+	bzero(f, sizeof(f));
+	return ok;
+}
+
+/* key data of message 3 or group 1: unwrapped, the GTK KDE taken */
+static bool
+wf_hs_gtk(const uint8_t *k, uint32_t kdl)
+{
+	static uint8_t p[256];
+
+	if (kdl < 24 || kdl > sizeof(p) + 8 || !wf_unwrap(wf_hs.ptk + 16, k + 95, kdl, p)) {
+		printf("USB> wifi: EAPOL: key data did not unwrap (%u bytes)\n", kdl);
+		return false;
+	}
+	bool got = false;
+	for (uint32_t o = 0; o + 2 <= kdl - 8;) {
+		uint32_t id = p[o], l = p[o + 1];
+		if (id == 0xdd && l == 0) {
+			break;                          /* padding */
+		}
+		if (o + 2 + l > kdl - 8) {
+			break;
+		}
+		if (id == 0xdd && l >= 6 + 16 && p[o + 2] == 0x00 && p[o + 3] == 0x0f && p[o + 4] == 0xac &&
+		    p[o + 5] == 1) {
+			wf_hs.gid = p[o + 6] & 3;
+			wf_hs.gtkl = l - 6 > 32 ? 32 : l - 6;
+			memcpy(wf_hs.gtk, p + o + 8, wf_hs.gtkl);
+			got = true;
+		}
+		o += 2 + l;
+	}
+	bzero(p, sizeof(p));
+	if (!got) {
+		printf("USB> wifi: EAPOL: no GTK in the key data\n");
+	}
+	return got;
+}
+
+/* an EAPOL frame from the AP (ethernet frame, 0x888e) */
+static void
+wf_eapol(const uint8_t *e, uint32_t len)
+{
+	static uint8_t c[4 + 95 + 256];
+
+	if (!wf_hs.on || len < 14 + 4 + 95) {
+		printf("USB> wifi: EAPOL frame (%u bytes) %s\n", len, wf_hs.on ? "too short" : "with no handshake running");
+		return;
+	}
+	const uint8_t *x = e + 14, *k = x + 4;
+	uint32_t bl = wf_be16(x + 2), ki = wf_be16(k + 1), kdl = wf_be16(k + 93);
+	if (x[1] != 3 || k[0] != 2 || bl < 95 || 14 + 4 + bl > len || 95 + kdl > bl || 4 + bl > sizeof(c)) {
+		printf("USB> wifi: EAPOL: not an RSN EAPOL-Key frame (type %u desc %u len %u)\n", x[1], k[0], bl);
+		return;
+	}
+	if ((ki & 7) != KI_VER2) {
+		printf("USB> wifi: EAPOL: key descriptor version %u (only 2, HMAC-SHA1/AES, is done)\n", ki & 7);
+		return;
+	}
+	if ((ki & KI_PAIRWISE) && (ki & KI_ACK) && !(ki & KI_MIC)) {
+		/* message 1: ANonce; the reply waits for the join loop, which knows our RSN IE */
+		memcpy(wf_hs.aa, e + 6, 6);
+		memcpy(wf_hs.anonce, k + 13, 32);
+		memcpy(wf_hs.replay, k + 5, 8);
+		wf_hs.ptk_ok = false;
+		wf_hs.msg1 = true;
+		wf_hs.steps |= 1u << 1;
+		printf("USB> wifi: EAPOL 1/4 from the AP\n");
+		return;
+	}
+	if (!wf_hs.ptk_ok) {
+		printf("USB> wifi: EAPOL: key frame 0x%04x before message 1\n", ki);
+		return;
+	}
+	/* the MIC, over the frame with the MIC field zero */
+	uint8_t mic[16];
+	memcpy(c, x, 4 + bl);
+	bzero(c + 4 + 77, 16);
+	wf_hs_mic(c, 4 + bl, mic);
+	bool micok = !memcmp(mic, k + 77, 16);
+	bzero(c, sizeof(c));
+	if (!micok) {
+		printf("USB> wifi: EAPOL: MIC wrong in key frame 0x%04x (wrong password?)\n", ki);
+		return;
+	}
+	memcpy(wf_hs.replay, k + 5, 8);
+	if ((ki & KI_PAIRWISE) && (ki & KI_INSTALL)) {
+		/* message 3: GTK, then message 4 and the keys */
+		if (!(ki & KI_ENCDATA) || !wf_hs_gtk(k, kdl)) {
+			return;
+		}
+		memcpy(wf_hs.rsc, k + 61, 8);
+		wf_hs.steps |= 1u << 3;
+		printf("USB> wifi: EAPOL 3/4 from the AP: MIC ok, group key id %u (%u bytes)\n", wf_hs.gid, wf_hs.gtkl);
+		bool ok = wf_hs_send(KI_VER2 | KI_PAIRWISE | KI_MIC | KI_SECURE, NULL, NULL, 0);
+		printf("USB> wifi: EAPOL 4/4 %s\n", ok ? "sent" : "send FAILED");
+		if (ok) {
+			wf_hs.steps |= 1u << 4;
+			wf_hs.msg3 = true;              /* the join loop installs the keys */
+		}
+	} else if (!(ki & KI_PAIRWISE) && (ki & KI_ACK)) {
+		/* group key handshake 1/2 */
+		if (!(ki & KI_ENCDATA) || !wf_hs_gtk(k, kdl)) {
+			return;
+		}
+		memcpy(wf_hs.rsc, k + 61, 8);
+		bool ok = wf_hs_send(KI_VER2 | KI_MIC | KI_SECURE, NULL, NULL, 0);
+		printf("USB> wifi: EAPOL group 1/2: key id %u, 2/2 %s\n", wf_hs.gid, ok ? "sent" : "send FAILED");
+		wf_hs.steps |= 1u << 5;
+		wf_hs.grp = true;
+	} else {
+		printf("USB> wifi: EAPOL: key frame 0x%04x not handled\n", ki);
+	}
+}
+
+/* wl_wsec_key (brcmfmac brcmf_wsec_key_le), 164 bytes, by WLC_SET_KEY */
+static int
+wf_set_key(uint32_t index, const uint8_t *key, uint32_t kl, const uint8_t *ea, uint32_t flags, const uint8_t *rsc)
+{
+	uint8_t b[164];
+	uint32_t v;
+
+	bzero(b, sizeof(b));
+	memcpy(b, &index, 4);
+	memcpy(b + 4, &kl, 4);
+	memcpy(b + 8, key, kl);
+	v = 4;                                  /* CRYPTO_ALGO_AES_CCM */
+	memcpy(b + 112, &v, 4);
+	memcpy(b + 116, &flags, 4);
+	if (rsc) {
+		v = 1;                          /* iv_initialized, rxiv from the RSC (little-endian, 48 bits) */
+		memcpy(b + 132, &v, 4);
+		v = (uint32_t)rsc[2] | (uint32_t)rsc[3] << 8 | (uint32_t)rsc[4] << 16 | (uint32_t)rsc[5] << 24;
+		memcpy(b + 140, &v, 4);
+		b[144] = rsc[0];
+		b[145] = rsc[1];
+	}
+	if (ea) {
+		memcpy(b + 156, ea, 6);
+	}
+	int st = wf_dcmd(45, true, b, sizeof(b));       /* WLC_SET_KEY */
+	bzero(b, sizeof(b));
+	return st;
+}
+
+/* from the join loop, after each poll: message 2 sent, keys installed */
+static void
+wf_hs_step(void)
+{
+	if (!wf_hs.on) {
+		return;
+	}
+	if (wf_hs.msg1) {
+		wf_hs.msg1 = false;
+		if (!wf_hs.iel) {
+			/* our RSN IE as the firmware sent it in the association request */
+			int st = wf_iovar_get("assoc_req_ies", 400);
+			for (uint32_t o = 0; st == 0 && o + 2 <= wf_ctl_len;) {
+				uint32_t l = wf_ctl[o + 1];
+				if (o + 2 + l > wf_ctl_len) {
+					break;
+				}
+				if (wf_ctl[o] == 0x30 && l + 2 <= sizeof(wf_hs.ie)) {
+					wf_hs.iel = l + 2;
+					memcpy(wf_hs.ie, wf_ctl + o, wf_hs.iel);
+					break;
+				}
+				o += 2 + l;
+			}
+			if (!wf_hs.iel) {
+				/* RSN, CCMP group and pairwise, PSK, no capabilities */
+				static const uint8_t rsn[] = { 0x30, 0x14, 1, 0, 0, 0x0f, 0xac, 4, 1, 0, 0, 0x0f, 0xac, 4, 1,
+					                       0, 0, 0x0f, 0xac, 2, 0, 0 };
+				memcpy(wf_hs.ie, rsn, sizeof(rsn));
+				wf_hs.iel = sizeof(rsn);
+				printf("USB> wifi: EAPOL: assoc_req_ies status %d (%u bytes), the default RSN IE used\n", st,
+				    wf_ctl_len);
+			} else {
+				printf("USB> wifi: EAPOL: our RSN IE from the association request, %u bytes\n", wf_hs.iel);
+			}
+		}
+		if (!wf_hs.ptk_ok) {
+			read_random(wf_hs.snonce, sizeof(wf_hs.snonce));
+			wf_hs_ptk();
+		}
+		bool ok = wf_hs_send(KI_VER2 | KI_PAIRWISE | KI_MIC, wf_hs.snonce, wf_hs.ie, wf_hs.iel);
+		printf("USB> wifi: EAPOL 2/4 %s\n", ok ? "sent" : "send FAILED");
+		if (ok) {
+			wf_hs.steps |= 1u << 2;
+		}
+	}
+	if (wf_hs.msg3) {
+		wf_hs.msg3 = false;
+		int p = wf_set_key(0, wf_hs.ptk + 32, 16, wf_hs.aa, 0, NULL);
+		int g = wf_set_key(wf_hs.gid, wf_hs.gtk, wf_hs.gtkl, NULL, 2u /* WL_PRIMARY_KEY */, wf_hs.rsc);
+		printf("USB> wifi: keys installed: pairwise status %d, group (id %u) status %d\n", p, wf_hs.gid, g);
+		wf_hs.keys_set = p == 0 && g == 0;
+		bzero(wf_hs.gtk, sizeof(wf_hs.gtk));
+	}
+	if (wf_hs.grp) {
+		wf_hs.grp = false;
+		int g = wf_set_key(wf_hs.gid, wf_hs.gtk, wf_hs.gtkl, NULL, 2u, wf_hs.rsc);
+		printf("USB> wifi: group key (id %u) installed: status %d\n", wf_hs.gid, g);
+		bzero(wf_hs.gtk, sizeof(wf_hs.gtk));
+	}
+}
+
+/* hex text to bytes, up to a space or the end; -1 if not hex or too long */
+static int
+wf_unhex(const char **pp, uint8_t *out, uint32_t max)
+{
+	const char *p = *pp;
+	uint32_t n = 0;
+
+	while (*p == ' ') {
+		p++;
+	}
+	while (*p && *p != ' ') {
+		int v[2];
+		for (int k = 0; k < 2; k++) {
+			char c = p[k];
+			v[k] = (c >= '0' && c <= '9') ? c - '0' : (c >= 'a' && c <= 'f') ? c - 'a' + 10 :
+			    (c >= 'A' && c <= 'F') ? c - 'A' + 10 : -1;
+			if (v[k] < 0) {
+				return -1;
+			}
+		}
+		if (n >= max) {
+			return -1;
+		}
+		out[n++] = (uint8_t)(v[0] << 4 | v[1]);
+		p += 2;
+	}
+	*pp = p;
+	return (int)n;
+}
