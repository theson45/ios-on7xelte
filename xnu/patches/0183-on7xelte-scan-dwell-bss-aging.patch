+/*
+ * 0160: Wi-Fi of the J7 Prime (on7xelte), step W2: the BCM43430A1 seen as an SDIO card.
+ *
+ * The radio sits on the SoC's second DesignWare MSHC (dwmmc1, 0x13550000, 4-bit SDIO), powered by
+ * WLAN_REG_ON (gpd3-6); its pins are gpr2-0/1 (clock, command) and gpr3-0..3 (data).  Nothing of this
+ * is touched at boot: only the USB command "wifi" (run by the dvfs worker, a5xelte_dvfs.c) does it.
+ *
+ *   wifi probe   pins to SD, REG_ON high, dwmmc1 from reset at <= 400 kHz, the card's SDIO enumeration
+ *                (CMD0, CMD5, CMD3, CMD7), CCCR read, function 1 enabled, the ALP clock asked for, and
+ *                the chip's ID read from the backplane (chipcommon 0x18000000) with CMD52; then
+ *                everything off again (REG_ON low, controller unpowered) unless "wifi probe keep"
+ *   wifi off     REG_ON low, controller clock and power off
+ *   wifi st      the controller's and the pins' registers
+ *   wifi fw      (0161, W3) the firmware: /usr/share/firmware/wifi/on7xelte/bcm43430a1-sdio.{bin,txt} of the
+ *                root (put there by sweet-root-tweaks.py --wifi-fw: the phone's own Android files) read whole,
+ *                the probe above, a 4-bit bus, the backplane's cores from its EROM, the image written to the
+ *                chip's RAM with CMD53 and read back, the NVRAM under its length token, the ARM let go, the HT
+ *                clock, function 2, and the firmware's sdpcm_shared and console read; left powered
+ *
+ * Linux references: drivers/mmc/core/sdio*.c (enumeration), drivers/mmc/host/dw_mmc.c + dw_mmc-exynos.c
+ * (the host; CLKSEL from the DT's samsung,dw-mshc-sdr-timing <3 0 2 0>), brcmfmac sdio.c/bcmsdh.c
+ * (SBSDIO_FUNC1_* window and clock-control registers), dhd_custom_exynos.c (REG_ON).
+ * Every wait is bounded; every step says what it did as "USB> wifi: ...".
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <libkern/libkern.h>
+#include <kern/kalloc.h>
+#include <sys/kauth.h>
+#include <sys/uio.h>
