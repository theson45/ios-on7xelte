-static errno_t
-wf_a8_ioctl(unsigned long cmd, void *data)
-{
-	static uint32_t said;
-	struct apple80211req *r = data;
-	char who[32] = "?", what[160] = "";
-	bool set = cmd == SIOCSA80211;
-	int err;
-
-	if (cmd != SIOCSA80211 && cmd != SIOCGA80211) {
-		return EOPNOTSUPP;
-	}
-	proc_selfname(who, sizeof(who));
-	err = set ? wf_a8_set(r, what, sizeof(what)) : wf_a8_get(r);
-	wf_a8_note(r, set, err);
-	/* a request asked for ever is told some hundred times; SCAN_RESULT only when it fails other than at the end */
-	if (said < 600 && !(r->req_type == 11 && (err == 0 || err == EIO))) {
-		said++;
-		char res[24];
-		snprintf(res, sizeof(res), err == 0 ? "ok" : err == EOPNOTSUPP ? "REFUSED" : "error %d", err);
-		printf("USB> wifi: A8: %s %s %d (%s), value %d, %u bytes%s: %s\n", who, set ? "sets" : "gets", r->req_type,
-		    wf_a8_name(r->req_type), r->req_val, r->req_len, what, res);
-	}
-	return err;
