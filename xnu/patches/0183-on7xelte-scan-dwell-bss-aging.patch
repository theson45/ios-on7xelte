-			r->req_len = c->sl;
-		}
-		break;
-	case 9:
-		err = j ? wf_a8_give(r, c->bssid, 6) : ENXIO;
-		break;
-	case 4: {
-		struct {
-			uint32_t version;
-			struct apple80211_channel channel;
-		} ch = { .version = 1 };
