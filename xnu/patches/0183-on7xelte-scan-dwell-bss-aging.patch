-/*
- * ---- W3 (0161): data transfers, the backplane, the firmware download ----
- *
- * As bcmdhd (dhd_sdio.c dhdsdio_download_state / dhdsdio_write_vars / dhdsdio_bus_init, aiutils.c) does it
- * for a Cortex-M3 chip: ARM core held in reset, SOCRAM reset (bank 3 remap off on the 43430), the image at
- * RAM address 0, the NVRAM variables at the top of RAM under their length token, SDIO-core interrupts
- * cleared, ARM out of reset; then the HT clock, function 2 with the SDPCM protocol version, and the
- * firmware's own word at the end of RAM: the address of its sdpcm_shared, which names its console.
- */
-#define M_BLKSIZ        0x01cu
-#define M_BYTCNT        0x020u
-#define M_FIFO          0x200u          /* DW MSHC >= 2.40a */
-#define CTRL_FIFO_RST   0x2u
-#define CMD_DATA        (1u << 9)
-#define CMD_WRITE       (1u << 10)
-#define RINT_DTO        (1u << 3)
-#define RINT_TXDR       (1u << 4)
-#define RINT_RXDR       (1u << 5)
-#define RINT_DERR       ((1u << 7) | (1u << 9) | (1u << 10) | (1u << 11) | (1u << 13) | (1u << 15))
-#define SB_ACCESS_4B    0x8000u
-#define SB_OFT_MASK     0x7fffu
-#define WF_CHUNK        64u             /* function-1 block size; one CMD53 in byte mode */
-
-#define CLK_FORCE_HT    0x02u
-#define CLK_HT_REQ      0x10u
-#define CLK_HT_AVAIL    0x80u
-#define SB_WATERMARK    0x10008u
-
-#define CORE_SOCRAM     0x80eu
-#define CORE_D11        0x812u
-#define CORE_SDIOD      0x829u
-#define CORE_CM3        0x82au
-
-#define AI_IOCTRL       0x408u
-#define AI_RESETCTRL    0x800u
-#define AI_RESETSTATUS  0x804u
-#define SICF_FGC        0x2u
-#define SICF_CLOCK_EN   0x1u
-
-#define SR_COREINFO     0x00u
-#define SR_BANKIDX      0x10u
-#define SR_BANKINFO     0x40u
-#define SR_BANKPDA      0x44u
-#define SD_INTSTATUS    0x20u
-#define SD_TOSBMAILBOXDATA 0x48u
-
-#define WF_FW_PATH      "/usr/share/firmware/wifi/on7xelte/bcm43430a1-sdio.bin"
-#define WF_NV_PATH      "/usr/share/firmware/wifi/on7xelte/bcm43430a1-sdio.txt"
-
-struct wf_core {
-	uint32_t id, rev, base, wrap;
-};
-static struct wf_core wf_cores[16];
-static uint32_t wf_ncores;
-static bool wf_bad;                     /* a backplane access failed since it was last cleared */
-static uint32_t wf_errs;                /* data-transfer errors, the first few of which are told */
-
-/* CMD53 in byte mode, incrementing: n (4..64, a multiple of 4) bytes of function fn at addr */
-static bool wf_cmd53_once(uint32_t fn, uint32_t addr, bool wr, uint32_t *buf, uint32_t n, bool quiet);
-
-static bool
-wf_cmd53(uint32_t fn, uint32_t addr, bool wr, uint32_t *buf, uint32_t n)
-{
-	if (wf_cmd53_once(fn, addr, wr, buf, n, true)) {
-		return true;
-	}
-	delay(1000);
-	return wf_cmd53_once(fn, addr, wr, buf, n, false);   /* 0163: once more, and tell if that fails too */
-}
-
-/*
- * 0168: how a FIFO entry is written ('wifi fifo N'). 0167 (xnu51): one 64-bit str at 0x200 after TXDR, still
- * FIFO count 0 and the card left waiting in TRN. 0 = 64-bit str at 0x200, 1 = 32-bit low at 0x200 and high at
- * 0x204, 2 = both 32-bit halves at 0x200, 3 = only 32-bit words at 0x200 (no padding).
- */
-static uint32_t wf_fifo_mode = 1;      /* 0169: mode 1 works (xnu52): SOCRAM written right */
-static uint32_t wf_div = 4;             /* 0169: 'wifi div N' (hex); 0170: 4 by default (xnu53: 2.4 s, clean) */
-
-static void
-wf_fifo_put(uint32_t lo, uint32_t hi)
-{
-	switch (wf_fifo_mode) {
-	case 1:
-		wr32(wf_mmc, M_FIFO, lo);
-		wr32(wf_mmc, M_FIFO + 4, hi);
-		break;
-	case 2:
-		wr32(wf_mmc, M_FIFO, lo);
-		wr32(wf_mmc, M_FIFO, hi);
-		break;
-	default:
-		*(volatile uint64_t *)(wf_mmc + M_FIFO) = lo | ((uint64_t)hi << 32);
-		break;
-	}
-}
-
-/* 0171: up to max FIFO entries into buf[got..nw), each as 0x200 (low) then 0x204 (high); returns the new got */
-static uint32_t
-wf_fifo_take(uint32_t *buf, uint32_t got, uint32_t nw, uint32_t max)
-{
-	for (uint32_t e = 0; e < max && got < nw; e++) {
-		buf[got] = rd32(wf_mmc, M_FIFO);
-		uint32_t hi = rd32(wf_mmc, M_FIFO + 4);
-		if (got + 1 < nw) {
-			buf[got + 1] = hi;
-		}
-		got += 2;
-	}
-	return got;
-}
-
-static bool
-wf_cmd53_once(uint32_t fn, uint32_t addr, bool wr, uint32_t *buf, uint32_t n, bool quiet)
-{
-	uint32_t arg = (wr ? (1u << 31) : 0) | ((fn & 7) << 28) | (1u << 26) | ((addr & 0x1ffff) << 9) | (n & 0x1ff);
-	uint32_t st = 0, r = 0, pre = 0, sent = 0, nw = n / 4;
-
-	(void)wf_idle();
-	wr32(wf_mmc, M_CTRL, rd32(wf_mmc, M_CTRL) | CTRL_FIFO_RST);
-	if (!wf_wait_clear(M_CTRL, CTRL_FIFO_RST, 10000)) {
-		goto bad;
-	}
-	wr32(wf_mmc, M_BLKSIZ, n);
-	wr32(wf_mmc, M_BYTCNT, n);
-	/*
-	 * 0167: no FIFO prefill. 0166 showed the FIFO still empty after it (stores before the data command are
-	 * dropped) and RINTSTS TXDR set: the controller was asking for data. As dw_mmc's PIO path
-	 * (dw_mci_write_data_pio on TXDR), push the data once the command runs and TXDR is raised.
-	 */
-	wr32(wf_mmc, M_RINTSTS, 0xffffffffu);
-	wr32(wf_mmc, M_CMDARG, arg);
-	wr32(wf_mmc, M_CMD, CMD_START | CMD_HOLD | CMD_WAIT_PRV | CMD_RESP | CMD_CRC | CMD_DATA |
-	    (wr ? CMD_WRITE : 0) | 53);
-	for (uint32_t t = 0; t < 500000; t += 5) {
-		st = rd32(wf_mmc, M_RINTSTS);
-		if (wr && sent < nw && (st & RINT_TXDR)) {
-			/* 64-bit FIFO (HCON H_DATA_WIDTH 2), depth 64: push while there is room; odd last word + zeros */
-			uint32_t fc = (rd32(wf_mmc, M_STATUS) >> 17) & 0x1fff;
-			uint32_t before = rd32(wf_mmc, M_STATUS);
-			while (sent < nw && fc < 64) {
-				if (wf_fifo_mode == 3) {
-					wr32(wf_mmc, M_FIFO, buf[sent]);
-					sent += 1;
-				} else {
-					wf_fifo_put(buf[sent], (sent + 1 < nw) ? buf[sent + 1] : 0);
-					sent += 2;
-				}
-				fc++;
-			}
-			pre = rd32(wf_mmc, M_STATUS);
-			(void)before;
-			wr32(wf_mmc, M_RINTSTS, RINT_TXDR);
-			continue;
-		}
-		if (!wr && wf_fifo_mode == 1 && sent < nw && (st & RINT_RXDR)) {
-			/* 0171: as dw_mci_read_data_pio on RXDR: take what the FIFO holds (entries of 64 bits) */
-			uint32_t fc = (rd32(wf_mmc, M_STATUS) >> 17) & 0x1fff;
-			sent = wf_fifo_take(buf, sent, nw, fc);
-			wr32(wf_mmc, M_RINTSTS, RINT_RXDR);
-			continue;
-		}
-		if ((st & RINT_DTO) || (st & (RINT_HLE | RINT_DERR)) ||
-		    ((st & RINT_CMD_DONE) && (st & (RINT_RE | RINT_RTO | RINT_RCRC)))) {
-			break;
-		}
-		delay(5);
-	}
-	r = rd32(wf_mmc, M_RESP0);
-	wr32(wf_mmc, M_RINTSTS, st);
-	if (!(st & RINT_DTO) || (st & (RINT_HLE | RINT_DERR | RINT_RE | RINT_RTO | RINT_RCRC)) || (r & 0xcb00u)) {
-		goto bad;
-	}
-	if (!wr && wf_fifo_mode == 1) {
-		/* 0169: a 64-bit FIFO entry read as two 32-bit halves, 0x200 then 0x204; 0171: the rest after DTO */
-		sent = wf_fifo_take(buf, sent, nw, 64);
-	} else if (!wr) {
-		for (uint32_t i = 0; i < n / 4; i++) {
-			buf[i] = rd32(wf_mmc, M_FIFO);
-		}
-	}
-	return true;
-bad:
-	{
-		uint32_t stat = rd32(wf_mmc, M_STATUS);
-		wr32(wf_mmc, M_CTRL, rd32(wf_mmc, M_CTRL) | CTRL_RESETS);
-		(void)wf_wait_clear(M_CTRL, CTRL_RESETS, 100000);
-		wr32(wf_mmc, M_RINTSTS, 0xffffffffu);
-		(void)wf_clk_update();
-		(void)wf_wr8(0, 0x06, (uint8_t)(fn & 7));       /* CCCR I/O abort of this function */
-		wr32(wf_mmc, M_RINTSTS, 0xffffffffu);
-		if (!quiet && wf_errs < 6) {
-			printf("USB> wifi: CMD53 recovery: STATUS 0x%08x -> 0x%08x (HCON data width %u)\n", stat,
-			    rd32(wf_mmc, M_STATUS), (rd32(wf_mmc, M_HCON) >> 7) & 7);
-		}
-	}
-	if (quiet) {
-		return false;
-	}
-	if (wf_errs++ < 6) {
-		printf("USB> wifi: CMD53 %s fn %u addr 0x%05x n %u failed twice: RINTSTS 0x%08x R5 0x%08x STATUS 0x%08x"
-		    " (pushed %u of %u words, then STATUS 0x%08x / %u in FIFO; CTRL 0x%08x BMOD 0x%08x; bus %u-bit)\n",
-		    wr ? "write" : "read", fn, addr, n, st, r, rd32(wf_mmc, M_STATUS), sent > nw ? nw : sent, nw, pre,
-		    (pre >> 17) & 0x1fff, rd32(wf_mmc, M_CTRL), rd32(wf_mmc, 0x080u), rd32(wf_mmc, M_CTYPE) ? 4 : 1);
-	}
-	wf_bad = true;
-	return false;
-}
-
-static bool
-wf_setwin(uint32_t addr)
-{
-	uint32_t w = addr & ~SB_OFT_MASK;
-
-	if (w == wf_win) {
-		return true;
-	}
-	static const uint32_t reg[3] = { SB_SBADDRLOW, SB_SBADDRMID, SB_SBADDRHIGH };
-	uint8_t val[3] = { (uint8_t)((w >> 8) & 0x80), (uint8_t)((w >> 16) & 0xff), (uint8_t)((w >> 24) & 0xff) };
-	for (uint32_t i = 0; i < 3; i++) {
-		if (!wf_wr8(1, reg[i], val[i])) {
-			/* 0162: say which byte and why; one retry, as the card may still be busy from a CMD53 */
-			uint32_t e1 = wf_last_e, r1 = wf_last_r;
-			delay(1000);
-			bool again = wf_wr8(1, reg[i], val[i]);
-			if (wf_errs++ < 6) {
-				printf("USB> wifi: window 0x%08x: CMD52 write 0x%05x = 0x%02x failed: err 0x%08x R5 0x%08x "
-				    "STATUS 0x%08x; retry %s (err 0x%08x R5 0x%08x)\n", w, reg[i], val[i], e1, r1,
-				    rd32(wf_mmc, M_STATUS), again ? "ok" : "failed", wf_last_e, wf_last_r);
-			}
-			if (!again) {
-				wf_win = 0xffffffffu;
-				wf_bad = true;
-				return false;
-			}
-		}
-	}
-	wf_win = w;
-	return true;
-}
-
-/* n <= 64 bytes at a backplane address, inside one 32 KiB window */
-static bool
-wf_bp(uint32_t addr, bool wr, uint32_t *buf, uint32_t n)
-{
-	if (wf_bad) {
-		return false;   /* 0164: fail fast after the first error */
-	}
-	return wf_setwin(addr) && wf_cmd53(1, (addr & SB_OFT_MASK) | SB_ACCESS_4B, wr, buf, n);
-}
-
-static uint32_t
-wf_rd32(uint32_t addr)
-{
-	uint32_t v = 0;
-
-	if (!wf_bp(addr, false, &v, 4)) {
-		return 0xffffffffu;
-	}
-	return v;
-}
-
-static void
-wf_wr32(uint32_t addr, uint32_t v)
-{
-	(void)wf_bp(addr, true, &v, 4);
-}
-
-/* len bytes of chip memory at addr (4-aligned), in 64-byte pieces; verify compares instead of storing */
-static bool
-wf_mem(uint32_t addr, bool wr, uint8_t *data, uint32_t len, bool verify, uint32_t *diffs)
-{
-	uint32_t chunk[WF_CHUNK / 4];
-
-	while (len) {
-		uint32_t n = WF_CHUNK - (addr & (WF_CHUNK - 1));
-		if (n > len) {
-			n = len;
-		}
-		uint32_t nw = (n + 3) & ~3u;
-		if (wr) {
-			bzero(chunk, sizeof(chunk));
-			memcpy(chunk, data, n);
-		}
-		if (!wf_bp(addr, wr, chunk, nw)) {
-			return false;
-		}
-		if (!wr) {
-			if (verify) {
-				if (memcmp(chunk, data, n)) {
-					if ((*diffs)++ < 3) {
-						printf("USB> wifi: verify: differs in the 64 bytes at 0x%05x\n", addr);
-					}
-				}
-			} else {
-				memcpy(data, chunk, n);
-			}
-		}
-		addr += n;
-		data += n;
-		len -= n;
-	}
-	return true;
-}
-
-static struct wf_core *
-wf_core(uint32_t id)
-{
-	for (uint32_t i = 0; i < wf_ncores; i++) {
-		if (wf_cores[i].id == id && wf_cores[i].base && wf_cores[i].wrap) {
-			return &wf_cores[i];
-		}
-	}
-	return NULL;
-}
-
-/* the backplane's enumeration ROM (aiutils.c ai_scan): each core's ID, revision, registers, wrapper */
-static void
-wf_erom(void)
-{
-	uint32_t p = wf_rd32(SI_ENUM_BASE + 0xfc);
-	struct wf_core *c = NULL;
-
-	wf_ncores = 0;
-	printf("USB> wifi: EROM at 0x%08x: %08x %08x %08x %08x\n", p, wf_rd32(p), wf_rd32(p + 4), wf_rd32(p + 8),
-	    wf_rd32(p + 12));
-	for (uint32_t i = 0; i < 256 && !wf_bad; i++) {
-		uint32_t e = wf_rd32(p);
-		p += 4;
-		if (e == 0xffffffffu) {
-			break;
-		}
-		if (!(e & 1)) {
-			continue;
-		}
-		if ((e & 0xe) == 0xe) {                 /* end */
-			break;
-		}
-		if ((e & 0x6) == 0) {                   /* component: CIA, then CIB */
-			uint32_t b = wf_rd32(p);
-			p += 4;
-			c = wf_ncores < 16 ? &wf_cores[wf_ncores++] : NULL;
-			if (c) {
-				c->id = (e >> 8) & 0xfff;
-				c->rev = b >> 24;
-				c->base = c->wrap = 0;
-			}
-		} else if ((e & 0xe) == 4) {            /* address descriptor */
-			if (e & 0x8) {
-				p += 4;                         /* upper 32 address bits */
-			}
-			if ((e & 0x30) == 0x30) {
-				uint32_t sz = wf_rd32(p);
-				p += 4;
-				if (sz & 0x8) {
-					p += 4;
-				}
-			}
-			uint32_t t = e & 0xc0, sp = (e >> 8) & 0xf, a = e & 0xfffff000u;
-			if (c) {
-				if (t == 0 && sp == 0 && !c->base) {
-					c->base = a;
-				}
-				if ((t == 0x80 || t == 0xc0) && !c->wrap) {
-					c->wrap = a;
-				}
-			}
-		}
-	}
-	for (uint32_t i = 0; i < wf_ncores; i++) {
-		printf("USB> wifi: core 0x%03x rev %u regs 0x%08x wrapper 0x%08x\n", wf_cores[i].id, wf_cores[i].rev,
-		    wf_cores[i].base, wf_cores[i].wrap);
-	}
-}
-
-static bool
-wf_core_up(struct wf_core *c)
-{
-	uint32_t io = wf_rd32(c->wrap + AI_IOCTRL), rc = wf_rd32(c->wrap + AI_RESETCTRL);
-	return (io & (SICF_FGC | SICF_CLOCK_EN)) == SICF_CLOCK_EN && !(rc & 1);
-}
-
-static void
-wf_core_disable(struct wf_core *c, uint32_t prereset, uint32_t reset)
-{
-	if (!(wf_rd32(c->wrap + AI_RESETCTRL) & 1)) {
-		wf_wr32(c->wrap + AI_IOCTRL, prereset | SICF_FGC | SICF_CLOCK_EN);
-		(void)wf_rd32(c->wrap + AI_IOCTRL);
-		wf_wr32(c->wrap + AI_RESETCTRL, 1);
-		delay(20);
-		for (uint32_t t = 0; t < 300 && !wf_bad && wf_rd32(c->wrap + AI_RESETCTRL) != 1; t++) {
-			delay(1);
-		}
-	}
-	wf_wr32(c->wrap + AI_IOCTRL, reset | SICF_FGC | SICF_CLOCK_EN);
-	(void)wf_rd32(c->wrap + AI_IOCTRL);
