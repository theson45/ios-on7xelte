-/* a file of the root, whole, in memory of ours (as y2sios redwood_adsp.c root_file) */
-static uint8_t *
-wf_file(const char *path, uint32_t *size)
-{
-	vfs_context_t ctx = vfs_context_kernel();
-	vnode_t vp = NULLVP;
-	struct vnode_attr va;
-	uint8_t *data;
-	int left = 0, error;
-
-	if (rootvnode == NULLVP || vnode_lookup(path, 0, &vp, ctx) != 0) {
-		printf("USB> wifi: %s: not found\n", path);
-		return NULL;
-	}
-	VATTR_INIT(&va);
-	VATTR_WANTED(&va, va_data_size);
-	if (vnode_getattr(vp, &va, ctx) != 0 || va.va_data_size == 0 || va.va_data_size > (1u << 20)) {
-		printf("USB> wifi: %s: no size, or too big\n", path);
-		vnode_put(vp);
-		return NULL;
-	}
-	data = kalloc_data((vm_size_t)va.va_data_size, Z_WAITOK);
-	if (data == NULL) {
-		vnode_put(vp);
-		return NULL;
-	}
-	error = vn_rdwr(UIO_READ, vp, (caddr_t)data, (int)va.va_data_size, 0, UIO_SYSSPACE, 0,
-	    vfs_context_ucred(ctx), &left, vfs_context_proc(ctx));
-	vnode_put(vp);
-	if (error != 0 || left != 0) {
-		printf("USB> wifi: %s: read error %d, %d bytes left\n", path, error, left);
-		kfree_data(data, (vm_size_t)va.va_data_size);
-		return NULL;
-	}
-	*size = (uint32_t)va.va_data_size;
-	return data;
-}
