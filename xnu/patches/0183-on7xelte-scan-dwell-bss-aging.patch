-/* a DHCP reply to us: true when the frame was one (it is not given to the stack) */
-static bool
-wf_dhcp_rx(const uint8_t *e, uint32_t len)
-{
-	if (len < 14 + 20 + 8 + 240 || e[12] != 0x08 || e[13] != 0x00) {
-		return false;
-	}
-	const uint8_t *ip = e + 14;
-	uint32_t ihl = (ip[0] & 15u) * 4u;
-	if ((ip[0] >> 4) != 4 || ip[9] != 17 || ihl < 20 || 14 + ihl + 8 + 240 > len) {
-		return false;
-	}
-	const uint8_t *udp = ip + ihl, *b = udp + 8;
-	if (wf_be16(udp) != 67 || wf_be16(udp + 2) != 68) {
-		return false;
-	}
-	if (b[0] != 2 || wf_be32(b + 4) != wf_dh.xid || memcmp(b + 28, wf_mac, 6) || wf_be32(b + 236) != 0x63825363) {
-		return true;
-	}
-	uint32_t type = 0, mask = 0, gw = 0, dns = 0, lease = 0, srv = 0, yi = wf_be32(b + 16);
-	const uint8_t *o = b + 240, *end = e + len;
-	while (o < end && *o != 255) {
-		if (*o == 0) {
-			o++;
-			continue;
-		}
-		if (o + 2 > end || o + 2 + o[1] > end) {
-			break;
-		}
-		uint32_t c = o[0], l = o[1];
-		const uint8_t *v = o + 2;
-		if (c == 53 && l >= 1) {
-			type = v[0];
-		} else if (c == 1 && l >= 4) {
-			mask = wf_be32(v);
-		} else if (c == 3 && l >= 4) {
-			gw = wf_be32(v);
-		} else if (c == 6 && l >= 4) {
-			dns = wf_be32(v);
-		} else if (c == 51 && l >= 4) {
-			lease = wf_be32(v);
-		} else if (c == 54 && l >= 4) {
-			srv = wf_be32(v);
-		}
-		o += 2 + l;
-	}
-	char a[16], s[16];
-	wf_ipstr(yi, a, sizeof(a));
-	wf_ipstr(srv, s, sizeof(s));
-	if (type == 2 && wf_dh.state == 1) {
-		wf_dh.offer = yi;
-		wf_dh.srv = srv;
-		wf_dh.state = 2;
-		wf_dh.tries = 0;
-		wf_dh.next = mach_absolute_time();
-		printf("USB> wifi: DHCP: OFFER %s from %s\n", a, s);
-	} else if (type == 5 && wf_dh.state == 2) {
-		wf_dh.ip = yi;
-		wf_dh.mask = mask ? mask : 0xffffff00u;
-		wf_dh.gw = gw;
-		wf_dh.dns = dns;
-		wf_dh.lease = lease;
-		if (srv) {
-			wf_dh.srv = srv;
-		}
-		wf_dh.state = 3;
-		uint32_t half = lease == 0xffffffffu ? 0 : lease / 2;
-		wf_dh.renew = half ? mach_absolute_time() + wf_ms_abs((half < 60 ? 60 : (half > 86400 ? 86400 : half)) * 1000)
-		    : 0;
-		wf_dh.apply = true;
-		char m[16], g[16], d[16];
-		wf_ipstr(wf_dh.mask, m, sizeof(m));
-		wf_ipstr(gw, g, sizeof(g));
-		wf_ipstr(dns, d, sizeof(d));
-		printf("USB> wifi: DHCP: ACK %s mask %s router %s DNS %s lease %u s (server %s)\n", a, m, g, d, lease, s);
-	} else if (type == 6) {
-		printf("USB> wifi: DHCP: NAK from %s, starting over\n", s);
-		wf_dh.state = 1;
-		wf_dh.tries = 0;
-		wf_dh.next = mach_absolute_time() + wf_ms_abs(1000);
-	}
-	return true;
-}
