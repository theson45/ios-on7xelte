-wf_a8_give_bss(const struct apple80211req *r, const struct wf_bss *e)
-{
-	struct apple80211_scan_result *x = kalloc_data(sizeof(*x), Z_WAITOK | Z_ZERO);
-	uint32_t room = sizeof(x->elements);
-	int err;
-
-	if (x == NULL) {
-		return ENOMEM;
-	}
-	if (r->req_len >= sizeof(*x) && r->req_data != USER_ADDR_NULL &&
-	    copyin(r->req_data, x, offsetof(struct apple80211_scan_result, elements)) == 0 && x->elements_length < room) {
-		room = x->elements_length;
-	}
-	bzero(x, sizeof(*x));
-	x->version = 1;
-	wf_a8_chan(&x->channel, e->chan);
-	x->rssi = e->rssi;
-	if (e->noise != 0) {
-		x->noise = e->noise;
-		x->snr = (int16_t)(e->rssi - e->noise);
-	}
-	x->beacon_interval = e->beacon;
-	x->capability = e->cap;
-	memcpy(x->bssid, e->bssid, 6);
-	x->ssid_length = e->sl;
-	memcpy(x->ssid, e->ssid, e->sl);
-	x->elements_length = (uint16_t)(e->iel <= room ? e->iel : 0);
-	memcpy(x->elements, e->ie, x->elements_length);
-	for (uint32_t at = 0; at + 2 <= e->iel && at + 2 + e->ie[at + 1] <= e->iel; at += 2 + e->ie[at + 1]) {
-		for (uint32_t i = 0; (e->ie[at] == 1 || e->ie[at] == 50) && i < e->ie[at + 1]; i++) {
-			uint32_t rate = (e->ie[at + 2 + i] & 0x7fu) / 2;
-			if (rate != 0 && rate <= 54 && x->rate_count < 15) {
-				x->rates[x->rate_count++] = rate;
-			}
-		}
-	}
-	err = wf_a8_give(r, x, sizeof(*x));
-	kfree_data(x, sizeof(*x));
-	return err;
-}
