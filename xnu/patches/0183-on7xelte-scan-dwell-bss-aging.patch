-
-	while (*a == ' ') {
-		a++;
-	}
-	if (sl <= 0) {
-		printf("USB> wifi: join SSIDHEX PASSHEX|- [save] (use tools/on7xelte-wifi-join.py)\n");
-		return;
-	}
-	if (a[0] == '-' && (a[1] == 0 || a[1] == ' ')) {
-		a++;
-	} else {
-		pl = wf_unhex(&a, pw, sizeof(pw) - 1);
-		if (pl < 8) {
-			printf("USB> wifi: join: the password must be 8..63 characters (hex)\n");
