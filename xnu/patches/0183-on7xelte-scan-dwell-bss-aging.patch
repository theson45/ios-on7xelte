+/* the firmware's capability string ("cap"): does it have the supplicant (idsup)? */
+static void
+wf_cap_show(void)
+{
+	if (wf_iovar_get("cap", 300) != 0) {
+		return;
+	}
+	char v[200];
+	uint32_t k = 0;
+	for (; k < wf_ctl_len && k < sizeof(v) - 1 && wf_ctl[k]; k++) {
+		v[k] = (wf_ctl[k] >= 0x20 && wf_ctl[k] < 0x7f) ? (char)wf_ctl[k] : ' ';
+	}
+	v[k] = 0;
+	printf("USB> wifi: cap = \"%s\"\n", v);
+}
+
+/* 'wifi link': BSSID and RSSI of the current association */
+static void
+wf_link_cmd(void)
+{
+	if (!wf_w4_ready()) {
+		return;
+	}
+	static const uint8_t z[8] = { 0 };
+	int st = wf_dcmd(23, false, z, 6);              /* WLC_GET_BSSID */
+	uint8_t b[6] = { 0 };
+	if (st == 0 && wf_ctl_len >= 6) {
+		memcpy(b, wf_ctl, 6);
+	}
+	int st2 = wf_dcmd(127, false, z, 4);            /* WLC_GET_RSSI */
+	int32_t rssi = 0;
+	if (st2 == 0 && wf_ctl_len >= 4) {
+		memcpy(&rssi, wf_ctl, 4);
+	}
+	printf("USB> wifi: link: BSSID %02x:%02x:%02x:%02x:%02x:%02x (status %d), RSSI %d (status %d)\n", b[0], b[1],
+	    b[2], b[3], b[4], b[5], st, (int)rssi, st2);
+}
+
+/*
+ * 0175, W5b: the data path. After a join the interface en0 carries IPv4 over the chip's SDPCM channel 2
+ * (BDC header 0x20, then the ethernet frame). A kernel thread owns the bus between commands: it polls the
+ * chip (frames in, events, EAPOL rekeys), sends what the stack queued (within the firmware's credit
+ * window) and runs the DHCP client. Commands from the dvfs worker take the same lock (wf_bus), so the
+ * SDIO bus is only ever driven by one thread. The ifnet follows bsd/dev/sweet_usb.c (ue0).
+ */
+static LCK_GRP_DECLARE(wf_lck_grp, "on7xelte_wifi");
+static LCK_MTX_DECLARE(wf_bus, &wf_lck_grp);           /* the SDIO bus and all W4 state */
+static LCK_MTX_DECLARE(wf_qlock, &wf_lck_grp);         /* the tx queue */
+
+#define WF_TXQ          64u
+static mbuf_t wf_txq[WF_TXQ];
+static uint32_t wf_txq_head, wf_txq_n;
+static ifnet_t wf_ifp;
+static bool wf_net_link;                /* associated, keys in: frames may go */
+static bool wf_thread_on;
+static uint8_t wf_mac[6];
+static uint64_t wf_rx_frames, wf_tx_frames, wf_rx_drop, wf_tx_drop;
+static uint32_t wf_bad_runs;
+
+static bool
+wf_txok(void)
+{
+	uint8_t d = (uint8_t)(wf_txmax - wf_txseq);
+	return d != 0 && !(d & 0x80);
+}
+
+/* a frame from channel 2 that is not EAPOL: DHCP for us, the rest to the stack */
+static bool wf_dhcp_rx(const uint8_t *e, uint32_t len);
+
+static void
+wf_net_rx(const uint8_t *e, uint32_t len)
+{
+	if (len < ETHER_HDR_LEN || len > ETHER_MAX_LEN) {
+		wf_rx_drop++;
+		return;
+	}
+	if (wf_dhcp_rx(e, len)) {
+		return;
+	}
+	if (wf_ifp == NULL || !wf_net_link) {
+		wf_rx_drop++;
+		return;
+	}
+	mbuf_t m = NULL;
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 && mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+	    (mbuf_flags(m) & MBUF_EXT) && mbuf_maxlen(m) >= len) {
+		struct ifnet_stat_increment_param stats = {};
+		memcpy(mbuf_data(m), e, len);
+		mbuf_setlen(m, len);
+		mbuf_pkthdr_setlen(m, len);
+		void *fh = mbuf_data(m);
+		mbuf_pkthdr_setrcvif(m, wf_ifp);
+		mbuf_pkthdr_setheader(m, fh);
+		mbuf_pkthdr_adjustlen(m, -ETHER_HDR_LEN);
+		(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN, mbuf_len(m) - ETHER_HDR_LEN);
+		stats.packets_in = 1;
+		stats.bytes_in = len;
+		wf_rx_frames++;
+		ifnet_input(wf_ifp, m, &stats);
+	} else {
+		if (m != NULL) {
+			mbuf_freem(m);
+		}
+		wf_rx_drop++;
+	}
+}
+
+/* one ethernet frame to the chip; the bus lock held */
+static bool
+wf_net_send(const uint8_t *frame, uint32_t len)
+{
+	static uint8_t f[4 + ETHER_MAX_LEN];
+
+	if (len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+		return false;
+	}
+	f[0] = 0x20;                    /* BDC: protocol version 2 */
+	f[1] = 0;                       /* priority (best effort) */
+	f[2] = 0;                       /* interface 0 */
+	f[3] = 0;                       /* no data offset */
+	memcpy(f + 4, frame, len);
+	return wf_sdpcm_send(2, f, 4 + len);
+}
+
+/* what the stack queued, while the firmware gives credit; the bus lock held. Returns frames sent */
+static uint32_t
+wf_net_tx(void)
+{
+	static uint8_t fr[ETHER_MAX_LEN];
+	uint32_t sent = 0;
+
+	while (wf_txok() && !wf_bad) {
+		lck_mtx_lock(&wf_qlock);
+		if (!wf_txq_n) {
+			lck_mtx_unlock(&wf_qlock);
+			break;
+		}
+		mbuf_t m = wf_txq[wf_txq_head];
+		wf_txq_head = (wf_txq_head + 1) % WF_TXQ;
+		wf_txq_n--;
+		lck_mtx_unlock(&wf_qlock);
+		size_t len = mbuf_pkthdr_len(m);
+		bool ok = len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN - ETHER_CRC_LEN &&
+		    mbuf_copydata(m, 0, len, fr) == 0;
+		mbuf_freem(m);
+		if (ok && wf_net_link && wf_net_send(fr, (uint32_t)len)) {
+			wf_tx_frames++;
+			sent++;
+		} else {
+			wf_tx_drop++;
+		}
+	}
+	return sent;
+}
+
+static void
+wf_txq_flush(void)
+{
+	lck_mtx_lock(&wf_qlock);
+	while (wf_txq_n) {
+		mbuf_freem(wf_txq[wf_txq_head]);
+		wf_txq_head = (wf_txq_head + 1) % WF_TXQ;
+		wf_txq_n--;
+		wf_tx_drop++;
+	}
+	lck_mtx_unlock(&wf_qlock);
+}
+
+static errno_t
+wf_if_output(ifnet_t ifp, mbuf_t m)
+{
+	lck_mtx_lock(&wf_qlock);
+	if (wf_txq_n == WF_TXQ || !wf_net_link) {
+		wf_tx_drop++;
+		lck_mtx_unlock(&wf_qlock);
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	ifnet_stat_increment_out(ifp, 1, (uint32_t)mbuf_pkthdr_len(m), 0);
+	wf_txq[(wf_txq_head + wf_txq_n) % WF_TXQ] = m;
+	wf_txq_n++;
+	wakeup(&wf_txq_n);
+	lck_mtx_unlock(&wf_qlock);
+	return 0;
+}
+
+static errno_t
+wf_if_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {
+		struct ifmediareq *ifmr = (struct ifmediareq *)data;
+		user_addr_t list = (cmd == SIOCGIFMEDIA64) ? ((struct ifmediareq64 *)ifmr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)ifmr)->ifmu_ulist);
+		int media = IFM_IEEE80211 | IFM_AUTO;   /* 0180: a radio (IO80211.framework lists 802.11 media only) */
+		ifmr->ifm_current = media;
+		ifmr->ifm_active = media;
+		ifmr->ifm_mask = 0;
+		ifmr->ifm_status = IFM_AVALID | (wf_net_link ? IFM_ACTIVE : 0);
+		ifmr->ifm_count = 1;
+		if (list != USER_ADDR_NULL && ifmr->ifm_count > 0) {
+			return copyout(&media, list, sizeof(media));
+		}
+		return 0;
+	}
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return wf_a8_ioctl(cmd, data);  /* 0179: SIOCGA80211/SIOCSA80211 (wifid), else EOPNOTSUPP */
+	}
+}
+
+static void
+wf_if_detach(ifnet_t ifp __unused)
+{
+}
+
+/* en0 (or the first free enN), the chip's MAC; IPv4 plumbed, no address until DHCP */
+static void
+wf_net_attach(void)
+{
+	struct ifnet_init_eparams init;
+	errno_t err = 0;
+	uint32_t unit;
+
+	if (wf_ifp != NULL) {
+		return;
+	}
+	for (unit = 0; unit < 4; unit++) {
+		bzero(&init, sizeof(init));
+		init.ver = IFNET_INIT_CURRENT_VERSION;
+		init.len = sizeof(init);
+		init.flags = IFNET_INIT_LEGACY;
+		init.uniqueid = "on7xelte-wifi";
+		init.uniqueid_len = sizeof("on7xelte-wifi") - 1;
+		init.name = "en";
+		init.unit = unit;
+		init.family = IFNET_FAMILY_ETHERNET;
+		init.type = IFT_ETHER;
+		init.subfamily = IFNET_SUBFAMILY_WIFI;  /* 0179: a radio's interface (wifid, configd) */
+		init.output = wf_if_output;
+		init.demux = ether_demux;
+		init.add_proto = ether_add_proto;
+		init.del_proto = ether_del_proto;
+		init.check_multi = ether_check_multi;
+		init.framer_extended = ether_frameout_extended;
+		init.ioctl = wf_if_ioctl;
+		init.detach = wf_if_detach;
+		init.broadcast_addr = etherbroadcastaddr;
+		init.broadcast_len = ETHER_ADDR_LEN;
+		ifnet_t ifp = NULL;
+		err = ifnet_allocate_extended(&init, &ifp);
+		if (err) {
+			continue;
+		}
+		ifnet_set_addrlen(ifp, ETHER_ADDR_LEN);
+		ifnet_set_hdrlen(ifp, sizeof(struct ether_header));
+		ifnet_set_mtu(ifp, ETHERMTU);
+		ifnet_set_baudrate(ifp, 72200000);
+		ifnet_set_flags(ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+		err = ifnet_attach(ifp, NULL);
+		if (err) {
+			ifnet_release(ifp);
+			continue;
+		}
+		static const uint8_t zero6[6] = { 0 };
+		if (!memcmp(wf_mac, zero6, 6)) {
+			/* 0179: made before the firmware runs: the board's NVRAM address (macaddr=00:90:4c:c5:12:38),
+			 * which the firmware reports as cur_etheraddr too; the join sets what it reports */
+			static const uint8_t nv[6] = { 0x00, 0x90, 0x4c, 0xc5, 0x12, 0x38 };
+			memcpy(wf_mac, nv, 6);
+		}
+		ifnet_set_lladdr(ifp, wf_mac, ETHER_ADDR_LEN);
+		wf_ifp = ifp;
+		break;
+	}
+	if (wf_ifp == NULL) {
+		printf("USB> wifi: NET: no interface (ifnet error %d)\n", err);
+		return;
+	}
+	err = proto_plumb(PF_INET, wf_ifp);
+	ifnet_set_flags(wf_ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	printf("USB> wifi: NET: %s%u attached, MAC %02x:%02x:%02x:%02x:%02x:%02x, IPv4 plumbed (%d)\n", ifnet_name(wf_ifp),
+	    ifnet_unit(wf_ifp), wf_mac[0], wf_mac[1], wf_mac[2], wf_mac[3], wf_mac[4], wf_mac[5], err);
+}
+
+static void
+wf_net_link_set(bool up)
+{
+	if (wf_net_link == up) {
+		return;
+	}
+	wf_net_link = up;
+	if (!up) {
+		wf_txq_flush();
+	}
+	if (wf_ifp != NULL) {
+		dlil_post_msg(wf_ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
+	}
+	printf("USB> wifi: NET: link %s\n", up ? "up" : "down");
+	wf_a8_link(up);                         /* 0179: told to wifid */
+}
+
+/* ---- DHCP (RFC 2131), on raw frames: the interface has no address before it ---- */
+static struct {
+	uint32_t state;                 /* 0 idle, 1 DISCOVER sent, 2 REQUEST sent, 3 bound */
+	uint32_t xid, tries;
+	uint32_t offer, srv, ip, mask, gw, dns, lease;
+	uint32_t set_ip;                /* the address the interface has (host order), 0 none */
+	bool apply;                     /* the thread puts the lease on en0 (outside the bus lock) */
+	uint64_t next, renew;           /* mach_absolute_time */
+} wf_dh;
+
+static uint64_t
+wf_ms_abs(uint32_t ms)
+{
+	uint64_t a;
+	nanoseconds_to_absolutetime((uint64_t)ms * 1000000ull, &a);
+	return a;
+}
+
+static uint16_t
+wf_ipsum(const uint8_t *p, uint32_t n)
+{
+	uint32_t s = 0;
+	for (uint32_t i = 0; i + 1 < n; i += 2) {
+		s += (uint32_t)p[i] << 8 | p[i + 1];
+	}
+	if (n & 1) {
+		s += (uint32_t)p[n - 1] << 8;
+	}
+	while (s >> 16) {
+		s = (s & 0xffff) + (s >> 16);
+	}
+	return (uint16_t)~s;
+}
+
+static void
+wf_put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)(v >> 24);
+	p[1] = (uint8_t)(v >> 16);
+	p[2] = (uint8_t)(v >> 8);
+	p[3] = (uint8_t)v;
+}
+
+static void
+wf_ipstr(uint32_t a, char *s, size_t n)
+{
+	snprintf(s, n, "%u.%u.%u.%u", a >> 24, (a >> 16) & 0xff, (a >> 8) & 0xff, a & 0xff);
+}
+
+/* DISCOVER (type 1) or REQUEST (type 3), broadcast; the bus lock held */
+static bool
+wf_dhcp_send(uint32_t type)
+{
+	static uint8_t f[14 + 20 + 8 + 300];
+	uint8_t *ip = f + 14, *udp = ip + 20, *b = udp + 8;
+
+	bzero(f, sizeof(f));
+	memset(f, 0xff, 6);
+	memcpy(f + 6, wf_mac, 6);
+	f[12] = 0x08;
+	f[13] = 0x00;
+	b[0] = 1;                       /* BOOTREQUEST */
+	b[1] = 1;                       /* ethernet */
+	b[2] = 6;
+	wf_put32(b + 4, wf_dh.xid);
+	b[10] = 0x80;                   /* the broadcast flag: we cannot take unicast before we have the address */
+	memcpy(b + 28, wf_mac, 6);
+	wf_put32(b + 236, 0x63825363);  /* magic cookie */
+	uint8_t *o = b + 240;
+	*o++ = 53;
+	*o++ = 1;
+	*o++ = (uint8_t)type;
+	*o++ = 61;                      /* client identifier: type 1, the MAC */
+	*o++ = 7;
+	*o++ = 1;
+	memcpy(o, wf_mac, 6);
+	o += 6;
+	if (type == 3) {
+		*o++ = 50;              /* requested address */
+		*o++ = 4;
+		wf_put32(o, wf_dh.offer);
+		o += 4;
+		*o++ = 54;              /* server identifier */
+		*o++ = 4;
+		wf_put32(o, wf_dh.srv);
+		o += 4;
+	}
+	*o++ = 12;                      /* host name */
+	*o++ = 6;
+	memcpy(o, "iPhone", 6);
+	o += 6;
+	*o++ = 55;                      /* parameters: mask, router, DNS, domain, lease, server */
+	*o++ = 6;
+	*o++ = 1;
+	*o++ = 3;
+	*o++ = 6;
+	*o++ = 15;
+	*o++ = 51;
+	*o++ = 54;
+	*o++ = 255;
+	uint32_t blen = 300, ulen = 8 + blen, ilen = 20 + ulen;
+	ip[0] = 0x45;
+	ip[2] = (uint8_t)(ilen >> 8);
+	ip[3] = (uint8_t)ilen;
+	ip[8] = 64;
+	ip[9] = 17;                     /* UDP */
+	memset(ip + 16, 0xff, 4);       /* from 0.0.0.0 to 255.255.255.255 */
+	uint16_t cs = wf_ipsum(ip, 20);
+	ip[10] = (uint8_t)(cs >> 8);
+	ip[11] = (uint8_t)cs;
+	udp[1] = 68;
+	udp[3] = 67;
+	udp[4] = (uint8_t)(ulen >> 8);
+	udp[5] = (uint8_t)ulen;         /* UDP checksum 0: none */
+	return wf_net_send(f, 14 + ilen);
+}
+
+static void
+wf_dhcp_start(void)
+{
+	uint32_t x;
+	read_random(&x, sizeof(x));
+	wf_dh.xid = x;
+	wf_dh.state = 1;
+	wf_dh.tries = 0;
+	wf_dh.next = mach_absolute_time();
+	printf("USB> wifi: DHCP: started\n");
+}
+
+/* the thread's timer: (re)sends, gives up, renews; the bus lock held */
+static void
+wf_dhcp_tick(void)
+{
+	uint64_t now = mach_absolute_time();
+
+	if (!wf_net_link) {
+		return;
+	}
+	if (wf_dh.state == 3 && wf_dh.renew && now >= wf_dh.renew) {
+		wf_dh.offer = wf_dh.ip;         /* renewal: the same address asked for again */
+		wf_dh.state = 2;
+		wf_dh.tries = 0;
+		wf_dh.next = now;
+		printf("USB> wifi: DHCP: renewing\n");
+	}
+	if ((wf_dh.state != 1 && wf_dh.state != 2) || now < wf_dh.next) {
+		return;
+	}
+	if (wf_dh.tries >= 8) {
+		if (wf_dh.state == 2 && wf_dh.set_ip) {
+			wf_dh.state = 3;        /* a renewal that got no answer: keep the lease, ask again later */
+			wf_dh.renew = now + wf_ms_abs(60000);
+			return;
+		}
+		printf("USB> wifi: DHCP: no answer after %u tries ('wifi dhcp' to try again)\n", wf_dh.tries);
+		wf_dh.state = 0;
+		return;
+	}
+	if (wf_dh.state == 2 && wf_dh.tries == 5 && !wf_dh.set_ip) {
+		wf_dh.state = 1;                /* no ACK: start over */
+		wf_dh.tries = 0;
+	}
+	bool ok = wf_dhcp_send(wf_dh.state == 1 ? 1 : 3);
+	printf("USB> wifi: DHCP: %s %s (try %u)\n", wf_dh.state == 1 ? "DISCOVER" : "REQUEST", ok ? "sent" : "send FAILED",
+	    wf_dh.tries + 1);
+	wf_dh.tries++;
+	wf_dh.next = now + wf_ms_abs(wf_dh.tries < 3 ? 2000 : 4000);
+}
+
+/* a DHCP reply to us: true when the frame was one (it is not given to the stack) */
+static bool
+wf_dhcp_rx(const uint8_t *e, uint32_t len)
+{
+	if (len < 14 + 20 + 8 + 240 || e[12] != 0x08 || e[13] != 0x00) {
+		return false;
+	}
+	const uint8_t *ip = e + 14;
+	uint32_t ihl = (ip[0] & 15u) * 4u;
+	if ((ip[0] >> 4) != 4 || ip[9] != 17 || ihl < 20 || 14 + ihl + 8 + 240 > len) {
+		return false;
+	}
+	const uint8_t *udp = ip + ihl, *b = udp + 8;
+	if (wf_be16(udp) != 67 || wf_be16(udp + 2) != 68) {
+		return false;
+	}
+	if (b[0] != 2 || wf_be32(b + 4) != wf_dh.xid || memcmp(b + 28, wf_mac, 6) || wf_be32(b + 236) != 0x63825363) {
+		return true;
+	}
+	uint32_t type = 0, mask = 0, gw = 0, dns = 0, lease = 0, srv = 0, yi = wf_be32(b + 16);
+	const uint8_t *o = b + 240, *end = e + len;
+	while (o < end && *o != 255) {
+		if (*o == 0) {
+			o++;
+			continue;
+		}
+		if (o + 2 > end || o + 2 + o[1] > end) {
+			break;
+		}
+		uint32_t c = o[0], l = o[1];
+		const uint8_t *v = o + 2;
+		if (c == 53 && l >= 1) {
+			type = v[0];
+		} else if (c == 1 && l >= 4) {
+			mask = wf_be32(v);
+		} else if (c == 3 && l >= 4) {
+			gw = wf_be32(v);
+		} else if (c == 6 && l >= 4) {
+			dns = wf_be32(v);
+		} else if (c == 51 && l >= 4) {
+			lease = wf_be32(v);
+		} else if (c == 54 && l >= 4) {
+			srv = wf_be32(v);
+		}
+		o += 2 + l;
+	}
+	char a[16], s[16];
+	wf_ipstr(yi, a, sizeof(a));
+	wf_ipstr(srv, s, sizeof(s));
+	if (type == 2 && wf_dh.state == 1) {
+		wf_dh.offer = yi;
+		wf_dh.srv = srv;
+		wf_dh.state = 2;
+		wf_dh.tries = 0;
+		wf_dh.next = mach_absolute_time();
+		printf("USB> wifi: DHCP: OFFER %s from %s\n", a, s);
+	} else if (type == 5 && wf_dh.state == 2) {
+		wf_dh.ip = yi;
+		wf_dh.mask = mask ? mask : 0xffffff00u;
+		wf_dh.gw = gw;
+		wf_dh.dns = dns;
+		wf_dh.lease = lease;
+		if (srv) {
+			wf_dh.srv = srv;
+		}
+		wf_dh.state = 3;
+		uint32_t half = lease == 0xffffffffu ? 0 : lease / 2;
+		wf_dh.renew = half ? mach_absolute_time() + wf_ms_abs((half < 60 ? 60 : (half > 86400 ? 86400 : half)) * 1000)
+		    : 0;
+		wf_dh.apply = true;
+		char m[16], g[16], d[16];
+		wf_ipstr(wf_dh.mask, m, sizeof(m));
+		wf_ipstr(gw, g, sizeof(g));
+		wf_ipstr(dns, d, sizeof(d));
+		printf("USB> wifi: DHCP: ACK %s mask %s router %s DNS %s lease %u s (server %s)\n", a, m, g, d, lease, s);
+	} else if (type == 6) {
+		printf("USB> wifi: DHCP: NAK from %s, starting over\n", s);
+		wf_dh.state = 1;
+		wf_dh.tries = 0;
+		wf_dh.next = mach_absolute_time() + wf_ms_abs(1000);
+	}
+	return true;
+}
+
+static void
+wf_sin(struct sockaddr_in *a, uint32_t v)
+{
+	bzero(a, sizeof(*a));
+	a->sin_len = sizeof(*a);
+	a->sin_family = AF_INET;
+	a->sin_addr.s_addr = htonl(v);
+}
+
+/* the default route through the router (a PF_ROUTE message, as route(8) sends it) */
+static int
+wf_route(uint32_t gw)
+{
+	struct {
+		struct rt_msghdr h;
+		struct sockaddr_in dst, gw, mask;
+	} m;
+	socket_t so = NULL;
+	int err = sock_socket(PF_ROUTE, SOCK_RAW, 0, NULL, NULL, &so);
+
+	if (err) {
+		return err;
+	}
+	for (int pass = 0; pass < 2; pass++) {
+		bzero(&m, sizeof(m));
+		m.h.rtm_msglen = sizeof(m);
+		m.h.rtm_version = RTM_VERSION;
+		m.h.rtm_type = pass ? RTM_CHANGE : RTM_ADD;
+		m.h.rtm_flags = RTF_UP | RTF_GATEWAY | RTF_STATIC;
+		m.h.rtm_addrs = RTA_DST | RTA_GATEWAY | RTA_NETMASK;
+		m.h.rtm_seq = pass + 1;
+		wf_sin(&m.dst, 0);
+		wf_sin(&m.gw, gw);
+		wf_sin(&m.mask, 0);
+		struct iovec iov = { .iov_base = &m, .iov_len = sizeof(m) };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t sent = 0;
+		err = sock_send(so, &msg, 0, &sent);
+		if (err != EEXIST) {
+			break;
+		}
+	}
+	sock_close(so);
+	return err;
+}
+
+/* the lease on the interface; the thread, without the bus lock */
+static void
+wf_dhcp_apply(void)
+{
+	socket_t so = NULL;
+	int e1 = -1, e2 = -1, e0 = 0;
+	uint32_t ip = wf_dh.ip, mask = wf_dh.mask, gw = wf_dh.gw;
+
+	if (wf_ifp == NULL) {
+		return;
+	}
+	int err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	if (err == 0) {
+		if (wf_dh.set_ip && wf_dh.set_ip != ip) {
+			struct ifreq ifr;
+			bzero(&ifr, sizeof(ifr));
+			snprintf(ifr.ifr_name, sizeof(ifr.ifr_name), "%s%u", ifnet_name(wf_ifp), ifnet_unit(wf_ifp));
+			wf_sin((struct sockaddr_in *)&ifr.ifr_addr, wf_dh.set_ip);
+			e0 = sock_ioctl(so, SIOCDIFADDR, &ifr);
+			wf_dh.set_ip = 0;
+		}
+		struct ifaliasreq ifra;
+		bzero(&ifra, sizeof(ifra));
+		snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "%s%u", ifnet_name(wf_ifp), ifnet_unit(wf_ifp));
+		wf_sin((struct sockaddr_in *)&ifra.ifra_addr, ip);
+		wf_sin((struct sockaddr_in *)&ifra.ifra_mask, mask);
+		wf_sin((struct sockaddr_in *)&ifra.ifra_broadaddr, (ip & mask) | ~mask);
+		e1 = sock_ioctl(so, SIOCAIFADDR, &ifra);
+		sock_close(so);
+		if (e1 == 0) {
+			wf_dh.set_ip = ip;
+		}
+	}
+	if (e1 == 0 && gw) {
+		e2 = wf_route(gw);
+	}
+	char a[16], g[16];
+	wf_ipstr(ip, a, sizeof(a));
+	wf_ipstr(gw, g, sizeof(g));
+	printf("USB> wifi: NET: %s%u address %s (%d%s), default route via %s (%d)\n", ifnet_name(wf_ifp), ifnet_unit(wf_ifp),
+	    a, err ? err : e1, e0 ? ", old address delete failed" : "", g, e2);
+}
+
+/* the bus between commands: polled every few ms, at once while there is traffic */
+static void
+wf_net_thread(void *a __unused, wait_result_t w __unused)
+{
+	struct timespec ts = { 0, 4 * 1000 * 1000 };
+
+	for (;;) {
+		bool busy = false, apply = false;
+		lck_mtx_lock(&wf_bus);
+		if (wf_fwup && wf_w4init && wf_mmc && wf_sd()) {
+			bool was = wf_bad;
+			wf_bad = false;
+			uint64_t n0 = wf_rxn;
+			wf_poll();
+			wf_hs_step();
+			uint32_t sent = wf_net_tx();
+			wf_dhcp_tick();
+			busy = wf_rxn != n0 || sent;
+			if (wf_bad) {
+				if (!was && wf_bad_runs < 10) {
+					printf("USB> wifi: NET: a bus access failed in the poll thread\n");
+				}
+				wf_bad_runs++;
+				busy = false;
+			}
+			apply = wf_dh.apply;
+			wf_dh.apply = false;
+		}
+		lck_mtx_unlock(&wf_bus);
+		if (apply) {
+			wf_dhcp_apply();
+		}
+		if (!busy) {
+			lck_mtx_lock(&wf_qlock);
+			if (!wf_txq_n || !wf_txok()) {
+				(void)msleep(&wf_txq_n, &wf_qlock, PZERO, "wifinet", &ts);
+			}
+			lck_mtx_unlock(&wf_qlock);
+		}
+	}
+}
+
+/* after a join: en0, the link up, the poll thread, DHCP. The bus lock held */
+static void
+wf_net_up(void)
+{
+	wf_net_attach();
+	wf_net_link_set(true);
+	if (!wf_thread_on) {
+		thread_t t;
+		if (kernel_thread_start(wf_net_thread, NULL, &t) == KERN_SUCCESS) {
+			thread_deallocate(t);
+			wf_thread_on = true;
+		} else {
+			printf("USB> wifi: NET: the poll thread did not start\n");
+		}
+	}
+	wf_dhcp_start();
+}
+
+/* a link event after the join (the join loop takes them itself); false before en0 exists */
+static bool
+wf_net_event(uint32_t type, uint32_t status, uint32_t reason, uint32_t flags)
+{
+	if (wf_ifp == NULL) {
+		return false;
+	}
+	if (type == 16) {                       /* WLC_E_LINK */
+		printf("USB> wifi: NET: LINK event, %s (reason %u)\n", (flags & 1) ? "up" : "down", reason);
+		if (!(flags & 1) || wf_hs.keys_set || !wf_hs.on) {
+			wf_net_link_set(flags & 1);
+		}
+	} else if (type == 5 || type == 6 || type == 11 || type == 12) {
+		printf("USB> wifi: NET: %s (%u) status %u reason %u\n", wf_evname(type), type, status, reason);
+		wf_net_link_set(false);
+	}
+	return true;
+}
+
+static void
+wf_net_cmd(void)
+{
+	char a[16], m[16], g[16], d[16];
+	wf_ipstr(wf_dh.ip, a, sizeof(a));
+	wf_ipstr(wf_dh.mask, m, sizeof(m));
+	wf_ipstr(wf_dh.gw, g, sizeof(g));
+	wf_ipstr(wf_dh.dns, d, sizeof(d));
+	printf("USB> wifi: NET: %s%u link %u thread %u; DHCP state %u: %s mask %s router %s DNS %s lease %u (on en: %u)\n",
+	    wf_ifp ? ifnet_name(wf_ifp) : "-", wf_ifp ? ifnet_unit(wf_ifp) : 0, wf_net_link, wf_thread_on, wf_dh.state, a, m,
+	    g, d, wf_dh.lease, wf_dh.set_ip != 0);
+	printf("USB> wifi: NET: rx %llu (dropped %llu), tx %llu (dropped %llu), queued %u, txseq %u window %u, poll bus errors %u\n",
+	    wf_rx_frames, wf_rx_drop, wf_tx_frames, wf_tx_drop, wf_txq_n, wf_txseq, wf_txmax, wf_bad_runs);
+	printf("USB> wifi: NET: rx superframes %llu (subframes %llu, bad %u)\n", wf_glom_frames, wf_glom_subs, wf_glom_bad);
+}
+
+/*
+ * 0178: the saved network, for auto-join at boot (on7wifid, kern.on7xelte_wifi "auto"): its SSID and PMK (the
+ * PBKDF2 of the password, never the password), root only (0600) on the root. 'wifi join ... save' writes it after
+ * a join that worked, 'wifi forget' overwrites it with zeros and empties it. Neither is ever printed.
+ */
+#define WF_KEY_PATH     "/private/var/db/on7xelte-wifi.bin"
+struct wf_saved {
+	char magic[4];                  /* "O7WF" */
+	uint8_t ver, sl, sec, pad;      /* 1; SSID length; WPA2-PSK */
+	uint8_t ssid[32];
+	uint8_t pmk[32];
+};
+static bool wf_auto_off;                /* 'wifi off' by hand: no auto-join until the next join */
+static uint64_t wf_auto_hold;           /* 0179: wifid left the network: no auto-join before this */
+
+static int
+wf_key_write(const void *buf, int len, off_t size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	int left = 0, err, e2;
+
+	if (rootvnode == NULLVP) {
+		return ENOENT;
+	}
+	err = vnode_open(WF_KEY_PATH, O_CREAT | FWRITE, 0600, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, 0600);
+	VATTR_SET(&va, va_uid, 0);
+	VATTR_SET(&va, va_gid, 0);
+	e2 = vnode_setattr(vp, &va, ctx);
+	err = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)buf, len, 0, UIO_SYSSPACE, IO_SYNC, vfs_context_ucred(ctx), &left,
+	    vfs_context_proc(ctx));
+	if (!err && left) {
+		err = EIO;
+	}
+	if (!err) {
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_data_size, size);
+		err = vnode_setattr(vp, &va, ctx);
+	}
+	if (!err) {
+		err = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+	vnode_close(vp, FWRITE, ctx);
+	return err ? err : e2;
+}
+
+/* the saved network, or false */
+static bool
+wf_key_read(struct wf_saved *k)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	int left = 0, err;
+	bool ok = false;
+
+	bzero(k, sizeof(*k));
+	if (rootvnode == NULLVP || vnode_lookup(WF_KEY_PATH, VNODE_LOOKUP_NOFOLLOW, &vp, ctx) != 0) {
+		return false;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	if (vnode_getattr(vp, &va, ctx) == 0 && va.va_data_size == sizeof(*k)) {
+		err = vn_rdwr(UIO_READ, vp, (caddr_t)k, (int)sizeof(*k), 0, UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &left,
+		    vfs_context_proc(ctx));
+		ok = err == 0 && left == 0 && !memcmp(k->magic, "O7WF", 4) && k->ver == 1 && k->sl >= 1 && k->sl <= 32;
+	}
+	vnode_put(vp);
+	if (!ok) {
+		bzero(k, sizeof(*k));
+	}
+	return ok;
+}
+
+static void
+wf_ssid_name(const uint8_t *ssid, int sl, char name[33])
+{
+	for (int k = 0; k < sl; k++) {
+		name[k] = (ssid[k] >= 0x20 && ssid[k] < 0x7f) ? (char)ssid[k] : '?';
+	}
+	name[sl] = 0;
+}
+
+/*
+ * The join: WPA2-PSK (AES) with the host handshake (a password, or spmk: a saved PMK), or an open network.
+ * save: the network kept for auto-join once the join worked.
+ */
+static bool
+wf_join(const uint8_t *ssid, int sl, const uint8_t *pw, int pl, const uint8_t *spmk, bool save)
+{
+	bool sec = pl > 0 || spmk != NULL;
+	char name[33];
+
+	wf_j_why = 2;
+	wf_ssid_name(ssid, sl, name);
+	if (!wf_w4_ready()) {
+		return false;
+	}
+	printf("USB> wifi: JOIN \"%s\" (%s)\n", name, sec ? (spmk ? "WPA2-PSK, saved key, host handshake" :
+	    "WPA2-PSK, host handshake") : "open");
+	wf_cap_show();
+	int up = wf_ioc_int(WLC_UP, 0);
+	/* 0176: no rx superframes (SDPCM channel 3, glom; xnu60 dropped them): one frame per read */
+	int glom = wf_iovar_int("bus:rxglom", 0);
+	printf("USB> wifi: JOIN: bus:rxglom 0, status %d\n", glom);
+	/* events of a join on, ESCAN kept */
+	int em = wf_iovar_get("event_msgs", 16);
+	if (em == 0 && wf_ctl_len >= 16) {
+		static const uint8_t ev[] = { 0, 1, 3, 5, 6, 7, 9, 11, 12, 16, 46, 69 };
+		uint8_t mask[16];
+		memcpy(mask, wf_ctl, 16);
+		for (uint32_t k = 0; k < sizeof(ev); k++) {
+			mask[ev[k] / 8] |= (uint8_t)(1u << (ev[k] % 8));
+		}
+		em = wf_iovar_set("event_msgs", mask, 16);
+	}
+	int infra = wf_ioc_int(20, 1);                  /* WLC_SET_INFRA: BSS */
+	int auth = wf_ioc_int(22, 0);                   /* WLC_SET_AUTH: open system */
+	int wsec = wf_ioc_int(134, sec ? 4u : 0u);      /* WLC_SET_WSEC: AES */
+	int wpa = wf_ioc_int(165, sec ? 0x80u : 0u);    /* WLC_SET_WPA_AUTH: WPA2_AUTH_PSK */
+	/* 0174: this firmware has no supplicant (sup_wpa -23, xnu57): the host does the handshake */
+	int sup = wf_iovar_int("sup_wpa", 0);
+	int mac = wf_iovar_get("cur_etheraddr", 8);
+	uint64_t ms = 0;
+	wf_hs_clear();
+	wf_net_link_set(false);
+	if (mac == 0 && wf_ctl_len >= 6) {
+		memcpy(wf_hs.spa, wf_ctl, 6);
+		memcpy(wf_mac, wf_ctl, 6);
+		if (wf_ifp != NULL) {
+			ifnet_set_lladdr(wf_ifp, wf_mac, ETHER_ADDR_LEN);       /* 0179: en0 may be older */
+		}
+	} else {
+		mac = mac ? mac : -1;
+	}
+	if (sec) {
+		uint64_t p0 = mach_absolute_time();
+		if (spmk) {
+			memcpy(wf_hs.pmk, spmk, 32);
+		} else {
+			wf_pmk(pw, (uint32_t)pl, ssid, (uint32_t)sl, wf_hs.pmk);
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - p0, &ms);
+		ms /= 1000000;
+		wf_hs.on = mac == 0;
+	}
+	printf("USB> wifi: JOIN setup: up %d event_msgs %d infra %d auth %d wsec %d wpa_auth %d sup_wpa %d mac %d%s\n", up,
+	    em, infra, auth, wsec, wpa, sup, mac, sec ? (spmk ? "; saved PMK" : "; PMK computed") : "");
+	if (sec && !spmk) {
+		printf("USB> wifi: JOIN: PBKDF2 took %llu ms\n", ms);
+	}
+	if (up == -999 || infra == -999 || (sec && !wf_hs.on)) {
+		wf_hs_clear();
+		return false;
+	}
+	uint8_t sj[36];
+	bzero(sj, sizeof(sj));
+	sj[0] = (uint8_t)sl;
+	memcpy(sj + 4, ssid, (size_t)sl);
+	wf_j_link = wf_j_keyed = wf_j_fail = wf_j_ssid = 0;
+	wf_joining = true;
+	int st = wf_dcmd(26, true, sj, sizeof(sj));     /* WLC_SET_SSID */
+	printf("USB> wifi: JOIN: SET_SSID status %d\n", st);
+	uint64_t t0 = mach_absolute_time(), ns = 0;
+	for (int t = 0; st == 0 && t < 10000 && !wf_bad && !wf_j_fail && !(wf_j_link && (wf_hs.keys_set || !sec)); t++) {
+		wf_poll();
+		wf_hs_step();
+		delay(2000);
+	}
+	wf_joining = false;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	bool ok = wf_j_link && (wf_hs.keys_set || !sec);
+	printf("USB> wifi: JOIN %s after %llu ms (link %u keys %u EAPOL steps 0x%02x fail %u set_ssid %u)%s\n",
+	    ok ? "DONE: associated" : "FAILED", ns / 1000000, wf_j_link, wf_hs.keys_set, wf_hs.steps, wf_j_fail, wf_j_ssid,
+	    wf_bad ? " (a bus access failed)" : "");
+	if (ok) {
+		wf_auto_off = false;
+		if (save) {
+			struct wf_saved k;
+			bzero(&k, sizeof(k));
+			memcpy(k.magic, "O7WF", 4);
+			k.ver = 1;
+			k.sl = (uint8_t)sl;
+			k.sec = sec;
+			memcpy(k.ssid, ssid, (size_t)sl);
+			if (sec) {
+				memcpy(k.pmk, wf_hs.pmk, 32);
+			}
+			int err = wf_key_write(&k, (int)sizeof(k), (off_t)sizeof(k));
+			bzero(&k, sizeof(k));
+			printf("USB> wifi: JOIN: \"%s\" saved for auto-join (%s, root only): %d\n", name, WF_KEY_PATH, err);
+		}
+		wf_link_cmd();
+		wf_a8_joined(ssid, sl, sec);    /* 0179: before the link goes up (wifid is told then) */
+		wf_net_up();                    /* 0175: the handshake stays on for rekeys */
+	} else {
+		/* 0179: keys asked for and none agreed on: the password; nothing went wrong but time: a timeout */
+		wf_j_why = sec && (wf_hs.steps || wf_j_link) ? 21 : (!wf_j_fail && !wf_bad && st == 0) ? 9 : 2;
+		wf_hs_clear();
+	}
+	return ok;
+}
+
+/*
+ * 'wifi join SSIDHEX PASSHEX|- [save]' (sent by tools/on7xelte-wifi-join.py; the echo lines hide the arguments).
+ */
+static void
+wf_join_cmd(const char *a)
+{
+	uint8_t ssid[32], pw[64];
+	int sl = wf_unhex(&a, ssid, sizeof(ssid)), pl = 0;
+
+	while (*a == ' ') {
+		a++;
+	}
+	if (sl <= 0) {
+		printf("USB> wifi: join SSIDHEX PASSHEX|- [save] (use tools/on7xelte-wifi-join.py)\n");
+		return;
+	}
+	if (a[0] == '-' && (a[1] == 0 || a[1] == ' ')) {
+		a++;
+	} else {
+		pl = wf_unhex(&a, pw, sizeof(pw) - 1);
+		if (pl < 8) {
+			printf("USB> wifi: join: the password must be 8..63 characters (hex)\n");
+			bzero(pw, sizeof(pw));
+			return;
+		}
+	}
+	while (*a == ' ') {
+		a++;
+	}
+	bool save = !strcmp(a, "save");
+	(void)wf_join(ssid, sl, pw, pl, NULL, save);
+	bzero(pw, sizeof(pw));
+}
+
+/* 'wifi forget': the saved network overwritten with zeros, the file emptied */
+static void
+wf_forget_cmd(void)
+{
+	struct wf_saved k;
+	bool had = wf_key_read(&k);
+	bzero(&k, sizeof(k));
+	int err = had ? wf_key_write(&k, (int)sizeof(k), 0) : 0;
+	printf("USB> wifi: FORGET: %s (%d)\n", had ? "the saved network cleared" : "no saved network", err);
+}
+
+static void
+wf_saved_cmd(void)
+{
+	struct wf_saved k;
+	char name[33];
+	if (wf_key_read(&k)) {
+		wf_ssid_name(k.ssid, k.sl, name);
+		printf("USB> wifi: SAVED: \"%s\" (%s); auto-join %s\n", name, k.sec ? "WPA2-PSK" : "open",
+		    wf_auto_off ? "off ('wifi off' by hand)" : "on");
+	} else {
+		printf("USB> wifi: SAVED: none\n");
+	}
+	bzero(&k, sizeof(k));
+}
+
+/* 'auto' (on7wifid at boot and while there is no link): firmware up, then the saved network. 0 = a link */
+static int
+wf_auto(void)
+{
+	struct wf_saved k;
+	int ret;
+
+	if (wf_auto_off || mach_absolute_time() < wf_auto_hold) {
+		return ECANCELED;
+	}
+	if (wf_fwup && wf_net_link) {
+		return 0;
+	}
+	if (!wf_key_read(&k)) {
+		return ENOENT;
+	}
+	if (!wf_fwup) {
+		printf("USB> wifi: AUTO: firmware\n");
+		wf_bus4 = true;
+		wf_fw();
+	}
+	if (!wf_fwup) {
+		ret = EIO;
+	} else {
+		ret = wf_join(k.ssid, k.sl, NULL, 0, k.sec ? k.pmk : NULL, false) ? 0 : ETIMEDOUT;
+	}
+	bzero(&k, sizeof(k));
+	return ret;
+}
+
+/*
+ * ---- 0179: Apple80211, answered in the kernel ----
+ * iOS's Wi-Fi side (wifid, and through it Settings and the status bar) talks to a Wi-Fi driver with
+ * SIOCGA80211/SIOCSA80211 on any socket: a struct apple80211req naming the interface, a request type, a value
+ * and a buffer in the caller's memory. XNU hands an interface ioctl it does not know to the interface: en0's
+ * wf_if_ioctl passes them here. After y2sios kernel/xnu/files/bsd/dev/redwood_apple80211.c (MIT), which has
+ * the request types and the layouts of iOS 16.5 (read out of IO80211.framework) and the events (kernel events
+ * of class 6, subclass 1, code = Apple80211's event, the interface's name first in 16 bytes).
+ *
+ * A request is answered at once from what is known (the radio's power, the channels, the last scan, the
+ * network joined); a scan, a join, leaving and the power are done by a thread of its own (wf_a8_thread, under
+ * the bus lock), which tells how it went with an event: SCAN_DONE, ASSOC_DONE (then ASSOCIATE_RESULT: 1 ok,
+ * 21 a wrong key, 9 a timeout, 2 else), POWER; the link's changes (wf_net_link_set) as SSID, BSSID and LINK.
+ * A network joined from Settings is saved for auto-join at boot (on7wifid) like 'wifi join ... save'.
+ * Every request is logged (who, get or set, the type, the value, the length), never what it carries.
+ */
+#define SIOCSA80211             0x802869c8u     /* _IOW('i', 200, struct apple80211req) */
+#define SIOCGA80211             0xc02869c9u     /* _IOWR('i', 201, struct apple80211req) */
+
+struct apple80211req {
+	char req_if_name[16];
+	int32_t req_type;
+	int32_t req_val;
+	uint32_t req_len;
+	user_addr_t req_data __attribute__((aligned(8)));
+};
+
+#define A8_CH_20MHZ             0x2u
+#define A8_CH_2GHZ              0x8u
+#define A8_CH_ACTIVE            0x80u
+
+struct apple80211_channel {
+	uint32_t version, channel, flags;
+};
+
+/* SUPPORTED_CHANNELS (27), HW_SUPPORTED_CHANNELS (254) */
+struct apple80211_channels {
+	uint32_t version, count;
+	struct apple80211_channel channels[401];
+	uint32_t unused;
+};
+
+/* CHANNELS_INFO (207) */
+struct apple80211_channels_info {
+	uint8_t unknown_0[12];
+	uint16_t count;
+	uint8_t unknown_1[800];
+	uint8_t number[400], indoor[400], dfs[400], passive[400], wide_40[400], wide_80[400];
+	uint8_t unknown_2[1602];
+	uint32_t flags[400];
+	uint8_t unknown_3[3600];
+} __attribute__((packed));
+
+/* SCAN_REQ (10) */
+struct apple80211_scan_request {
+	uint32_t version, bss_type;
+	uint8_t bssid[6], unused_0[2];
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint32_t scan_type;
+	uint32_t phy_mode;
+	uint16_t dwell_ms, unused_1;
+	uint32_t rest_ms;
+	uint32_t channel_count;
+	struct apple80211_channel channels[400];
+	uint64_t flags;
+	uint32_t unused_2;
+	uint32_t name_count;
+	uint8_t names[10][56];
+	uint32_t short_ssid, unused_3;
+};
+
+/* SCAN_RESULT (11), CURRENT_NETWORK (103) */
+struct apple80211_scan_result {
+	uint32_t version;
+	struct apple80211_channel channel;
+	uint16_t noise_known;
+	int16_t noise, snr, rssi;
+	uint16_t beacon_interval, capability;
+	uint8_t bssid[6];
+	uint8_t rate_count, unused_0;
+	uint32_t rates[15];
+	uint8_t ssid_length, ssid[32], unused_1[3];
+	uint32_t age_ms;
+	uint8_t flags, unused_2;
+	uint16_t elements_length;               /* comes in as the room there is */
+	uint8_t elements[1024];
+};
+
+/* ASSOCIATE (20) */
+struct apple80211_assoc {
+	uint32_t version;
+	uint16_t mode, auth_lower, auth_upper, unused_0;
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint8_t bssid[6], unused_1[2];
+	uint32_t key_version, key_length, key_cipher;   /* 10: a passphrase as typed; 6: the PMK */
+	uint16_t key_flags, key_index;
+	uint8_t key[64];
+	uint8_t rest[0x250 - 0x88];
+};
+#define A8_CIPHER_PMK           6
+#define A8_CIPHER_PASSPHRASE    10
+
+/* the link event's data (at least 32 bytes, or the framework drops it) */
+struct apple80211_link_changed {
+	uint8_t down, unused_0[3];
+	int32_t rssi;
+	uint16_t snr, noise;
+	uint8_t unused_1[4];
+	uint8_t involuntary, unused_2[3];
+	uint32_t reason, subreason;
+	uint8_t unused_3[4];
+};
+
+_Static_assert(sizeof(struct apple80211req) == 40, "apple80211req");
+_Static_assert(sizeof(struct apple80211_assoc) == 592 && offsetof(struct apple80211_assoc, key) == 0x48, "assoc");
+_Static_assert(sizeof(struct apple80211_link_changed) == 32 && offsetof(struct apple80211_link_changed, reason) == 0x14,
+    "link_changed");
+_Static_assert(sizeof(struct apple80211_channels) == 4824, "channels");
+_Static_assert(sizeof(struct apple80211_channels_info) == 10016 && offsetof(struct apple80211_channels_info, number) == 0x32e &&
+    offsetof(struct apple80211_channels_info, flags) == 0x12d0, "channels_info");
+_Static_assert(sizeof(struct apple80211_scan_request) == 5456 && offsetof(struct apple80211_scan_request, channels) == 0x48 &&
+    offsetof(struct apple80211_scan_request, flags) == 0x1308 && offsetof(struct apple80211_scan_request, names) == 0x1318,
+    "scan_request");
+_Static_assert(sizeof(struct apple80211_scan_result) == 1164 && offsetof(struct apple80211_scan_result, ssid_length) == 0x60 &&
+    offsetof(struct apple80211_scan_result, age_ms) == 0x84 && offsetof(struct apple80211_scan_result, elements) == 0x8c,
+    "scan_result");
+
+enum { A8_EV_POWER = 1, A8_EV_SSID = 2, A8_EV_BSSID = 3, A8_EV_LINK = 4, A8_EV_ASSOC_DONE = 9, A8_EV_SCAN_DONE = 10 };
+enum { A8_RQ_POWER = 1, A8_RQ_LEAVE = 2, A8_RQ_JOIN = 4, A8_RQ_SCAN = 8 };
+
+#define WF_NBSS         32u
+struct wf_bss {
+	uint8_t bssid[6], sl, chan;
+	uint8_t ssid[32];
+	int16_t rssi, noise;
+	uint16_t cap, beacon, iel;
+	bool sec;
+	uint8_t age;                            /* 0183: scans since last heard */
+	uint8_t ie[512];
+};
+
+static LCK_MTX_DECLARE(wf_a8_lock, &wf_lck_grp);       /* all below but wf_bss_new (the bus lock's) */
+static struct wf_bss wf_bss_new[WF_NBSS];               /* the scan going on */
+static uint32_t wf_bss_nn;
+static struct wf_bss wf_bss_tab[WF_NBSS];               /* the last scan's */
+static uint32_t wf_bss_n, wf_a8_next;
+static struct wf_bss wf_cur;                            /* the network joined, while wf_cur_ok */
+static bool wf_cur_ok;
+static bool wf_a8_power = true;                         /* the radio's power as wifid set it */
+static uint32_t wf_a8_rq, wf_a8_busy;                   /* A8_RQ_* asked for / being done */
+static uint32_t wf_a8_result;                           /* of the last join wifid asked for; 0 while it runs */
+static bool wf_a8_leaving;                              /* a leave asked for: the link's loss is not involuntary */
+static int wf_a8_started;
+static struct {
+	uint8_t ssid[32], key[64];
+	int sl, kl, kind;                               /* kind 0 open, 1 passphrase, 2 PMK */
+} wf_a8_jp;
+
+/* ---- what a scan heard (escan results; under the bus lock) ---- */
+static void
+wf_a8_scan_start(void)
+{
+	wf_bss_nn = 0;
+}
+
+static void
+wf_a8_bss(const uint8_t *b, uint32_t blen)
+{
+	if (blen < 128) {
+		return;
+	}
+	uint32_t bl = (uint32_t)b[4] | (uint32_t)b[5] << 8 | (uint32_t)b[6] << 16 | (uint32_t)b[7] << 24;
+	if (bl > blen) {
+		bl = blen;
+	}
+	struct wf_bss *e = NULL;
+	for (uint32_t i = 0; i < wf_bss_nn; i++) {
+		if (!memcmp(wf_bss_new[i].bssid, b + 8, 6)) {
+			e = &wf_bss_new[i];
+			break;
+		}
+	}
+	if (e == NULL) {
+		if (wf_bss_nn == WF_NBSS) {
+			return;
+		}
+		e = &wf_bss_new[wf_bss_nn++];
+	}
+	bzero(e, sizeof(*e));
+	memcpy(e->bssid, b + 8, 6);
+	e->beacon = (uint16_t)(b[14] | b[15] << 8);
+	e->cap = (uint16_t)(b[16] | b[17] << 8);
+	e->sl = b[18] > 32 ? 32 : b[18];
+	memcpy(e->ssid, b + 19, e->sl);
+	e->chan = b[88] ? b[88] : b[72];                /* ctl_ch, else the chanspec's channel */
+	e->rssi = (int16_t)(b[78] | b[79] << 8);
+	e->noise = (int8_t)b[80];
+	uint32_t io = (uint32_t)b[116] | (uint32_t)b[117] << 8;
+	uint32_t il = (uint32_t)b[120] | (uint32_t)b[121] << 8 | (uint32_t)b[122] << 16 | (uint32_t)b[123] << 24;
+	if (io >= 128 && io <= bl && il <= bl - io) {
+		const uint8_t *ie = b + io;
+		uint32_t at = 0;
+		while (at + 2 <= il && at + 2 + ie[at + 1] <= il && at + 2 + ie[at + 1] <= sizeof(e->ie)) {
+			if (ie[at] == 48) {
+				e->sec = true;          /* RSN */
+			}
+			at += 2 + ie[at + 1];
+		}
+		memcpy(e->ie, ie, at);
+		e->iel = (uint16_t)at;
+	}
+	e->sec = e->sec || (e->cap & 0x10);
+}
+
+static void
+wf_a8_scan_over(void)
+{
+	lck_mtx_lock(&wf_a8_lock);
+	/* 0183: a network missed by one short scan stays listed for two more */
+	for (uint32_t i = 0; i < wf_bss_n && wf_bss_nn < WF_NBSS; i++) {
+		bool there = false;
+		for (uint32_t j = 0; j < wf_bss_nn && !there; j++) {
+			there = !memcmp(wf_bss_new[j].bssid, wf_bss_tab[i].bssid, 6);
+		}
+		if (!there && wf_bss_tab[i].age < 2) {
+			wf_bss_new[wf_bss_nn] = wf_bss_tab[i];
+			wf_bss_new[wf_bss_nn++].age++;
+		}
+	}
+	memcpy(wf_bss_tab, wf_bss_new, wf_bss_nn * sizeof(wf_bss_new[0]));
+	wf_bss_n = wf_bss_nn;
+	wf_a8_next = 0;
+	lck_mtx_unlock(&wf_a8_lock);
+}
+
+/* ---- the network joined (wf_join, under the bus lock, before the link goes up) ---- */
+static void
+wf_a8_joined(const uint8_t *ssid, int sl, bool sec)
+{
+	static const uint8_t z[12] = { 0 };
+	struct wf_bss *c = kalloc_data(sizeof(*c), Z_WAITOK | Z_ZERO);
+	if (c == NULL) {
+		return;
+	}
+	c->sl = (uint8_t)sl;
+	memcpy(c->ssid, ssid, (size_t)sl);
+	c->sec = sec;
+	if (wf_dcmd(23, false, z, 6) == 0 && wf_ctl_len >= 6) {         /* WLC_GET_BSSID */
+		memcpy(c->bssid, wf_ctl, 6);
+	}
+	int32_t v = 0;
+	if (wf_dcmd(127, false, z, 4) == 0 && wf_ctl_len >= 4) {        /* WLC_GET_RSSI */
+		memcpy(&v, wf_ctl, 4);
+		c->rssi = (int16_t)v;
+	}
+	if (wf_dcmd(29, false, z, 12) == 0 && wf_ctl_len >= 4) {         /* WLC_GET_CHANNEL: channel_info_t */
+		memcpy(&v, wf_ctl, 4);
+		c->chan = (uint8_t)v;
+	}
+	bool found = false;
+	for (uint32_t i = 0; i < wf_bss_nn; i++) {
+		if (!memcmp(wf_bss_new[i].bssid, c->bssid, 6) && wf_bss_new[i].sl == c->sl &&
+		    !memcmp(wf_bss_new[i].ssid, c->ssid, c->sl)) {
+			c->cap = wf_bss_new[i].cap;
+			c->beacon = wf_bss_new[i].beacon;
+			c->noise = wf_bss_new[i].noise;
+			c->chan = c->chan ? c->chan : wf_bss_new[i].chan;
+			c->iel = wf_bss_new[i].iel;
+			memcpy(c->ie, wf_bss_new[i].ie, c->iel);
+			found = true;
+			break;
+		}
+	}
+	if (!found) {
+		/* no scan heard it: its elements as they must be (SSID, rates, channel, RSN WPA2-PSK CCMP) */
+		static const uint8_t rates[] = { 1, 8, 0x82, 0x84, 0x8b, 0x96, 0x0c, 0x12, 0x18, 0x24 };
+		static const uint8_t rsn[] = { 48, 20, 1, 0, 0x00, 0x0f, 0xac, 4, 1, 0, 0x00, 0x0f, 0xac, 4, 1, 0, 0x00, 0x0f,
+			                       0xac, 2, 0x0c, 0 };
+		uint32_t n = 0;
+		c->ie[n++] = 0;
+		c->ie[n++] = (uint8_t)sl;
+		memcpy(c->ie + n, ssid, (size_t)sl);
+		n += (uint32_t)sl;
+		memcpy(c->ie + n, rates, sizeof(rates));
+		n += sizeof(rates);
+		c->ie[n++] = 3;
+		c->ie[n++] = 1;
+		c->ie[n++] = c->chan;
+		if (sec) {
+			memcpy(c->ie + n, rsn, sizeof(rsn));
+			n += sizeof(rsn);
+		}
+		c->iel = (uint16_t)n;
+		c->cap = (uint16_t)(0x0001 | 0x0400 | (sec ? 0x0010 : 0));     /* ESS, short slot, privacy */
+		c->beacon = 100;
+	}
+	lck_mtx_lock(&wf_a8_lock);
+	wf_cur = *c;
+	wf_cur_ok = true;
+	lck_mtx_unlock(&wf_a8_lock);
+	printf("USB> wifi: A8: joined: channel %u, RSSI %d, %s scan, %u bytes of elements\n", c->chan, c->rssi,
+	    found ? "from the" : "not in the last", c->iel);
+	kfree_data(c, sizeof(*c));
+}
+
+/* ---- events ---- */
+static void
+wf_a8_post(uint32_t code, const void *data, uint32_t len)
+{
+	struct kev_msg m;
+	char name[16];
+
+	bzero(&m, sizeof(m));
+	bzero(name, sizeof(name));
+	if (wf_ifp != NULL) {
+		snprintf(name, sizeof(name), "%s%u", ifnet_name(wf_ifp), ifnet_unit(wf_ifp));
+	} else {
+		strlcpy(name, "en0", sizeof(name));
+	}
+	m.vendor_code = KEV_VENDOR_APPLE;
+	m.kev_class = KEV_IEEE80211_CLASS;
+	m.kev_subclass = 1;
+	m.event_code = code;
+	m.dv[0].data_length = sizeof(name);
+	m.dv[0].data_ptr = name;
+	if (len != 0) {
+		m.dv[1].data_length = len;
+		m.dv[1].data_ptr = __DECONST(void *, data);
+	}
+	(void)kev_post_msg(&m);
+}
+
+static void
+wf_a8_link(bool up)
+{
+	struct apple80211_link_changed l;
+
+	bzero(&l, sizeof(l));
+	lck_mtx_lock(&wf_a8_lock);
+	if (!up) {
+		wf_cur_ok = false;
+	}
+	l.down = !up;
+	l.rssi = up ? wf_cur.rssi : 0;
+	if (up && wf_cur.noise != 0) {
+		l.noise = (uint16_t)wf_cur.noise;
+		l.snr = (uint16_t)(wf_cur.rssi - wf_cur.noise);
+	}
+	l.involuntary = !up && !wf_a8_leaving;
+	l.reason = l.involuntary ? 4 : 0;
+	lck_mtx_unlock(&wf_a8_lock);
+	wf_a8_post(A8_EV_SSID, NULL, 0);
+	wf_a8_post(A8_EV_BSSID, NULL, 0);
+	wf_a8_post(A8_EV_LINK, &l, sizeof(l));
+}
+
+/* ---- the thread that does what takes long (the bus lock is taken here, never in a request) ---- */
+static void
+wf_a8_fw(void)
+{
+	if (!wf_fwup) {
+		printf("USB> wifi: A8: firmware\n");
+		wf_bus4 = true;
+		wf_fw();
+	}
+}
+
+static void
+wf_a8_disassoc(void)
+{
+	uint8_t scb[12];
+
+	bzero(scb, sizeof(scb));
+	scb[0] = 3;                                     /* reason: leaving */
+	lck_mtx_lock(&wf_a8_lock);
+	wf_a8_leaving = true;
+	lck_mtx_unlock(&wf_a8_lock);
+	int st = wf_fwup ? wf_dcmd(52, true, scb, sizeof(scb)) : 0;     /* WLC_DISASSOC */
+	wf_hs_clear();
+	wf_net_link_set(false);
+	lck_mtx_lock(&wf_a8_lock);
+	wf_a8_leaving = false;
+	lck_mtx_unlock(&wf_a8_lock);
+	printf("USB> wifi: A8: left the network (%d)\n", st);
+}
+
+static void
+wf_a8_thread(void *a __unused, wait_result_t w __unused)
+{
+	struct timespec ts = { 5, 0 };
+	uint8_t ssid[32], key[64];
+
+	for (;;) {
+		lck_mtx_lock(&wf_a8_lock);
+		if (!wf_a8_rq) {
+			(void)msleep(&wf_a8_rq, &wf_a8_lock, PZERO, "wifia8", &ts);
+		}
+		uint32_t rq = wf_a8_rq;
+		wf_a8_rq = 0;
+		wf_a8_busy = rq;
+		int sl = wf_a8_jp.sl, kl = wf_a8_jp.kl, kind = wf_a8_jp.kind;
+		memcpy(ssid, wf_a8_jp.ssid, sizeof(ssid));
+		memcpy(key, wf_a8_jp.key, sizeof(key));
+		bzero(&wf_a8_jp, sizeof(wf_a8_jp));
+		bool power = wf_a8_power, joined = wf_cur_ok;
+		struct wf_bss cur = wf_cur;
+		lck_mtx_unlock(&wf_a8_lock);
+
+		uint32_t result = 0;
+		lck_mtx_lock(&wf_bus);
+		if (rq & A8_RQ_POWER) {
+			static const uint8_t zero4[4] = { 0, 0, 0, 0 };
+			if (power) {
+				wf_auto_off = false;
+				wf_auto_hold = 0;
+				wf_a8_fw();
+				int st = wf_fwup ? wf_dcmd(WLC_UP, true, zero4, 4) : -1;
+				printf("USB> wifi: A8: power on: firmware %s, WLC_UP %d\n", wf_fwup ? "running" : "NOT running", st);
+			} else {
+				if (wf_net_link) {
+					wf_a8_disassoc();
+				}
+				wf_auto_off = true;             /* until it is on again (or a join) */
+				int st = wf_fwup ? wf_dcmd(3, true, zero4, 4) : 0;      /* WLC_DOWN */
+				printf("USB> wifi: A8: power off: WLC_DOWN %d (firmware kept)\n", st);
+			}
+		}
+		if ((rq & A8_RQ_LEAVE) && !(rq & A8_RQ_JOIN)) {
+			if (wf_net_link || wf_fwup) {
+				wf_a8_disassoc();
+			}
+			wf_auto_hold = mach_absolute_time() + wf_ms_abs(120000);       /* on7wifid: not straight back */
+		}
+		if (rq & A8_RQ_JOIN) {
+			char name[33];
+			wf_ssid_name(ssid, sl, name);
+			if (!power) {
+				result = 2;
+			} else if (joined && wf_net_link && cur.sl == sl && !memcmp(cur.ssid, ssid, (size_t)sl)) {
+				result = 1;                     /* already there (auto-join at boot, say) */
+				printf("USB> wifi: A8: join \"%s\": already joined\n", name);
+			} else {
+				wf_a8_fw();
+				if (wf_net_link) {
+					wf_a8_disassoc();
+				}
+				bool ok = wf_fwup && wf_join(ssid, sl, kind == 1 ? key : NULL, kind == 1 ? kl : 0,
+				    kind == 2 ? key : NULL, true);
+				result = ok ? 1 : wf_fwup ? wf_j_why : 2;
+			}
+			bzero(key, sizeof(key));
+		}
+		if ((rq & A8_RQ_SCAN) && power) {
+			wf_a8_fw();
+			if (wf_fwup) {
+				wf_scan_loud = false;
+				wf_scan_cmd();
+				wf_scan_loud = true;
+			}
+		}
+		if (!rq && joined && wf_fwup && wf_net_link) {
+			static const uint8_t z[4] = { 0 };
+			int32_t v = 0;
+			if (wf_dcmd(127, false, z, 4) == 0 && wf_ctl_len >= 4) {        /* the RSSI, every 5 s */
+				memcpy(&v, wf_ctl, 4);
+				lck_mtx_lock(&wf_a8_lock);
+				wf_cur.rssi = (int16_t)v;
+				lck_mtx_unlock(&wf_a8_lock);
+			}
+		}
+		if (!wf_fwup) {
+			wf_net_link_set(false);
+		}
+		lck_mtx_unlock(&wf_bus);
+
+		if (rq & A8_RQ_POWER) {
+			wf_a8_post(A8_EV_POWER, NULL, 0);
+		}
+		if (rq & A8_RQ_JOIN) {
+			lck_mtx_lock(&wf_a8_lock);
+			wf_a8_result = result;
+			lck_mtx_unlock(&wf_a8_lock);
+			printf("USB> wifi: A8: join over: result %u\n", result);
+			wf_a8_post(A8_EV_ASSOC_DONE, NULL, 0);
+		}
+		if (rq & A8_RQ_SCAN) {
+			if (!power) {
+				lck_mtx_lock(&wf_a8_lock);
+				wf_bss_n = 0;
+				wf_a8_next = 0;
+				lck_mtx_unlock(&wf_a8_lock);
+			}
+			wf_a8_post(A8_EV_SCAN_DONE, NULL, 0);
+		}
+		lck_mtx_lock(&wf_a8_lock);
+		wf_a8_busy = 0;
+		lck_mtx_unlock(&wf_a8_lock);
+	}
+}
+
+static void
+wf_a8_start(void)
+{
+	if (__atomic_exchange_n(&wf_a8_started, 1, __ATOMIC_ACQ_REL)) {
+		return;
+	}
+	thread_t t;
+	if (kernel_thread_start(wf_a8_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	} else {
+		printf("USB> wifi: A8: the thread did not start\n");
+		__atomic_store_n(&wf_a8_started, 0, __ATOMIC_RELEASE);
+	}
+}
+
+static void
+wf_a8_ask(uint32_t what)
+{
+	wf_a8_start();
+	lck_mtx_lock(&wf_a8_lock);
+	wf_a8_rq |= what;
+	wakeup(&wf_a8_rq);
+	lck_mtx_unlock(&wf_a8_lock);
+}
+
+/* ---- the answers ---- */
+static const char *
+wf_a8_name(int32_t t)
+{
+	switch (t) {
+	case 1: return "SSID";
+	case 2: return "AUTH_TYPE";
+	case 4: return "CHANNEL";
+	case 9: return "BSSID";
+	case 10: return "SCAN_REQ";
+	case 11: return "SCAN_RESULT";
+	case 12: return "CARD_CAPABILITIES";
+	case 13: return "STATE";
+	case 14: return "PHY_MODE";
+	case 15: return "OP_MODE";
+	case 16: return "RSSI";
+	case 17: return "NOISE";
+	case 19: return "POWER";
+	case 20: return "ASSOCIATE";
+	case 21: return "ASSOCIATE_RESULT";
+	case 22: return "DISASSOCIATE";
+	case 27: return "SUPPORTED_CHANNELS";
+	case 28: return "LOCALE";
+	case 43: return "DRIVER_VERSION";
+	case 44: return "HARDWARE_VERSION";
+	case 51: return "COUNTRY_CODE";
+	case 103: return "CURRENT_NETWORK";
+	case 207: return "CHANNELS_INFO";
+	case 254: return "HW_SUPPORTED_CHANNELS";
+	default: return "?";
+	}
+}
+
+static void
+wf_a8_chan(struct apple80211_channel *c, uint32_t ch)
+{
+	c->version = 1;
+	c->channel = ch;
+	c->flags = A8_CH_20MHZ | A8_CH_2GHZ | A8_CH_ACTIVE;
+}
+
+static int
+wf_a8_give(const struct apple80211req *r, const void *d, size_t n)
+{
+	return r->req_data == USER_ADDR_NULL ? 0 : copyout(d, r->req_data, n < r->req_len ? n : r->req_len);
+}
+
+/* a network as a scan's result has it; the caller says how much room for elements there is */
+static int
+wf_a8_give_bss(const struct apple80211req *r, const struct wf_bss *e)
+{
+	struct apple80211_scan_result *x = kalloc_data(sizeof(*x), Z_WAITOK | Z_ZERO);
+	uint32_t room = sizeof(x->elements);
+	int err;
+
+	if (x == NULL) {
+		return ENOMEM;
+	}
+	if (r->req_len >= sizeof(*x) && r->req_data != USER_ADDR_NULL &&
+	    copyin(r->req_data, x, offsetof(struct apple80211_scan_result, elements)) == 0 && x->elements_length < room) {
+		room = x->elements_length;
+	}
+	bzero(x, sizeof(*x));
+	x->version = 1;
+	wf_a8_chan(&x->channel, e->chan);
+	x->rssi = e->rssi;
+	if (e->noise != 0) {
+		x->noise = e->noise;
+		x->snr = (int16_t)(e->rssi - e->noise);
+	}
+	x->beacon_interval = e->beacon;
+	x->capability = e->cap;
+	memcpy(x->bssid, e->bssid, 6);
+	x->ssid_length = e->sl;
+	memcpy(x->ssid, e->ssid, e->sl);
+	x->elements_length = (uint16_t)(e->iel <= room ? e->iel : 0);
+	memcpy(x->elements, e->ie, x->elements_length);
+	for (uint32_t at = 0; at + 2 <= e->iel && at + 2 + e->ie[at + 1] <= e->iel; at += 2 + e->ie[at + 1]) {
+		for (uint32_t i = 0; (e->ie[at] == 1 || e->ie[at] == 50) && i < e->ie[at + 1]; i++) {
+			uint32_t rate = (e->ie[at + 2 + i] & 0x7fu) / 2;
+			if (rate != 0 && rate <= 54 && x->rate_count < 15) {
+				x->rates[x->rate_count++] = rate;
+			}
+		}
+	}
+	err = wf_a8_give(r, x, sizeof(*x));
+	kfree_data(x, sizeof(*x));
+	return err;
+}
+
+static int
+wf_a8_get(struct apple80211req *r)
+{
+	int err = 0;
+
+	switch (r->req_type) {
+	case 43:
+	case 44: {
+		static const char name[256] = "on7xelte: BCM43430A1 (SDIO), host WPA2";
+		return wf_a8_give(r, name, sizeof(name));
+	}
+	case 12: {
+		/* AES, AES-CCM, power management, short slot and preamble, WPA2, WME, short GI 20 MHz (y2sios) */
+		uint8_t bits[13] = { 0 };
+		static const uint8_t has[] = { 2, 3, 6, 9, 10, 14, 17, 19 };
+		for (uint32_t i = 0; i < sizeof(has); i++) {
+			bits[has[i] / 8] |= (uint8_t)(1u << (has[i] % 8));
+		}
+		return wf_a8_give(r, bits, sizeof(bits));
+	}
+	case 19: {
+		struct {
+			uint32_t version, radios, state[4];
+		} p = { .version = 1, .radios = 1 };
+		lck_mtx_lock(&wf_a8_lock);
+		p.state[0] = wf_a8_power;
+		lck_mtx_unlock(&wf_a8_lock);
+		return wf_a8_give(r, &p, sizeof(p));
+	}
+	case 15:
+		r->req_val = 1;                 /* a station */
+		return 0;
+	case 27:
+	case 254: {
+		struct apple80211_channels *c = kalloc_data(sizeof(*c), Z_WAITOK | Z_ZERO);
+		if (c == NULL) {
+			return ENOMEM;
+		}
+		c->version = 1;
+		c->count = 13;
+		for (uint32_t i = 0; i < 13; i++) {
+			wf_a8_chan(&c->channels[i], i + 1);
+		}
+		err = wf_a8_give(r, c, sizeof(*c));
+		kfree_data(c, sizeof(*c));
+		return err;
+	}
+	case 207: {
+		struct apple80211_channels_info *c = kalloc_data(sizeof(*c), Z_WAITOK | Z_ZERO);
+		if (c == NULL) {
+			return ENOMEM;
+		}
+		c->count = 13;
+		for (uint32_t i = 0; i < 13; i++) {
+			c->number[i] = (uint8_t)(i + 1);
+			c->flags[i] = A8_CH_20MHZ | A8_CH_2GHZ | A8_CH_ACTIVE;
+		}
+		err = wf_a8_give(r, c, sizeof(*c));
+		kfree_data(c, sizeof(*c));
+		return err;
+	}
+	case 21:
+		lck_mtx_lock(&wf_a8_lock);
+		r->req_val = (int32_t)wf_a8_result;
+		lck_mtx_unlock(&wf_a8_lock);
+		return 0;
+	case 11: {
+		struct wf_bss *e = kalloc_data(sizeof(*e), Z_WAITOK);
+		bool there;
+		if (e == NULL) {
+			return ENOMEM;
+		}
+		lck_mtx_lock(&wf_a8_lock);
+		uint32_t i = wf_a8_next++;
+		there = i < wf_bss_n;
+		if (there) {
+			*e = wf_bss_tab[i];
+		}
+		lck_mtx_unlock(&wf_a8_lock);
+		err = there ? wf_a8_give_bss(r, e) : EIO;
+		kfree_data(e, sizeof(*e));
+		return err;
+	}
+	default:
+		break;
+	}
+
+	/* the rest is about the network joined */
+	struct wf_bss *c = kalloc_data(sizeof(*c), Z_WAITOK);
+	if (c == NULL) {
+		return ENOMEM;
+	}
+	lck_mtx_lock(&wf_a8_lock);
+	bool j = wf_cur_ok && wf_net_link;
+	uint32_t busy = wf_a8_busy | wf_a8_rq;
+	*c = wf_cur;
+	lck_mtx_unlock(&wf_a8_lock);
+	switch (r->req_type) {
+	case 13:                                /* INIT 0, SCAN 1, AUTH 2, ASSOC 3, RUN 4 */
+		r->req_val = j ? 4 : (busy & A8_RQ_JOIN) ? 2 : (busy & A8_RQ_SCAN) ? 1 : 0;
+		break;
+	case 1:
+		if (!j) {
+			err = ENXIO;
+		} else if ((err = wf_a8_give(r, c->ssid, c->sl)) == 0) {
+			r->req_len = c->sl;
+		}
+		break;
+	case 9:
+		err = j ? wf_a8_give(r, c->bssid, 6) : ENXIO;
+		break;
+	case 4: {
+		struct {
+			uint32_t version;
+			struct apple80211_channel channel;
+		} ch = { .version = 1 };
+		wf_a8_chan(&ch.channel, c->chan);
+		err = j ? wf_a8_give(r, &ch, sizeof(ch)) : ENXIO;
+		break;
+	}
+	case 16:
+	case 17: {
+		int32_t v = r->req_type == 16 ? c->rssi : c->noise;
+		struct {
+			uint32_t version, radios, unit;
+			int32_t each[4], all, each_ext[4], all_ext;
+		} q = { .version = 1, .radios = 1, .each = { v }, .all = v, .each_ext = { v }, .all_ext = v };
+		err = !j || (r->req_type == 17 && v == 0) ? ENXIO : wf_a8_give(r, &q, sizeof(q));
+		break;
+	}
+	case 103:
+		err = j ? wf_a8_give_bss(r, c) : ENXIO;
+		break;
+	case 2: {
+		struct {
+			uint32_t version, lower, upper, extended;
+		} a = { .version = 1, .lower = 1, .upper = c->sec ? 8 : 0 };
+		err = j ? wf_a8_give(r, &a, sizeof(a)) : ENXIO;
+		break;
+	}
+	default:
+		err = EOPNOTSUPP;
+		break;
+	}
+	kfree_data(c, sizeof(*c));
+	return err;
+}
+
+static int
+wf_a8_set_join(const struct apple80211req *r, char *said, size_t n)
+{
+	struct apple80211_assoc *a;
+	int err;
+
+	if (r->req_len < offsetof(struct apple80211_assoc, rest) || r->req_data == USER_ADDR_NULL) {
+		return EINVAL;
+	}
+	a = kalloc_data(sizeof(*a), Z_WAITOK | Z_ZERO);
+	if (a == NULL) {
+		return ENOMEM;
+	}
+	err = copyin(r->req_data, a, offsetof(struct apple80211_assoc, rest));
+	if (err) {
+		goto out;
+	}
+	/* lengths and kinds only: the name and the key stay out of the log */
+	snprintf(said, n, " (join: a name of %u bytes, auth %#x/%#x, a key of %u bytes of kind %u)", a->ssid_length,
+	    a->auth_lower, a->auth_upper, a->key_length, a->key_cipher);
+	int kind;
+	if (a->ssid_length == 0 || a->ssid_length > 32) {
+		err = EINVAL;
+		goto out;
+	}
+	if (a->key_length == 0) {
+		kind = 0;
+	} else if (a->key_cipher == A8_CIPHER_PASSPHRASE && a->key_length >= 8 && a->key_length <= 63) {
+		kind = 1;
+	} else if (a->key_cipher == A8_CIPHER_PMK && a->key_length == 32) {
+		kind = 2;
+	} else {
+		err = EINVAL;
+		goto out;
+	}
+	lck_mtx_lock(&wf_a8_lock);
+	bzero(&wf_a8_jp, sizeof(wf_a8_jp));
+	wf_a8_jp.sl = (int)a->ssid_length;
+	memcpy(wf_a8_jp.ssid, a->ssid, a->ssid_length);
+	wf_a8_jp.kind = kind;
+	wf_a8_jp.kl = (int)a->key_length;
+	memcpy(wf_a8_jp.key, a->key, a->key_length);
+	wf_a8_result = 0;
+	lck_mtx_unlock(&wf_a8_lock);
+	wf_a8_ask(A8_RQ_JOIN);
+out:
+	bzero(a, sizeof(*a));
+	kfree_data(a, sizeof(*a));
+	return err;
+}
+
+static int
+wf_a8_set(const struct apple80211req *r, char *said, size_t n)
+{
+	switch (r->req_type) {
+	case 51:                                /* 0182: COUNTRY_CODE: the firmware keeps its own (ccode) */
+	case 383:                               /* 0182: a 4104-byte set wifid repeats; taken, not acted on */
+		return 0;
+	case 20:
+		return wf_a8_set_join(r, said, n);
+	case 22:
+		wf_a8_ask(A8_RQ_LEAVE);
+		return 0;
+	case 19: {
+		struct {
+			uint32_t version, radios, state[4];
+		} p;
+		int err;
+		if (r->req_len < sizeof(p) || r->req_data == USER_ADDR_NULL) {
+			return EINVAL;
+		}
+		if ((err = copyin(r->req_data, &p, sizeof(p))) != 0) {
+			return err;
+		}
+		snprintf(said, n, " (power %s)", p.state[0] ? "on" : "off");
+		lck_mtx_lock(&wf_a8_lock);
+		wf_a8_power = p.state[0] != 0;
+		lck_mtx_unlock(&wf_a8_lock);
+		wf_a8_ask(A8_RQ_POWER);
+		return 0;
+	}
+	case 10: {
+		if (r->req_len != sizeof(struct apple80211_scan_request) || r->req_data == USER_ADDR_NULL) {
+			return EINVAL;
+		}
+		struct apple80211_scan_request *q = kalloc_data(sizeof(*q), Z_WAITOK);
+		if (q == NULL) {
+			return ENOMEM;
+		}
+		int err = copyin(r->req_data, q, sizeof(*q));
+		if (err == 0) {
+			snprintf(said, n, " (scan: type %u, %u channels, %u ms each, a name of %u bytes, %u names)", q->scan_type,
+			    q->channel_count, q->dwell_ms, q->ssid_length, q->name_count);
+			lck_mtx_lock(&wf_a8_lock);
+			bool on = wf_a8_power;
+			lck_mtx_unlock(&wf_a8_lock);
+			if (on) {
+				wf_a8_ask(A8_RQ_SCAN);
+			} else {
+				err = ENETDOWN;
+			}
+		}
+		kfree_data(q, sizeof(*q));
+		return err;
+	}
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+/* how often each kind of request came and how it fared ('wifi a8') */
+static struct {
+	int32_t type;
+	bool set;
+	uint32_t times, answered;
+	int last_error;
+} wf_a8_kinds[64];
+static uint32_t wf_a8_nkinds;
+
+static void
+wf_a8_note(const struct apple80211req *r, bool set, int err)
+{
+	uint32_t i;
+	lck_mtx_lock(&wf_a8_lock);
+	for (i = 0; i < wf_a8_nkinds && !(wf_a8_kinds[i].type == r->req_type && wf_a8_kinds[i].set == set); i++) {
+	}
+	if (i < 64) {
+		if (i == wf_a8_nkinds) {
+			wf_a8_nkinds++;
+			wf_a8_kinds[i].type = r->req_type;
+			wf_a8_kinds[i].set = set;
+		}
+		wf_a8_kinds[i].times++;
+		wf_a8_kinds[i].answered += err == 0;
+		if (err) {
+			wf_a8_kinds[i].last_error = err;
+		}
+	}
+	lck_mtx_unlock(&wf_a8_lock);
+}
+
+static void
+wf_a8_summary(void)
+{
+	printf("USB> wifi: A8: power %u, joined %u, last scan %u networks, last join result %u, thread %d\n", wf_a8_power,
+	    wf_cur_ok, wf_bss_n, wf_a8_result, wf_a8_started);
+	for (uint32_t i = 0; i < wf_a8_nkinds; i++) {
+		printf("USB> wifi: A8: %s %d (%s) %u times, answered %u, last error %d\n", wf_a8_kinds[i].set ? "set" : "get",
+		    wf_a8_kinds[i].type, wf_a8_name(wf_a8_kinds[i].type), wf_a8_kinds[i].times, wf_a8_kinds[i].answered,
+		    wf_a8_kinds[i].last_error);
+	}
+}
+
+static errno_t
+wf_a8_ioctl(unsigned long cmd, void *data)
+{
+	static uint32_t said;
+	struct apple80211req *r = data;
+	char who[32] = "?", what[160] = "";
+	bool set = cmd == SIOCSA80211;
+	int err;
+
+	if (cmd != SIOCSA80211 && cmd != SIOCGA80211) {
+		return EOPNOTSUPP;
+	}
+	proc_selfname(who, sizeof(who));
+	err = set ? wf_a8_set(r, what, sizeof(what)) : wf_a8_get(r);
+	wf_a8_note(r, set, err);
+	/* a request asked for ever is told some hundred times; SCAN_RESULT only when it fails other than at the end */
+	if (said < 600 && !(r->req_type == 11 && (err == 0 || err == EIO))) {
+		said++;
+		char res[24];
+		snprintf(res, sizeof(res), err == 0 ? "ok" : err == EOPNOTSUPP ? "REFUSED" : "error %d", err);
+		printf("USB> wifi: A8: %s %s %d (%s), value %d, %u bytes%s: %s\n", who, set ? "sets" : "gets", r->req_type,
+		    wf_a8_name(r->req_type), r->req_val, r->req_len, what, res);
+	}
+	return err;
+}
+
+static void
+wf_cmd_locked(const char *arg)
+{
+	if (!strcmp(arg, "probe")) {
+		wf_probe(false);
+	} else if (!strcmp(arg, "probe keep")) {
+		wf_probe(true);
+	} else if (!strcmp(arg, "off")) {
+		wf_auto_off = true;             /* 0178: off by hand stays off until the next join */
+		wf_off();
+	} else if (!strcmp(arg, "st")) {
+		wf_st();
+	} else if (!strcmp(arg, "fw")) {
+		wf_bus4 = true;
+		wf_fw();
+	} else if (!strncmp(arg, "fifo ", 5) && arg[5] >= '0' && arg[5] <= '3' && !arg[6]) {
+		wf_fifo_mode = (uint32_t)(arg[5] - '0');
+		printf("USB> wifi: FIFO write mode %u\n", wf_fifo_mode);
+	} else if (!strncmp(arg, "div ", 4)) {
+		const char *a = arg + 4;
+		bool ok;
+		uint32_t d = wf_hex(&a, &ok);
+		if (ok && d >= 4 && d <= WF_CLKDIV_SLOW) {
+			wf_div = d;
+			printf("USB> wifi: CLKDIV for the next fw: %u\n", wf_div);
+		} else {
+			printf("USB> wifi: div N (hex, 4..ff)\n");
+		}
+	} else if (!strcmp(arg, "ver")) {
+		wf_ver_cmd();
+	} else if (!strcmp(arg, "mac")) {
+		wf_mac_cmd();
+	} else if (!strcmp(arg, "scan")) {
+		wf_scan_cmd();
+	} else if (!strcmp(arg, "dm keep")) {
+		wf_dm_keep = true;
+		printf("USB> wifi: deadman_to: the board's value for the next fw\n");
+	} else if (!strncmp(arg, "dm ", 3)) {
+		const char *a = arg + 3;
+		bool ok;
+		uint32_t v = wf_hex(&a, &ok);
+		if (ok) {
+			wf_dm_val = v;
+			wf_dm_keep = false;
+			printf("USB> wifi: deadman_to=0x%x for the next fw\n", v);
+		} else {
+			printf("USB> wifi: dm HEX | dm keep\n");
+		}
+	} else if (!strncmp(arg, "join ", 5)) {
+		wf_join_cmd(arg + 5);
+	} else if (!strcmp(arg, "link")) {
+		wf_link_cmd();
+	} else if (!strcmp(arg, "forget")) {
+		wf_forget_cmd();
+	} else if (!strcmp(arg, "saved")) {
+		wf_saved_cmd();
+	} else if (!strcmp(arg, "auto")) {
+		printf("USB> wifi: AUTO: %d\n", wf_auto());
+	} else if (!strcmp(arg, "net")) {
+		wf_net_cmd();
+	} else if (!strcmp(arg, "a8")) {
+		wf_a8_summary();
+	} else if (!strcmp(arg, "busy")) {
+		extern void On7IOKitBusy(void);
+		On7IOKitBusy();                 /* 0181: IOKit services still busy (configd waits for quiet) */
+	} else if (!strcmp(arg, "dhcp")) {
+		if (wf_net_link) {
+			wf_dhcp_start();
+		} else {
+			printf("USB> wifi: DHCP: no link ('wifi join' first)\n");
+		}
+	} else if (!strcmp(arg, "con")) {
+		if (wf_fwup && wf_fw_cons) {
+			wf_bad = false;
+			wf_console(wf_fw_cons, wf_fw_ram);
+		} else {
+			printf("USB> wifi: the firmware is not running\n");
+		}
+	} else if (!strcmp(arg, "fw1")) {
+		wf_bus4 = false;
+		wf_fw();
+	} else if (!strncmp(arg, "wr ", 3)) {
+		wf_wr_cmd(arg + 3);
+	} else if (!strncmp(arg, "rd ", 3)) {
+		wf_rd_cmd(arg + 3, false);
+	} else if (!strncmp(arg, "cr ", 3)) {
+		wf_rd_cmd(arg + 3, true);
+	} else {
+		printf("USB> wifi: probe [keep] | off | st | fw | fw1 | ver | mac | scan | join SSIDHEX PASSHEX|- [save] | forget | saved | auto | link | net | a8 | busy | dhcp | dm HEX|keep | con | fifo 0-3 | div N | rd ADDR [N] | wr ADDR VAL | cr FN ADDR\n");
+	}
+}
+
+/* From the dvfs worker (a5xelte_dvfs.c dv_run), which may sleep. 0175: under the bus lock */
+void on7xelte_wifi_cmd(const char *arg);
+void
+on7xelte_wifi_cmd(const char *arg)
+{
+	lck_mtx_lock(&wf_bus);
+	wf_cmd_locked(arg);
+	if (!wf_fwup) {
+		wf_net_link_set(false);         /* off, or the chip restarted: no link */
+	}
+	lck_mtx_unlock(&wf_bus);
+}
+
+/*
+ * 0178: for on7wifid (tools/on7wifid), root only. kern.on7xelte_wifi: write "auto", "net", "saved", "off" (the
+ * command in the caller's thread, under the bus lock; "auto" answers with its errno) or "log TEXT" (a line of
+ * the daemon's in the kernel log). kern.on7xelte_wifi_lease: the lease, for configd.
+ */
+struct on7_wifi_lease {
+	uint32_t ver, link, state, on_if, ip, mask, gw, dns, lease;
+	char ifname[16];
+};
+
+static int
+wf_sysctl_cmd SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[96];
+	int err;
+
+	if (req->newptr == USER_ADDR_NULL) {
+		return SYSCTL_OUT(req, "", 1);
+	}
+	if (req->newlen == 0 || req->newlen >= sizeof(buf)) {
+		return EINVAL;
+	}
+	size_t n = req->newlen;
+	err = SYSCTL_IN(req, buf, n);
+	if (err) {
+		return err;
+	}
+	buf[n] = 0;
+	while (n && (buf[n - 1] == '\n' || buf[n - 1] == 0)) {
+		buf[--n] = 0;
+	}
+	if (!strncmp(buf, "log ", 4)) {
+		for (char *c = buf + 4; *c; c++) {
+			if (*c < 0x20 || *c >= 0x7f) {
+				*c = '?';
+			}
+		}
+		printf("USB> on7wifid: %s\n", buf + 4);
+		return 0;
+	}
+	if (!strcmp(buf, "auto")) {
+		lck_mtx_lock(&wf_bus);
+		err = wf_auto();
+		if (!wf_fwup) {
+			wf_net_link_set(false);
+		}
+		lck_mtx_unlock(&wf_bus);
+		return err;
+	}
+	if (!strcmp(buf, "net") || !strcmp(buf, "saved") || !strcmp(buf, "off")) {
+		on7xelte_wifi_cmd(buf);
+		return 0;
+	}
+	return EINVAL;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, on7xelte_wifi, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, wf_sysctl_cmd, "A",
+    "on7xelte Wi-Fi: auto | net | saved | off | log TEXT");
+
+static int
+wf_sysctl_lease SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	struct on7_wifi_lease l;
+
+	bzero(&l, sizeof(l));
+	l.ver = 1;
+	l.link = wf_net_link && wf_fwup;
+	l.state = wf_dh.state;
+	l.ip = wf_dh.ip;
+	l.mask = wf_dh.mask;
+	l.gw = wf_dh.gw;
+	l.dns = wf_dh.dns;
+	l.lease = wf_dh.lease;
+	l.on_if = wf_dh.ip != 0 && wf_dh.set_ip == wf_dh.ip;
+	if (wf_ifp) {
+		snprintf(l.ifname, sizeof(l.ifname), "%s%u", ifnet_name(wf_ifp), ifnet_unit(wf_ifp));
+	}
+	return SYSCTL_OUT(req, &l, sizeof(l));
+}
+
+/*
+ * 0179: en0 (subfamily Wi-Fi) and the Apple80211 thread, before wifid runs: a5xelte_exec_denied() calls this when
+ * wifid is exec'd (wifid looks for its interface when it starts). Nothing of the chip is touched.
+ */
+void on7xelte_wifi_early(void);
+extern void On7WLANStart(const char *ifname, const uint8_t *mac);      /* iokit/Kernel/arm/SweetFramebuffer.cpp */
+void
+on7xelte_wifi_early(void)
+{
+	static bool published;
+	uint8_t mac[6];
+	lck_mtx_lock(&wf_bus);
+	bool had = wf_ifp != NULL;
+	wf_net_attach();
+	bool have = wf_ifp != NULL;
+	memcpy(mac, wf_mac, 6);
+	lck_mtx_unlock(&wf_bus);
+	wf_a8_start();
+	if (!had) {
+		printf("USB> wifi: A8: en0 made for wifid\n");
+	}
+	if (have && !published) {
+		/* 0180: the registry services wifid and configd find a Wi-Fi interface by (once) */
+		published = true;
+		On7WLANStart("en0", mac);
+	}
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, on7xelte_wifi_lease, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0, wf_sysctl_lease,
+    "S,on7_wifi_lease", "on7xelte Wi-Fi: the DHCP lease");
+
+#endif /* ARM64_BOARD_CONFIG_A5XELTE */
