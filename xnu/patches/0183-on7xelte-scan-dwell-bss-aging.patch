-
-static void
-wf_core_reset(struct wf_core *c, uint32_t prereset, uint32_t reset, uint32_t postreset)
-{
-	wf_core_disable(c, prereset, reset);
-	for (uint32_t n = 0; n < 50 && !wf_bad && (wf_rd32(c->wrap + AI_RESETCTRL) & 1); n++) {
-		wf_wr32(c->wrap + AI_RESETCTRL, 0);
-		delay(50);
-	}
-	wf_wr32(c->wrap + AI_IOCTRL, postreset | SICF_CLOCK_EN);
-	(void)wf_rd32(c->wrap + AI_IOCTRL);
-}
