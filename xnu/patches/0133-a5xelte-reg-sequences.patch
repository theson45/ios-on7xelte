+/* ---- "reg": host-driven register sequences ---- */
+
+static struct {
+	uint32_t    page;
+	vm_offset_t va;
+} reg_map[32];
+static uint32_t reg_map_next;
+
+static vm_offset_t
+reg_va(uint32_t pa)
+{
+	uint32_t page = pa & ~0xfffu;
+	for (uint32_t i = 0; i < 32; i++) {
+		if (reg_map[i].va && reg_map[i].page == page) {
+			return reg_map[i].va + (pa & 0xfffu);
+		}
+	}
+	vm_offset_t va = ml_io_map((vm_offset_t)page, 0x1000);
+	if (!va) {
+		return 0;
+	}
+	uint32_t i = reg_map_next++ % 32;       /* an evicted mapping leaks one page of VA */
+	reg_map[i].page = page;
+	reg_map[i].va = va;
+	return va + (pa & 0xfffu);
+}
+
+static const char *
+reg_bad_addr(uint32_t pa)
+{
+	if (pa < 0x10000000u || pa >= 0x16000000u || (pa & 3)) {
+		return "address must be 4-aligned in 0x10000000-0x15ffffff";
+	}
+	return NULL;
+}
+
+static const char *
+reg_deny(uint32_t pa, uint32_t v)
+{
+	const char *e = reg_bad_addr(pa);
+	if (e) {
+		return e;
+	}
+	if (pa >= 0x13540000u && pa < 0x13570000u) {
+		return "eMMC controllers are never written";
+	}
+	if (pa >= 0x13870000u && pa < 0x13871000u) {
+		return "i2c_0 (S2MU005 charger / fuel gauge) is never written";
+	}
+	if (pa >= (uint32_t)HSI2C_PA && pa < (uint32_t)HSI2C_PA + 0x2000u) {
+		uint32_t o = pa - (uint32_t)HSI2C_PA;
+		if (o >= 0x500) {
+			return "HSI2C_0 batcher is not reachable from reg";
+		}
+		if (o == 0x4c) {
+			return "HSI2C_0 MANUAL_CMD is not reachable from reg";
+		}
+		if (o == I2C_CONF && !(v & (1u << 31))) {
+			return "HSI2C_0 CONF must keep auto mode";
+		}
+		if (o == I2C_AUTO && !(v & (1u << 16)) && (v & 0xffffu) != 1) {
+			return "HSI2C_0 writes are one byte at most (PMIC writes: cpufreq)";
+		}
+	}
+	return NULL;
+}
+
+static uint64_t
+reg_us(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000;
+}
+
+static void
+reg_run(const char *line)
+{
+	const char *s = line;
+	boolean_t ints = TRUE, ints_off = FALSE;
+	uint32_t n = 0;
+	const char *stop = NULL;
+
+	while (*s && !stop) {
+		while (*s == ' ' || *s == ';') {
+			s++;
+		}
+		if (!*s) {
+			break;
+		}
+		char op = *s++;
+		n++;
+		if (op == 'r') {
+			uint32_t pa = dv_num(&s), cnt = dv_num(&s);
+			if ((stop = reg_bad_addr(pa))) {
+				break;
+			}
+			cnt = cnt ? (cnt > 64 ? 64 : cnt) : 1;
+			for (uint32_t i = 0; i < cnt && pa + 4 * i < 0x16000000u; i++) {
+				vm_offset_t va = reg_va(pa + 4 * i);
+				if (!va) {
+					stop = "map failed";
+					break;
+				}
+				printf("USB> reg r 0x%08x = 0x%08x\n", pa + 4 * i, rd32(va, 0));
+			}
+		} else if (op == 'w' || op == 'm') {
+			uint32_t pa = dv_num(&s), mask = op == 'm' ? dv_num(&s) : ~0u, v = dv_num(&s);
+			if ((stop = reg_bad_addr(pa))) {
+				break;
+			}
+			vm_offset_t va = reg_va(pa);
+			if (!va) {
+				stop = "map failed";
+				break;
+			}
+			uint32_t old = op == 'm' ? rd32(va, 0) : 0;
+			uint32_t nv = op == 'm' ? ((old & ~mask) | (v & mask)) : v;
+			if ((stop = reg_deny(pa, nv))) {
+				break;
+			}
+			wr32(va, 0, nv);
+			if (op == 'm') {
+				printf("USB> reg m 0x%08x: 0x%08x -> 0x%08x\n", pa, old, nv);
+			} else {
+				printf("USB> reg w 0x%08x <- 0x%08x\n", pa, nv);
+			}
+		} else if (op == 'p') {
+			uint32_t pa = dv_num(&s), mask = dv_num(&s), v = dv_num(&s), us = dv_num(&s);
+			if ((stop = reg_bad_addr(pa))) {
+				break;
+			}
+			vm_offset_t va = reg_va(pa);
+			if (!va) {
+				stop = "map failed";
+				break;
+			}
+			if (us > 1000000) {
+				us = 1000000;
+			}
+			uint64_t t0 = reg_us();
+			uint32_t got;
+			for (;;) {
+				got = rd32(va, 0);
+				if ((got & mask) == (v & mask) || reg_us() - t0 >= us) {
+					break;
+				}
+				delay(1);
+			}
+			uint64_t el = reg_us() - t0;
+			printf("USB> reg p 0x%08x = 0x%08x %s after %llu us\n", pa, got,
+			    (got & mask) == (v & mask) ? "ok" : "TIMEOUT", (unsigned long long)el);
+			if ((got & mask) != (v & mask)) {
+				stop = "poll timed out";
+			}
+		} else if (op == 'd') {
+			uint32_t us = dv_num(&s);
+			delay(us > 1000000 ? 1000000 : us);
+		} else if (op == 'i') {
+			uint32_t on = dv_num(&s);
+			if (!on && !ints_off) {
+				ints = ml_set_interrupts_enabled(FALSE);
+				ints_off = TRUE;
+			} else if (on && ints_off) {
+				ml_set_interrupts_enabled(ints);
+				ints_off = FALSE;
+			}
+		} else {
+			stop = "unknown op (r w m p d i)";
+		}
+		while (*s == ' ') {
+			s++;
+		}
+		if (!stop && *s && *s != ';') {
+			stop = "junk after op";
+		}
+	}
+	if (ints_off) {
+		ml_set_interrupts_enabled(ints);
+	}
+	if (stop) {
+		printf("USB> reg: stopped at op %u: %s\n", n, stop);
+	} else {
+		printf("USB> reg: %u op(s) done\n", n);
+	}
+}
