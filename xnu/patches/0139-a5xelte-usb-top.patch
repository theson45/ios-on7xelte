+/*
+ * top [SECS]: CPU time (user + system, all threads, dead ones too) of every
+ * process over SECS seconds (default 5; 0 = since the process started), the
+ * busiest 20 first. Runs in its own thread so the USB thread keeps going.
+ */
+#define UD_TOP_MAX      512
+struct ud_top_ent {
+	int pid;
+	uint64_t t;             /* absolute time units */
+	char name[20];
+};
+static struct ud_top_ent ud_top_a[UD_TOP_MAX], ud_top_b[UD_TOP_MAX];
+static int ud_top_na, ud_top_nb;
+static int ud_top_busy;
+static unsigned ud_top_secs;
+
+static int
+ud_top_proc(proc_t p, void *arg)
+{
+	struct ud_top_ent *e = arg;
+	int *n = (e == ud_top_a) ? &ud_top_na : &ud_top_nb;
+	task_t task = proc_task(p);
+	if (*n >= UD_TOP_MAX || task == TASK_NULL) {
+		return PROC_RETURNED;
+	}
+	struct task_absolutetime_info ti;
+	mach_msg_type_number_t cnt = TASK_ABSOLUTETIME_INFO_COUNT;
+	if (task_info(task, TASK_ABSOLUTETIME_INFO, (task_info_t)&ti, &cnt) != KERN_SUCCESS) {
+		return PROC_RETURNED;
+	}
+	e += *n;
+	e->pid = proc_pid(p);
+	e->t = ti.total_user + ti.total_system;
+	proc_name(e->pid, e->name, sizeof(e->name));
+	(*n)++;
+	return PROC_RETURNED;
+}
+
+static void
+ud_top_thread(void *arg __unused, wait_result_t w __unused)
+{
+	unsigned secs = ud_top_secs;
+	uint64_t t0 = mach_absolute_time(), t1, ns, sum = 0;
+	ud_top_na = ud_top_nb = 0;
+	if (secs) {
+		proc_iterate(PROC_ALLPROCLIST, ud_top_proc, ud_top_a, NULL, NULL);
+		ud_sleep_ms(secs * 1000);
+	}
+	proc_iterate(PROC_ALLPROCLIST, ud_top_proc, ud_top_b, NULL, NULL);
+	t1 = mach_absolute_time();
+	for (int i = 0; i < ud_top_nb; i++) {
+		if (secs) {
+			uint64_t base = 0;
+			for (int j = 0; j < ud_top_na; j++) {
+				if (ud_top_a[j].pid == ud_top_b[i].pid) {
+					base = ud_top_a[j].t;
+					break;
+				}
+			}
+			ud_top_b[i].t = ud_top_b[i].t > base ? ud_top_b[i].t - base : 0;
+		}
+		sum += ud_top_b[i].t;
+	}
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	absolutetime_to_nanoseconds(sum, &sum);
+	printf("USB> top: %d processes, %llu ms CPU in %llu ms wall (%u CPUs)\n", ud_top_nb,
+	    sum / 1000000, ns / 1000000, (unsigned)ml_get_max_cpus());
+	for (int k = 0; k < 20; k++) {
+		int best = -1;
+		for (int i = 0; i < ud_top_nb; i++) {
+			if (ud_top_b[i].pid >= 0 && (best < 0 || ud_top_b[i].t > ud_top_b[best].t)) {
+				best = i;
+			}
+		}
+		if (best < 0 || ud_top_b[best].t == 0) {
+			break;
+		}
+		uint64_t bns;
+		absolutetime_to_nanoseconds(ud_top_b[best].t, &bns);
+		printf("USB> top %5d %8llu ms %3llu%% %s\n", ud_top_b[best].pid, bns / 1000000,
+		    ns ? bns * 100 / ns : 0, ud_top_b[best].name);
+		ud_top_b[best].pid = -1;
+	}
+	__atomic_store_n(&ud_top_busy, 0, __ATOMIC_RELEASE);
+}
+
+static void
+ud_top(unsigned secs)
+{
+	thread_t thread;
+	if (__atomic_exchange_n(&ud_top_busy, 1, __ATOMIC_ACQ_REL)) {
+		printf("USB> top: already running\n");
+		return;
+	}
+	ud_top_secs = secs > 120 ? 120 : secs;
+	if (kernel_thread_start(ud_top_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		__atomic_store_n(&ud_top_busy, 0, __ATOMIC_RELEASE);
+	}
+}
