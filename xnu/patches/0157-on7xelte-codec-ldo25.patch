--- a/bsd/dev/a5xelte_dvfs.c
+++ b/bsd/dev/a5xelte_dvfs.c
@@ -594,6 +594,50 @@
 	return 0;
 }
 
+/*
+ * 0157: LDO25 (S2MPU05 L25CTRL 0x47) feeds the cod3026x core (DT
+ * vdd-supply = ldo25_reg, 1.8 V).  The bootloader leaves it off (0x28:
+ * enable bits 7:6 = 00), so codec regs 0x10-0x7F/0xD0-0xDE read 0.  The only
+ * values ever written are 0xE8 (on) and 0x28 (off); the voltage field must
+ * already be 0x28 (1.8 V) or nothing is written.
+ */
+#define PMIC_L25CTRL    0x47
+#define L25_VSEL        0x28
+#define L25_ON          0xE8
+
+static int
+pm_ldo25(int on)
+{
+	uint8_t cur = 0, back = 0, msg[2];
+	if (pm_read(PMIC_L25CTRL, &cur)) {
+		return -1;
+	}
+	if ((cur & 0x3f) != L25_VSEL) {
+		printf("USB> ldo25: ctrl 0x%02x, voltage not 1.8 V, refusing\n", cur);
+		return -1;
+	}
+	if (on < 0) {
+		printf("USB> ldo25: ctrl 0x%02x (%s)\n", cur, (cur & 0xc0) ? "on" : "off");
+		return 0;
+	}
+	msg[0] = PMIC_L25CTRL;
+	msg[1] = on ? L25_ON : L25_VSEL;
+	if (cur == msg[1]) {
+		printf("USB> ldo25: already 0x%02x\n", cur);
+		return 0;
+	}
+	if (pm_xfer(false, msg, 2, true)) {
+		return -1;
+	}
+	delay(10000);           /* ramp + codec power-on settle */
+	if (pm_read(PMIC_L25CTRL, &back) || back != msg[1]) {
+		printf("USB> ldo25: read back 0x%02x, wanted 0x%02x\n", back, msg[1]);
+		return -1;
+	}
+	printf("USB> ldo25: 0x%02x -> 0x%02x\n", cur, back);
+	return 0;
+}
+
 /* ---- 0155: cod3026x codec at 0x04 ---- */
 
 #define CODEC_ADDR      0x04
