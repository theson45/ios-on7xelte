+/* ---- RTC (S2MPU05 at 0x06, read only apart from the RUDR latch) ---- */
+
+#define RTC_ADDR        0x06
+#define RTC_UPDATE      0x02
+#define RTC_RUDR        0x01
+#define RTC_SEC         0x04
+
+static int
+rtc_read(uint8_t t[7])
+{
+	uint8_t up = 0, reg = RTC_SEC, msg[2];
+	int e;
+	if (dv.batch) {
+		return -1;
+	}
+	dv.slave = RTC_ADDR;
+	e = pm_read(RTC_UPDATE, &up);
+	if (!e) {
+		msg[0] = RTC_UPDATE;
+		msg[1] = (uint8_t)(up | RTC_RUDR);      /* copy the counters to the read buffer */
+		e = pm_xfer(false, msg, 2, true) ? -1 : 0;
+	}
+	if (!e) {
+		delay(2000);
+		e = (pm_xfer(false, &reg, 1, false) || pm_xfer(true, t, 7, true)) ? -1 : 0;
+	}
+	dv.slave = 0;
+	return e;
+}
+
+/* days since 1970-01-01 (proleptic Gregorian) */
+static int64_t
+days_from_civil(int64_t y, unsigned m, unsigned d)
+{
+	y -= m <= 2;
+	const int64_t era = (y >= 0 ? y : y - 399) / 400;
+	const unsigned yoe = (unsigned)(y - era * 400);
+	const unsigned mp = m > 2 ? m - 3 : m + 9;
+	const unsigned doy = (153 * mp + 2) / 5 + d - 1;
+	const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+	return era * 146097 + (int64_t)doe - 719468;
+}
+
+static void
+time_cmd(const char *arg)
+{
+	clock_sec_t now;
+	clock_usec_t us;
+	uint8_t t[7];
+	clock_get_calendar_microtime(&now, &us);
+	if (*arg >= '0' && *arg <= '9') {
+		const char *s = arg;
+		uint64_t v = 0;
+		while (*s >= '0' && *s <= '9') {
+			v = v * 10 + (uint64_t)(*s++ - '0');
+		}
+		if (v < 1577836800ull || v > 4102444800ull) {
+			printf("USB> time: %llu out of 2020..2100, ignored\n", v);
+			return;
+		}
+		clock_set_calendar_microtime((clock_sec_t)v, 0);
+		printf("USB> time: clock %lu -> %llu (from the host)\n", (unsigned long)now, v);
+		return;
+	}
+	if (rtc_read(t)) {
+		printf("USB> time: clock %lu, RTC read failed\n", (unsigned long)now);
+		return;
+	}
+	unsigned sec = t[0] & 0x7f, min = t[1] & 0x7f, hour = t[2] & 0x1f;
+	unsigned day = t[4] & 0x1f, mon = t[5] & 0x0f, year = 2000u + (t[6] & 0x7f);
+	bool ok = sec < 60 && min < 60 && hour < 24 && day >= 1 && day <= 31 && mon >= 1 && mon <= 12;
+	uint64_t rtc = ok ? (uint64_t)(days_from_civil(year, mon, day) * 86400 + hour * 3600 + min * 60 + sec) : 0;
+	printf("USB> time: clock %lu, RTC %04u-%02u-%02u %02u:%02u:%02u = %llu%s\n", (unsigned long)now,
+	    year, mon, day, hour, min, sec, rtc, ok ? "" : " (invalid)");
+	if (!strcmp(arg, "rtc") && ok) {
+		if (now >= 1577836800ul) {
+			printf("USB> time: clock already set, RTC not used\n");
+		} else {
+			clock_set_calendar_microtime((clock_sec_t)rtc, 0);
+			printf("USB> time: clock set from the RTC\n");
+		}
+	}
+}
