+extern void sweet_hid_key(int key, int down);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern bool a5xelte_rtc_boot(void);   /* a5xelte_dvfs.c */
+
+void on7xelte_input_start(void);
+int on7xelte_fg_read(unsigned *mv, int *ma, unsigned *soc100);
+
+#define ALIVE_PA        0x139f0000ull
+#define TOP_PA          0x139b0000ull   /* gpc4 CON +0x60 */
+#define TOUCH_PIN_PA    0x139d0000ull   /* gpc3 CON +0, DAT +4 */
+#define I2C3_PA         0x13840000ull   /* touch */
+#define I2C4_PA         0x13830000ull   /* fuel gauge */
+
+#define IICCON          0x00
+#define IICSTAT         0x04
+#define IICDS           0x0c
+#define CON_ACK         0xabu   /* ack, PCLK/16, int enable (pending flag), scale 11 */
+#define CON_NACK        0x2bu
+#define CON_PEND        0x10u
+
+#define TSP_ADDR        0x70
+#define TSP_F01_DATA    0x04
+#define TSP_F12_DATA    0x08
+#define TSP_SLOTS       10
+#define FG_ADDR         0x3b
+
+static struct {
+	vm_offset_t alive, top, tpin, i2c3, i2c4;
+	lck_grp_t   *grp;
+	lck_mtx_t   *fg_lock;
+	bool        started, fg_ok;
+	int         sleep;
+} in;
+
+static inline uint32_t
+rd(vm_offset_t b, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(b + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr(vm_offset_t b, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(b + off) = v;
+}
+
+static void
+in_sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&in.sleep, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- S3C polled I2C ---------------------------------------------------- */
+
+static int
+s3c_wait(vm_offset_t b)
+{
+	for (int i = 0; i < 1000; i++) {                /* 10 ms; a byte takes ~25 us */
+		if (rd(b, IICCON) & CON_PEND) {
+			return 0;
+		}
+		delay(10);
+	}
+	return -1;
+}
+
+static void
+s3c_stop(vm_offset_t b, bool rx)
+{
+	wr(b, IICSTAT, rx ? 0x90u : 0xd0u);
+	wr(b, IICCON, CON_NACK);                        /* clears pending, sends stop */
+	for (int i = 0; i < 100 && (rd(b, IICSTAT) & (1u << 5)); i++) {  /* bus busy */
+		delay(5);
+	}
+}
+
+/* START, address + write; returns 0 on ACK. */
+static int
+s3c_start_tx(vm_offset_t b, uint8_t addr7)
+{
+	wr(b, IICSTAT, 0x10);
+	wr(b, IICCON, CON_ACK);
+	wr(b, IICDS, (uint32_t)addr7 << 1);
+	wr(b, IICSTAT, 0xf0);
+	if (s3c_wait(b) || (rd(b, IICSTAT) & 1u)) {
+		return -1;
+	}
+	return 0;
+}
+
+static int
+s3c_tx_byte(vm_offset_t b, uint8_t v)
+{
+	wr(b, IICDS, v);
+	wr(b, IICCON, CON_ACK);
+	if (s3c_wait(b) || (rd(b, IICSTAT) & 1u)) {
+		return -1;
+	}
+	return 0;
+}
+
+static int
+s3c_read(vm_offset_t b, uint8_t addr7, uint8_t reg, uint8_t *buf, uint32_t n)
+{
+	if (s3c_start_tx(b, addr7) || s3c_tx_byte(b, reg)) {
+		s3c_stop(b, false);
+		return -1;
+	}
+	wr(b, IICDS, ((uint32_t)addr7 << 1) | 1u);
+	wr(b, IICSTAT, 0xb0);                           /* repeated START, master receive */
+	wr(b, IICCON, CON_ACK);
+	if (s3c_wait(b) || (rd(b, IICSTAT) & 1u)) {
+		s3c_stop(b, true);
+		return -1;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		wr(b, IICCON, i + 1 == n ? CON_NACK : CON_ACK);
+		if (s3c_wait(b)) {
+			s3c_stop(b, true);
+			return -1;
+		}
+		buf[i] = (uint8_t)rd(b, IICDS);
+	}
+	s3c_stop(b, true);
+	return 0;
+}
+
+static int
+s3c_write(vm_offset_t b, uint8_t addr7, const uint8_t *buf, uint32_t n)
+{
+	int e = s3c_start_tx(b, addr7);
+	for (uint32_t i = 0; !e && i < n; i++) {
+		e = s3c_tx_byte(b, buf[i]);
+	}
+	s3c_stop(b, false);
+	return e;
+}
+
+/* Low byte of a pinctrl CON register: pins 0 and 1 to function 2 (I2C). */
+static void
+pins_to_i2c(vm_offset_t pin, uint32_t con_off, const char *name)
+{
+	uint32_t con = rd(pin, con_off);
+	if ((con & 0xffu) != 0x22u) {
+		wr(pin, con_off, (con & ~0xffu) | 0x22u);
+		printf("ON7 INPUT: %s CON 0x%x -> 0x%x (pins to I2C)\n", name, con, rd(pin, con_off));
+	}
+}
+
+/* ---- fuel gauge -------------------------------------------------------- */
+
+int
+on7xelte_fg_read(unsigned *mv, int *ma, unsigned *soc100)
+{
+	uint8_t d[6];
+	int e;
+	if (!in.fg_ok) {
+		return -1;
+	}
+	lck_mtx_lock(in.fg_lock);
+	e = s3c_read(in.i2c4, FG_ADDR, 0x04, d, sizeof(d));
+	lck_mtx_unlock(in.fg_lock);
+	if (e) {
+		return -1;
+	}
+	uint32_t vraw = (uint32_t)d[0] | ((uint32_t)d[1] << 8);
+	int16_t craw = (int16_t)((uint16_t)d[2] | ((uint16_t)d[3] << 8));
+	int16_t sraw = (int16_t)((uint16_t)d[4] | ((uint16_t)d[5] << 8));
+	*mv = (vraw * 1000u) >> 13;
+	*ma = -(((int32_t)craw * 1000) / 4096);
+	int s = ((int32_t)sraw * 10000) / 16384;
+	*soc100 = s < 0 ? 0 : (s > 10000 ? 10000 : (unsigned)s);
+	return 0;
+}
+
+/* ---- keys -------------------------------------------------------------- */
+
+static uint32_t
+keys_sample(void)
+{
+	/* bit n = key n pressed: 0 power, 1 vol+, 2 vol-, 3 home (SweetHID order) */
+	uint32_t a0 = rd(in.alive, 0x44), a1 = rd(in.alive, 0x64), a2 = rd(in.alive, 0x84);
+	return (!(a0 & 1u) ? 1u : 0) | (!(a2 & 1u) ? 2u : 0) | (!(a2 & 2u) ? 4u : 0) |
+	       (!(a1 & 0x80u) ? 8u : 0);
+}
+
+/* ---- touch ------------------------------------------------------------- */
+
+static struct {
+	bool     on;            /* controller answered */
+	uint32_t down;          /* slots reported down */
+	int      x[TSP_SLOTS], y[TSP_SLOTS];
+	uint32_t fails, idle;
+} ts;
+
+static void
+touch_release_all(void)
+{
+	for (int i = 0; i < TSP_SLOTS; i++) {
+		if (ts.down & (1u << i)) {
+			sweet_hid_touch(i, 0, ts.x[i], ts.y[i]);
+		}
+	}
+	ts.down = 0;
+}
+
+static bool
+touch_attn(void)
+{
+	return !(rd(in.tpin, 0x04) & (1u << 2));        /* gpc3-2 low = report pending */
+}
+
+static void
+touch_service(void)
+{
+	uint8_t st[2], f[TSP_SLOTS * 8];
+	if (s3c_read(in.i2c3, TSP_ADDR, TSP_F01_DATA, st, sizeof(st)) ||
+	    s3c_read(in.i2c3, TSP_ADDR, TSP_F12_DATA, f, sizeof(f))) {
+		if (ts.on) {
+			printf("ON7 INPUT: touch stopped answering\n");
+			touch_release_all();
+		}
+		ts.on = false;
+		ts.fails++;
+		return;
+	}
+	if (!ts.on) {
+		printf("ON7 INPUT: touch answers (status 0x%02x int 0x%02x)\n", st[0], st[1]);
+		ts.on = true;
+	}
+	for (int i = 0; i < TSP_SLOTS; i++) {
+		const uint8_t *p = f + i * 8;
+		bool down = p[0] == 0x01;
+		int x = p[1] | (p[2] << 8), y = p[3] | (p[4] << 8);
+		if (down && (x > 1079 || y > 1919)) {
+			continue;       /* garbage: keep the last state */
+		}
+		if (down) {
+			ts.x[i] = x;
+			ts.y[i] = y;
+			ts.down |= 1u << i;
+			sweet_hid_touch(i, 1, x, y);
+		} else if (ts.down & (1u << i)) {
+			ts.down &= ~(1u << i);
+			sweet_hid_touch(i, 0, ts.x[i], ts.y[i]);
+		}
+	}
+}
+
+static bool
+touch_wake(void)
+{
+	/* RMI4 page 0, then one F01 read: the panel is powered with the display */
+	uint8_t page[2] = { 0xff, 0x00 }, st[2];
+	if (s3c_write(in.i2c3, TSP_ADDR, page, sizeof(page)) ||
+	    s3c_read(in.i2c3, TSP_ADDR, TSP_F01_DATA, st, sizeof(st))) {
+		return false;
+	}
+	printf("ON7 INPUT: touch at 0x%x on i2c_3 (status 0x%02x int 0x%02x)\n", TSP_ADDR, st[0], st[1]);
+	ts.on = true;
+	return true;
+}
+
+/* ---- thread ------------------------------------------------------------ */
+
+static void
+in_thread(void *arg __unused, wait_result_t w __unused)
+{
+	int keys = 1, touch = 1;
+	(void)PE_parse_boot_argn("on7keys", &keys, sizeof(keys));
+	(void)PE_parse_boot_argn("on7touch", &touch, sizeof(touch));
+	uint32_t stable = keys ? keys_sample() : 0, prev = stable, same = 0;
+	uint32_t tick = 0;
+	bool rtc_asked = false;
+
+	printf("ON7 INPUT: keys %s, touch %s, keys now 0x%x\n", keys ? "on" : "off",
+	    touch ? "on" : "off", stable);
+	for (;;) {
+		tick++;
+		if (keys) {
+			uint32_t s = keys_sample();
+			if (s == prev) {
+				same = same < 2 ? same + 1 : 2;
+			} else {
+				prev = s;
+				same = 0;
+			}
+			if (same == 2 && s != stable) {
+				for (int k = 0; k < 4; k++) {
+					if ((s ^ stable) & (1u << k)) {
+						sweet_hid_key(k, (int)((s >> k) & 1u));
+					}
+				}
+				stable = s;
+			}
+		}
+		if (touch) {
+			if (!ts.on) {
+				/* retry every 2 s (screen off / panel not powered yet) */
+				if (tick % 200 == 0) {
+					(void)touch_wake();
+				}
+			} else if (touch_attn()) {
+				ts.idle = 0;
+				touch_service();
+			} else if (ts.down && ++ts.idle >= 50) {
+				/* no report for 500 ms with fingers down: re-read once */
+				ts.idle = 0;
+				touch_service();
+			}
+		}
+		/* clock from the PMIC RTC once, 15 s in (bsd/dev/a5xelte_dvfs.c) */
+		if (!rtc_asked && tick >= 1500) {
+			rtc_asked = a5xelte_rtc_boot();
+			if (!rtc_asked && tick >= 6000) {
+				rtc_asked = true;
+			}
+		}
+		in_sleep_ms(10);
+	}
+}
+
+void
+on7xelte_input_start(void)
+{
+	int on = 1;
+	thread_t th;
+	if (in.started) {
+		return;
+	}
+	in.started = true;
+	(void)PE_parse_boot_argn("on7input", &on, sizeof(on));
+	if (!on) {
+		printf("ON7 INPUT: off (on7input=0)\n");
+		return;
+	}
+	in.alive = ml_io_map((vm_offset_t)ALIVE_PA, 0x1000);
+	in.top = ml_io_map((vm_offset_t)TOP_PA, 0x1000);
+	in.tpin = ml_io_map((vm_offset_t)TOUCH_PIN_PA, 0x1000);
+	in.i2c3 = ml_io_map((vm_offset_t)I2C3_PA, 0x1000);
+	in.i2c4 = ml_io_map((vm_offset_t)I2C4_PA, 0x1000);
+	if (!in.alive || !in.top || !in.tpin || !in.i2c3 || !in.i2c4) {
+		printf("ON7 INPUT: mapping failed\n");
+		return;
+	}
+	in.grp = lck_grp_alloc_init("on7input", LCK_GRP_ATTR_NULL);
+	in.fg_lock = lck_mtx_alloc_init(in.grp, LCK_ATTR_NULL);
+	pins_to_i2c(in.top, 0x60, "gpc4 (fuel gauge)");
+	pins_to_i2c(in.tpin, 0x00, "gpc3 (touch)");
+
+	unsigned mv = 0, soc = 0;
+	int ma = 0;
+	in.fg_ok = true;
+	if (on7xelte_fg_read(&mv, &ma, &soc)) {
+		in.fg_ok = false;
+		printf("ON7 INPUT: fuel gauge at 0x%x on i2c_4 does not answer\n", FG_ADDR);
+	} else {
+		printf("ON7 INPUT: battery %u.%02u%% %u mV %d mA\n", soc / 100, soc % 100, mv, ma);
+	}
+	(void)touch_wake();
+	if (kernel_thread_start(in_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	} else {
+		printf("ON7 INPUT: no thread\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_A5XELTE */
