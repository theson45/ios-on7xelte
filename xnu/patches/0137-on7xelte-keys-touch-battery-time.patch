+/*
+ * on7xelte (Galaxy J7 Prime, Exynos7870) keys, touch and fuel gauge.
+ *
+ * Everything here was read live with "reg" on xnu21 before it was written:
+ *   - keys, ALIVE pinctrl 0x139f0000, all active low inputs:
+ *     Power GPA0-0 (DAT +0x44 bit0), Home GPA1-7 (+0x64 bit7),
+ *     Vol+ GPA2-0 and Vol- GPA2-1 (+0x84 bit0/bit1).
+ *   - touch: Synaptics TD4300 (RMI4) at 0x70 on i2c_3 0x13840000, pins
+ *     gpc3-0/1 (pinctrl TOUCH 0x139d0000) switched to I2C, ATTN on gpc3-2
+ *     (active low). F01 data at 0x04 (+1 = interrupt status, read clears
+ *     ATTN), F12 data at 0x08: 8 bytes per finger (type, x lo/hi, y lo/hi,
+ *     z, wx, wy), type 1 = finger. Coordinates are panel pixels 1080x1920,
+ *     which is SweetHID's A5XELTE logical size.
+ *   - fuel gauge: S2MU005 at 0x3b on i2c_4 0x13830000, pins gpc4-0/1
+ *     (pinctrl TOP 0x139b0000 +0x60). VBAT 0x04 (mV = raw * 1000 >> 13),
+ *     current 0x06 (signed, mA = -raw * 1000 >> 12, positive = charging),
+ *     RSOC 0x08 (0.01 % = raw * 10000 >> 14).
+ *
+ * The two buses are the old S3C2440-style controller, driven polled here
+ * (IICCON 0xab: ack, PCLK/16/12, about 385 kHz, verified live). No
+ * interrupts are used and nothing but the I2C controllers and the two pin
+ * mux nibble pairs is written. The touch controller and the fuel gauge are
+ * only read, except the RMI4 page select (0xff = 0).
+ *
+ * Boot-args: on7input=0 turns all of it off; on7touch=0 / on7keys=0 one
+ * part. The fuel gauge is read by SweetBattery through on7xelte_fg_read().
+ */
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
