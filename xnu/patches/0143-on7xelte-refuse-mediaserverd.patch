--- a/bsd/dev/a5xelte_usb.c
+++ b/bsd/dev/a5xelte_usb.c
@@ -952,6 +952,7 @@
  * `kill PID 19` wakes one up again.
  * Boot-arg on7deny=NAME[,NAME] replaces the list, on7deny=- allows all;
  * on7denymode=refuse goes back to the 0141 behaviour (EACCES).
+ * 0143: mediaserverd is always refused, never parked (SpringBoard waits for it).
  */
 static const char ud_deny_default[] =
     "mediaserverd,audioclocksyncd,audiomxd,UARPUpdaterServiceLegacyAudio,"
@@ -1044,7 +1045,12 @@
 	if (!ud_name_in(st == 2 ? ud_deny_arg : ud_deny_default, name)) {
 		return 0;
 	}
-	if (!ud_deny_refuse && pid > 0) {
+	/*
+	 * 0143: SpringBoard waits for mediaserverd at boot. Parked, it never
+	 * answers and the UI never comes (xnu27: logo for 20 minutes, back the
+	 * moment it was continued). Refused, SpringBoard gets an error at once.
+	 */
+	if (!ud_deny_refuse && pid > 0 && !ud_name_in("mediaserverd", name)) {
 		ud_park(pid);
 		return 2;
 	}
