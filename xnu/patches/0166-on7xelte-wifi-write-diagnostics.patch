+/* 0166: 'wifi wr ADDR VAL': one 32-bit backplane write (CMD53), then the word read back */
+static void
+wf_wr_cmd(const char *a)
+{
+	bool ok1, ok2;
+	uint32_t x = wf_hex(&a, &ok1), v = wf_hex(&a, &ok2);
+
+	if (!wf_chipid || !wf_mmc) {
+		printf("USB> wifi: not powered (wifi probe keep, or a stopped wifi fw, first)\n");
+		return;
+	}
+	if (!ok1 || !ok2) {
+		printf("USB> wifi: wr ADDR VAL\n");
+		return;
+	}
+	x &= ~3u;
+	wf_bad = false;
+	wf_errs = 0;
+	uint32_t before = wf_rd32(x);
+	bool rb = !wf_bad;
+	wf_wr32(x, v);
+	bool wok = !wf_bad;
+	wf_bad = false;
+	uint32_t after = wf_rd32(x);
+	printf("USB> wifi: wr 0x%08x = 0x%08x: before 0x%08x%s, write %s, after 0x%08x%s (bus %u-bit)\n", x, v, before,
+	    rb ? "" : " (read failed)", wok ? "ok" : "FAILED", after, wf_bad ? " (read failed)" : "",
+	    rd32(wf_mmc, M_CTYPE) ? 4 : 1);
+	wf_bad = false;
+}
