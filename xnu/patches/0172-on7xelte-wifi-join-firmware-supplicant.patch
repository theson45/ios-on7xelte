+/*
+ * ---- W5 (0172): joining a network with the firmware's own supplicant ----
+ * After brcmfmac cfg80211.c brcmf_cfg80211_connect / brcmf_set_pmk (firmware PSK supplicant, "sup_wpa").
+ * Events seen during a join are told by name; LINK (flags bit 0) and PSK_SUP keyed (status 6) end it.
+ */
+static bool wf_joining;
+static uint32_t wf_j_link, wf_j_keyed, wf_j_fail, wf_j_ssid;
+
+static const char *
+wf_evname(uint32_t t)
+{
+	switch (t) {
+	case 0: return "SET_SSID";
+	case 1: return "JOIN";
+	case 3: return "AUTH";
+	case 5: return "DEAUTH";
+	case 6: return "DEAUTH_IND";
+	case 7: return "ASSOC";
+	case 9: return "REASSOC";
+	case 11: return "DISASSOC";
+	case 12: return "DISASSOC_IND";
+	case 16: return "LINK";
+	case 46: return "PSK_SUP";
+	case 54: return "IF";
+	default: return "event";
+	}
+}
+
+static void
+wf_join_event(uint32_t type, uint32_t status, uint32_t reason, uint32_t flags)
+{
+	printf("USB> wifi: JOIN event %s (%u) status %u reason %u flags 0x%x\n", wf_evname(type), type, status, reason,
+	    flags);
+	if (type == 0) {
+		wf_j_ssid = status + 1;
+		if (status != 0) {
+			wf_j_fail = 1;
+		}
+	} else if (type == 16) {
+		if (flags & 1) {
+			wf_j_link = 1;
+		} else {
+			wf_j_link = 0;
+			wf_j_fail = 2;
+		}
+	} else if (type == 46) {
+		if (status == 6) {              /* WLC_SUP_KEYED */
+			wf_j_keyed = 1;
+		} else if (status != 0 && status != 4 && status != 5) {
+			wf_j_fail = 3;
+		}
+	} else if (type == 6 || type == 12 || (type == 3 && status != 0)) {
+		wf_j_fail = 4;
+	}
+}
+
