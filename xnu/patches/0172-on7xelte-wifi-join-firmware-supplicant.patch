+/* hex text to bytes, up to a space or the end; -1 if not hex or too long */
+static int
+wf_unhex(const char **pp, uint8_t *out, uint32_t max)
+{
+	const char *p = *pp;
+	uint32_t n = 0;
+
+	while (*p == ' ') {
+		p++;
+	}
+	while (*p && *p != ' ') {
+		int v[2];
+		for (int k = 0; k < 2; k++) {
+			char c = p[k];
+			v[k] = (c >= '0' && c <= '9') ? c - '0' : (c >= 'a' && c <= 'f') ? c - 'a' + 10 :
+			    (c >= 'A' && c <= 'F') ? c - 'A' + 10 : -1;
+			if (v[k] < 0) {
+				return -1;
+			}
+		}
+		if (n >= max) {
+			return -1;
+		}
+		out[n++] = (uint8_t)(v[0] << 4 | v[1]);
+		p += 2;
+	}
+	*pp = p;
+	return (int)n;
+}
+
+static int
+wf_ioc_int(uint32_t cmd, uint32_t v)
+{
+	return wf_dcmd(cmd, true, (const uint8_t *)&v, 4);
+}
+
+static int
+wf_iovar_int(const char *name, uint32_t v)
+{
+	return wf_iovar_set(name, &v, 4);
+}
+
+/* the firmware's capability string ("cap"): does it have the supplicant (idsup)? */
+static void
+wf_cap_show(void)
+{
+	if (wf_iovar_get("cap", 300) != 0) {
+		return;
+	}
+	char v[200];
+	uint32_t k = 0;
+	for (; k < wf_ctl_len && k < sizeof(v) - 1 && wf_ctl[k]; k++) {
+		v[k] = (wf_ctl[k] >= 0x20 && wf_ctl[k] < 0x7f) ? (char)wf_ctl[k] : ' ';
+	}
+	v[k] = 0;
+	printf("USB> wifi: cap = \"%s\"\n", v);
+}
+
+/* 'wifi link': BSSID and RSSI of the current association */
+static void
+wf_link_cmd(void)
+{
+	if (!wf_w4_ready()) {
+		return;
+	}
+	static const uint8_t z[8] = { 0 };
+	int st = wf_dcmd(23, false, z, 6);              /* WLC_GET_BSSID */
+	uint8_t b[6] = { 0 };
+	if (st == 0 && wf_ctl_len >= 6) {
+		memcpy(b, wf_ctl, 6);
+	}
+	int st2 = wf_dcmd(127, false, z, 4);            /* WLC_GET_RSSI */
+	int32_t rssi = 0;
+	if (st2 == 0 && wf_ctl_len >= 4) {
+		memcpy(&rssi, wf_ctl, 4);
+	}
+	printf("USB> wifi: link: BSSID %02x:%02x:%02x:%02x:%02x:%02x (status %d), RSSI %d (status %d)\n", b[0], b[1],
+	    b[2], b[3], b[4], b[5], st, (int)rssi, st2);
+}
+
+/*
+ * 'wifi join SSIDHEX PASSHEX|-' (sent by tools/on7xelte-wifi-join.py; the echo lines hide the arguments).
+ * WPA2-PSK (AES) with the firmware supplicant, or an open network for '-'.
+ */
+static void
+wf_join_cmd(const char *a)
+{
+	uint8_t ssid[32], pw[64];
+	int sl = wf_unhex(&a, ssid, sizeof(ssid)), pl = 0;
+
+	while (*a == ' ') {
+		a++;
+	}
+	if (sl <= 0) {
+		printf("USB> wifi: join SSIDHEX PASSHEX|- (use tools/on7xelte-wifi-join.py)\n");
+		return;
+	}
+	if (!(a[0] == '-' && (a[1] == 0 || a[1] == ' '))) {
+		pl = wf_unhex(&a, pw, sizeof(pw) - 1);
+		if (pl < 8) {
+			printf("USB> wifi: join: the password must be 8..63 characters (hex)\n");
+			bzero(pw, sizeof(pw));
+			return;
+		}
+	}
+	char name[33];
+	for (int k = 0; k < sl; k++) {
+		name[k] = (ssid[k] >= 0x20 && ssid[k] < 0x7f) ? (char)ssid[k] : '?';
+	}
+	name[sl] = 0;
+	if (!wf_w4_ready()) {
+		bzero(pw, sizeof(pw));
+		return;
+	}
+	printf("USB> wifi: JOIN \"%s\" (%s)\n", name, pl ? "WPA2-PSK, firmware supplicant" : "open");
+	wf_cap_show();
+	int up = wf_ioc_int(WLC_UP, 0);
+	/* events of a join on, ESCAN kept */
+	int em = wf_iovar_get("event_msgs", 16);
+	if (em == 0 && wf_ctl_len >= 16) {
+		static const uint8_t ev[] = { 0, 1, 3, 5, 6, 7, 9, 11, 12, 16, 46, 69 };
+		uint8_t mask[16];
+		memcpy(mask, wf_ctl, 16);
+		for (uint32_t k = 0; k < sizeof(ev); k++) {
+			mask[ev[k] / 8] |= (uint8_t)(1u << (ev[k] % 8));
+		}
+		em = wf_iovar_set("event_msgs", mask, 16);
+	}
+	int infra = wf_ioc_int(20, 1);                  /* WLC_SET_INFRA: BSS */
+	int auth = wf_ioc_int(22, 0);                   /* WLC_SET_AUTH: open system */
+	int wsec = wf_ioc_int(134, pl ? 4u : 0u);       /* WLC_SET_WSEC: AES */
+	int wpa = wf_ioc_int(165, pl ? 0x80u : 0u);     /* WLC_SET_WPA_AUTH: WPA2_AUTH_PSK */
+	int sup = wf_iovar_int("sup_wpa", pl ? 1u : 0u);
+	int pmk = 0;
+	if (pl) {
+		/* wsec_pmk: key_len, flags WSEC_PASSPHRASE, the passphrase */
+		uint8_t k[68];
+		bzero(k, sizeof(k));
+		k[0] = (uint8_t)pl;
+		k[2] = 1;
+		memcpy(k + 4, pw, (size_t)pl);
+		pmk = wf_dcmd(268, true, k, sizeof(k));     /* WLC_SET_WSEC_PMK */
+		bzero(k, sizeof(k));
+	}
+	bzero(pw, sizeof(pw));
+	printf("USB> wifi: JOIN setup: up %d event_msgs %d infra %d auth %d wsec %d wpa_auth %d sup_wpa %d pmk %d\n", up,
+	    em, infra, auth, wsec, wpa, sup, pmk);
+	if (up == -999 || infra == -999 || pmk == -999) {
+		return;
+	}
+	uint8_t sj[36];
+	bzero(sj, sizeof(sj));
+	sj[0] = (uint8_t)sl;
+	memcpy(sj + 4, ssid, (size_t)sl);
+	wf_j_link = wf_j_keyed = wf_j_fail = wf_j_ssid = 0;
+	wf_joining = true;
+	int st = wf_dcmd(26, true, sj, sizeof(sj));     /* WLC_SET_SSID */
+	printf("USB> wifi: JOIN: SET_SSID status %d\n", st);
+	uint64_t t0 = mach_absolute_time(), ns = 0;
+	for (int t = 0; st == 0 && t < 10000 && !wf_bad && !wf_j_fail && !(wf_j_link && (wf_j_keyed || !pl)); t++) {
+		wf_poll();
+		delay(2000);
+	}
+	wf_joining = false;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	bool ok = wf_j_link && (wf_j_keyed || !pl);
+	printf("USB> wifi: JOIN %s after %llu ms (link %u keyed %u fail %u set_ssid %u)%s\n", ok ? "DONE: associated" :
+	    "FAILED", ns / 1000000, wf_j_link, wf_j_keyed, wf_j_fail, wf_j_ssid, wf_bad ? " (a bus access failed)" : "");
+	if (ok) {
+		wf_link_cmd();
+	}
+}
