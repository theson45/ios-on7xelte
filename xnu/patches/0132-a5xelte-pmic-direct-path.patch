+/* exynos5_i2c_reset() + exynos5_i2c_init(), fast mode, with the bootloader's timing */
+static void
+pm_dinit(void)
+{
+	vm_offset_t r = dv.i2c;
+
+	if (!dv.dsaved) {
+		for (int i = 0; i < 4; i++) {
+			dv.dtim[i] = rd32(r, I2C_FS1 + 4 * i);
+		}
+		dv.dconf = rd32(r, I2C_CONF);
+		if (dv.dtim[2] == 0) {
+			/* not set up: 400 kHz values of the 0129 batcher sequence */
+			dv.dtim[0] = (38u << 24) | (38u << 16) | (38u << 8);
+			dv.dtim[1] = (0xfu << 16) | (19u << 24) | (38u << 8) | 38u;
+			dv.dtim[2] = (1u << 16) | 76u;
+			dv.dtim[3] = 19;
+		}
+		dv.dsaved = true;
+		printf("USB> pmic: direct timing fs 0x%x 0x%x 0x%x sla 0x%x conf 0x%x\n",
+		    dv.dtim[0], dv.dtim[1], dv.dtim[2], dv.dtim[3], dv.dconf);
+	}
+	wr32(r, HSI2C_BATCHER_INT_EN, 0);
+	wr32(r, HSI2C_BATCHER_CON, 0);
+	wr32(r, I2C_CTL, rd32(r, I2C_CTL) | (1u << 31));        /* SW_RST */
+	wr32(r, I2C_CTL, rd32(r, I2C_CTL) & ~(1u << 31));
+	for (int i = 0; i < 4; i++) {
+		wr32(r, I2C_FS1 + 4 * i, dv.dtim[i]);
+	}
+	wr32(r, I2C_CTL, 1u << 3);                              /* MASTER */
+	wr32(r, I2C_TRAILING, 0xf);
+	wr32(r, I2C_ADDR, 0);
+	wr32(r, I2C_CONF, (dv.dconf | (1u << 31)) & ~((1u << 30) | (1u << 29)));   /* AUTO, 7-bit, FS */
+	dv.dinit = true;
+}
