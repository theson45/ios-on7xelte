+/* 0162: a hex number of the command line; *ok false if there was none */
+static uint32_t
+wf_hex(const char **pp, bool *ok)
+{
+	const char *p = *pp;
+	uint32_t v = 0, n = 0;
+
+	while (*p == ' ') {
+		p++;
+	}
+	if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
+		p += 2;
+	}
+	for (;; p++, n++) {
+		char c = *p;
+		uint32_t d;
+		if (c >= '0' && c <= '9') {
+			d = (uint32_t)(c - '0');
+		} else if (c >= 'a' && c <= 'f') {
+			d = (uint32_t)(c - 'a' + 10);
+		} else if (c >= 'A' && c <= 'F') {
+			d = (uint32_t)(c - 'A' + 10);
+		} else {
+			break;
+		}
+		v = (v << 4) | d;
+	}
+	*ok = n > 0;
+	*pp = p;
+	return v;
+}
+
+/* 0162: 'wifi rd ADDR [N]': N (hex, <= 0x40) words of the backplane; 'wifi cr FN ADDR': one CMD52 read */
+static void
+wf_rd_cmd(const char *a, bool c52)
+{
+	bool ok1, ok2;
+	uint32_t x = wf_hex(&a, &ok1), y = wf_hex(&a, &ok2);
+
+	if (!wf_chipid || !wf_mmc) {
+		printf("USB> wifi: not powered (wifi probe keep, or a stopped wifi fw, first)\n");
+		return;
+	}
+	if (c52) {
+		if (!ok1 || !ok2) {
+			printf("USB> wifi: cr FN ADDR\n");
+			return;
+		}
+		int v = wf_rd8(x & 7, y);
+		printf("USB> wifi: CMD52 fn %u 0x%05x = %d (0x%02x) err 0x%08x R5 0x%08x\n", x & 7, y & 0x1ffff, v,
+		    v & 0xff, wf_last_e, wf_last_r);
+		return;
+	}
+	if (!ok1) {
+		printf("USB> wifi: rd ADDR [N]\n");
+		return;
+	}
+	uint32_t n = ok2 ? y : 1;
+	if (n == 0 || n > 0x40) {
+		n = 1;
+	}
+	x &= ~3u;
+	wf_bad = false;
+	for (uint32_t i = 0; i < n && !wf_bad; i += 4) {
+		uint32_t v[4] = { 0, 0, 0, 0 };
+		for (uint32_t k = 0; k < 4 && i + k < n; k++) {
+			v[k] = wf_rd32(x + 4 * (i + k));
+		}
+		printf("USB> wifi: 0x%08x: %08x %08x %08x %08x%s\n", x + 4 * i, v[0], v[1], v[2], v[3],
+		    wf_bad ? " (a read failed)" : "");
+	}
+	wf_bad = false;
+}
