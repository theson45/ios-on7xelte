+/*
+ * 0144: every line in the ring (USB log, eMMC log) starts with "[sec.ms] ",
+ * time since boot. Only the ring gets it, the screen does not. The
+ * line-start flag is not locked: two CPUs printing at once may lose or
+ * double a stamp, never more.
+ */
+static uint64_t emmc_log_abs_per_ms;
+static int emmc_log_mid_line;
+
+static void
+emmc_log_stamp(void)
+{
+	char buf[28];
+	int n = (int)sizeof(buf);
+	uint64_t per = emmc_log_abs_per_ms;
+	if (per == 0) {
+		nanoseconds_to_absolutetime(NSEC_PER_MSEC, &per);
+		if (per == 0) {
+			return;         /* timebase not set up yet */
+		}
+		emmc_log_abs_per_ms = per;
+	}
+	uint64_t ms = mach_absolute_time() / per;
+	buf[--n] = ' ';
+	buf[--n] = ']';
+	for (int i = 0; i < 3; i++) {
+		buf[--n] = (char)('0' + ms % 10);
+		ms /= 10;
+	}
+	buf[--n] = '.';
+	do {
+		buf[--n] = (char)('0' + ms % 10);
+		ms /= 10;
+	} while (ms != 0 && n > 1);
+	buf[--n] = '[';
+	emmc_log_raw(buf + n, (int)sizeof(buf) - n);
+}
+
+void a5xelte_log_append(const char *c, int size);
+void
+a5xelte_log_append(const char *c, int size)
+{
+	int start = 0;
+	for (int i = 0; i < size; i++) {
+		if (!emmc_log_mid_line) {
+			emmc_log_mid_line = 1;
+			emmc_log_stamp();
+		}
+		if (c[i] == '\n') {
+			emmc_log_raw(c + start, i + 1 - start);
+			start = i + 1;
+			emmc_log_mid_line = 0;
+		}
+	}
+	if (start < size) {
+		emmc_log_raw(c + start, size - start);
+	}
+}
