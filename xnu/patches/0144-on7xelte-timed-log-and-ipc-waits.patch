 #include <libkern/coreanalytics/coreanalytics.h>
 
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+
+/*
+ * 0144: who waits for whom. A thread that sends a request and waits for
+ * the reply on its own reply port (send+receive, local port == receive
+ * port) is stamped with the time and the receiver's pid. A watchdog thread
+ * prints the ones still waiting after 2, 5, 10, 20, 40... s:
+ *   WAIT SpringBoard(34) tid 812: 5 s for mediaserverd(28), msg id 1234
+ * and when a reply took 500 ms or more the waiter prints:
+ *   RPC SpringBoard(34) tid 812 -> mediaserverd(28) id 1234: 5210 ms
+ * pid -1 ("kernel") means a kernel object (IOKit, task ports...) or a port
+ * with no receiver right now.
+ */
+extern void proc_name(int pid, char * buf, int size);
+
+#define A5_RPC_SLOW_MS  500
+#define A5_RPC_WD_MAX   32
+
+static int a5_rpc_wd_started;
+static const uint32_t a5_rpc_steps[] = { 2, 5, 10, 20, 40, 80, 160, 320, 640, 1280 };
+#define A5_RPC_NSTEPS   ((uint32_t)(sizeof(a5_rpc_steps) / sizeof(a5_rpc_steps[0])))
+
+struct a5_rpc_seen {
+	uint64_t tid, secs;
+	int pid, dst, msgid;
+};
+
+static void
+a5_rpc_name(int pid, char *buf, int size)
+{
+	if (pid < 0) {
+		strlcpy(buf, "kernel", size);
+		return;
+	}
+	buf[0] = '\0';
+	proc_name(pid, buf, size);
+	if (buf[0] == '\0') {
+		strlcpy(buf, "?", size);
+	}
+}
+
+static void
+a5_rpc_watchdog(void *arg __unused, wait_result_t wr __unused)
+{
+	static struct a5_rpc_seen seen[A5_RPC_WD_MAX];
+	uint64_t per_s = 0;
+
+	for (;;) {
+		assert_wait_timeout((event_t)&a5_rpc_wd_started, THREAD_UNINT,
+		    1000, NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+
+		if (per_s == 0) {
+			nanoseconds_to_absolutetime(NSEC_PER_SEC, &per_s);
+			if (per_s == 0) {
+				continue;
+			}
+		}
+		uint64_t now = mach_absolute_time();
+		int n = 0, more = 0;
+		thread_t thread;
+
+		lck_mtx_lock(&tasks_threads_lock);
+		queue_iterate(&threads, thread, thread_t, threads) {
+			uint64_t start = *(volatile uint64_t *)&thread->a5_rpc_start;
+			if (start == 0 || now <= start) {
+				continue;
+			}
+			uint64_t secs = (now - start) / per_s;
+			uint32_t rep = thread->a5_rpc_rep;
+			if (rep >= A5_RPC_NSTEPS || secs < a5_rpc_steps[rep]) {
+				continue;
+			}
+			while (rep < A5_RPC_NSTEPS && secs >= a5_rpc_steps[rep]) {
+				rep++;
+			}
+			thread->a5_rpc_rep = rep;
+			if (n < A5_RPC_WD_MAX) {
+				seen[n].tid = thread_tid(thread);
+				seen[n].secs = secs;
+				seen[n].pid = task_pid(get_threadtask(thread));
+				seen[n].dst = thread->a5_rpc_pid;
+				seen[n].msgid = thread->a5_rpc_msgid;
+				n++;
+			} else {
+				more++;
+			}
+		}
+		lck_mtx_unlock(&tasks_threads_lock);
+
+		for (int i = 0; i < n; i++) {
+			char me[32], to[32];
+			a5_rpc_name(seen[i].pid, me, sizeof(me));
+			a5_rpc_name(seen[i].dst, to, sizeof(to));
+			printf("WAIT %s(%d) tid %llu: %llu s for %s(%d), msg id %d\n",
+			    me, seen[i].pid, seen[i].tid, seen[i].secs, to, seen[i].dst,
+			    seen[i].msgid);
+		}
+		if (more) {
+			printf("WAIT ... and %d more threads\n", more);
+		}
+	}
+}
+
+static void
+a5_rpc_begin(mach_port_name_t dest, mach_msg_id_t id)
+{
+	thread_t self = current_thread();
+	ipc_port_t port = IP_NULL;
+	int pid = -1;
+
+	if (ipc_port_translate_send(current_space(), dest, &port) == KERN_SUCCESS) {
+		pid = ipc_port_get_receiver_task_locked(port, NULL);
+		ip_mq_unlock(port);
+	}
+	self->a5_rpc_pid = pid;
+	self->a5_rpc_msgid = id;
+	self->a5_rpc_rep = 0;
+	__atomic_store_n(&self->a5_rpc_start, mach_absolute_time(), __ATOMIC_RELEASE);
+
+	if (!__atomic_load_n(&a5_rpc_wd_started, __ATOMIC_RELAXED) &&
+	    !__atomic_exchange_n(&a5_rpc_wd_started, 1, __ATOMIC_ACQ_REL)) {
+		thread_t wd;
+		if (kernel_thread_start(a5_rpc_watchdog, NULL, &wd) == KERN_SUCCESS) {
+			thread_deallocate(wd);
+		}
+	}
+}
+
+static void
+a5_rpc_end(void)
+{
+	thread_t self = current_thread();
+	uint64_t start = self->a5_rpc_start;
+	uint64_t ns = 0, now;
+
+	if (start == 0) {
+		return;
+	}
+	__atomic_store_n(&self->a5_rpc_start, 0, __ATOMIC_RELEASE);
+	now = mach_absolute_time();
+	if (now > start) {
+		absolutetime_to_nanoseconds(now - start, &ns);
+	}
+	if (ns >= A5_RPC_SLOW_MS * NSEC_PER_MSEC) {
+		char me[32], to[32];
+		int mypid = task_pid(current_task());
+		a5_rpc_name(mypid, me, sizeof(me));
+		a5_rpc_name(self->a5_rpc_pid, to, sizeof(to));
+		printf("RPC %s(%d) tid %llu -> %s(%d) id %d: %llu ms\n", me, mypid,
+		    thread_tid(self), to, self->a5_rpc_pid, self->a5_rpc_msgid,
+		    ns / NSEC_PER_MSEC);
+	}
+}
