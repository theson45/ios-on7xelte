+static char   reg_buf[2048];
+static size_t reg_len;
+static bool   reg_hold;
+
+static void reg_out(const char *fmt, ...) __printflike(1, 2);
+
+static void
+reg_out(const char *fmt, ...)
+{
+	va_list ap;
+	va_start(ap, fmt);
+	if (reg_hold) {
+		if (reg_len < sizeof(reg_buf) - 1) {
+			int n = vsnprintf(reg_buf + reg_len, sizeof(reg_buf) - reg_len, fmt, ap);
+			if (n > 0) {
+				reg_len += (size_t)n;
+			}
+			if (reg_len > sizeof(reg_buf) - 1) {
+				reg_len = sizeof(reg_buf) - 1;
+			}
+		}
+	} else {
+		char line[200];
+		vsnprintf(line, sizeof(line), fmt, ap);
+		printf("%s", line);
+	}
+	va_end(ap);
+}
+
+static void
+reg_flush(void)
+{
+	if (reg_len) {
+		printf("%s", reg_buf);
+		reg_len = 0;
+		reg_buf[0] = '\0';
+	}
+}
