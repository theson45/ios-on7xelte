+/*
+ * 0181: configd's InterfaceNamer opens the IONetworkStack (IONetworkingFamily) before anything else and gives up
+ * without it: then it never posts "*QUIET*" or "*TIMEOUT*" under Plugin:InterfaceNamer, and SCNetworkInterfaceCopyAll()
+ * (wifid) waits for one of them for good. Its user client names interfaces that have no BSD name yet; en0 has one,
+ * so every command is only logged and answered with success.
+ */
+class IONetworkStack : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkStack);
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+class IONetworkStackUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(IONetworkStackUserClient);
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+IOReturn
+IONetworkStack::newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties,
+    IOUserClient **handler)
+{
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IONetworkStackUserClient *uc = OSTypeAlloc(IONetworkStackUserClient);
+	if (uc == NULL || !uc->initWithTask(owningTask, securityID, type)) {
+		OSSafeReleaseNULL(uc);
+		return kIOReturnNoMemory;
+	}
+	if (!uc->attach(this)) {
+		uc->release();
+		return kIOReturnError;
+	}
+	if (!uc->start(this)) {
+		uc->detach(this);
+		uc->release();
+		return kIOReturnError;
+	}
+	*handler = uc;
+	IOLog("USB> wifi: A8: %s opened the IONetworkStack (type %u)\n", name, (unsigned)type);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IONetworkStackUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IONetworkStackUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	static unsigned said;
+	if (said++ < 16) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("USB> wifi: A8: %s asks the IONetworkStack %u (in %u/%u): ok\n", name, selector,
+		    args ? args->scalarInputCount : 0, args ? args->structureInputSize : 0);
+	}
+	if (args != NULL) {
+		for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+			args->scalarOutput[i] = 0;
+		}
+		if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
+			bzero(args->structureOutput, args->structureOutputSize);
+		}
+	}
+	return kIOReturnSuccess;
+}
