+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+/* 0181: 'wifi busy': which services keep IOKit from being quiet (configd's InterfaceNamer waits for quiet) */
+#include <IOKit/IORegistryEntry.h>
+extern "C" void On7IOKitBusy(void);
+void
+On7IOKitBusy(void)
+{
+	IORegistryEntry *root = IORegistryEntry::getRegistryRoot();
+	IOService *rs = OSDynamicCast(IOService, root);
+	IOLog("USB> wifi: busy: root %s busy %u\n", root ? root->getName() : "?", rs ? (unsigned)rs->getBusyState() : 999u);
+	IORegistryIterator *it = IORegistryIterator::iterateOver(gIOServicePlane, kIORegistryIterateRecursively);
+	unsigned n = 0, shown = 0;
+	if (it == NULL) {
+		IOLog("USB> wifi: busy: no iterator\n");
+		return;
+	}
+	IORegistryEntry *e;
+	while ((e = it->getNextObject()) != NULL) {
+		IOService *sv = OSDynamicCast(IOService, e);
+		n++;
+		if (sv == NULL || sv->getBusyState() == 0) {
+			continue;
+		}
+		if (shown++ < 40) {
+			IORegistryEntry *p = sv->getParentEntry(gIOServicePlane);
+			IOLog("USB> wifi: busy: %s (%s) busy %u, state %s%s, parent %s\n", sv->getName(),
+			    sv->getMetaClass()->getClassName(), (unsigned)sv->getBusyState(),
+			    sv->isInactive() ? "inactive " : "", sv->isOpen() ? "open" : "", p ? p->getName() : "-");
+		}
+	}
+	it->release();
+	IOLog("USB> wifi: busy: %u services, %u busy\n", n, shown);
+}
+#endif /* A5XELTE: 0181 */
 #endif /* SWEET || A5XELTE */
