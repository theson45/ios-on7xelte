@@ -76,9 +77,19 @@
 
 	t.tv_sec = 30;
 	t.tv_nsec = 0;
+	/*
+	 * on7xelte (0150): nothing publishes IORTC here, so the stock wait
+	 * cost 30 s of every boot. Boot-arg iortc_wait=SECONDS restores it.
+	 */
+	{
+		int wait = 0;
+		(void)PE_parse_boot_argn("iortc_wait", &wait, sizeof(wait));
+		t.tv_sec = wait < 0 ? 0 : wait;
+	}
 
 // RTC is not present on this target
 #ifndef BCM2837
+	if (t.tv_sec)
 	IOService::waitForService(
 		IOService::resourceMatching("IORTC"), &t );
 #endif
